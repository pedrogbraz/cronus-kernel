# ── API Routes ──

api /api/auth {
  create       POST     /two-factor/totp/setup auth:jwt
  create       POST     /two-factor/totp/enable auth:jwt
  create       POST     /two-factor/totp/disable auth:jwt
  create       POST     /signup              auth:jwt
  create       POST     /setup               auth:jwt
  list         GET      /saml/userinfo       auth:jwt
  create       POST     /saml/token          auth:jwt
  create       POST     /saml/callback       auth:jwt
  list         GET      /saml/authorize      auth:jwt
  create       POST     /reset-password      auth:jwt
  list         GET      /oidc                auth:jwt
  create       POST     /oauth/token         auth:jwt
  create       POST     /oauth/refreshToken  auth:jwt
  list         GET      /oauth/me            auth:jwt
  create       POST     /oauth/me            auth:jwt
  create       POST     /forgot-password     auth:jwt
  list         GET      /verify-email        auth:jwt
  create       POST     /verify-email        auth:jwt
  update       PUT      /verify-email        auth:jwt
  update       PATCH    /verify-email        auth:jwt
  delete       DELETE   /verify-email        auth:jwt
}

api /api/availability {
  list         GET      /calendar            auth:jwt
  create       POST     /calendar            auth:jwt
  delete       DELETE   /calendar            auth:jwt
}

api /api/avatar {
  detail       GET      /:uuid               auth:public
}

api /api/book {
  list         GET      /recurring-event     auth:jwt
  create       POST     /recurring-event     auth:jwt
  update       PUT      /recurring-event     auth:jwt
  update       PATCH    /recurring-event     auth:jwt
  delete       DELETE   /recurring-event     auth:jwt
  list         GET      /recurring-event     auth:public
  create       POST     /recurring-event     auth:public
  update       PUT      /recurring-event     auth:public
  update       PATCH    /recurring-event     auth:public
  delete       DELETE   /recurring-event     auth:public
  list         GET      /instant-event       auth:jwt
  create       POST     /instant-event       auth:jwt
  update       PUT      /instant-event       auth:jwt
  update       PATCH    /instant-event       auth:jwt
  delete       DELETE   /instant-event       auth:jwt
  list         GET      /event               auth:jwt
  create       POST     /event               auth:jwt
  update       PUT      /event               auth:jwt
  update       PATCH    /event               auth:jwt
  delete       DELETE   /event               auth:jwt
}

api /api/calAIPhone {
  list         GET      /subscription/success auth:public
}

