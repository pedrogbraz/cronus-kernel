# Generated by: cronus dump /tmp/dumps/plane
# Stack: unknown

app "plane" {
  stack react + tailwind
  port 3000
  database sqlite "./data.db"
  theme dark
}

auth {
  entity User
  login email + password
  session jwt
}

style {
  theme dark
  accent "var(--brand-default)"
  font "Inter"
  radius lg
}

# Entities extracted from TypeScript interfaces
entity TCoreCustomComponentsMetaData {
  file_assets    string  required
  name           string  required
  url            url     required
  user_mentions  string  required
  display_name   string  required
  url            url     required
}

entity TTableColumn {
  key       string  required
  content   text    required
  thRender  string
  tdRender  string  required
}

entity TTableData {
  data              -> T[]           required
  columns           -> TTableColumn  required
  keyExtractor      string           required
  tableClassName    string         
  tHeadClassName    string         
  tHeadTrClassName  string         
  thClassName       string         
  tBodyClassName    text           
  tBodyTrClassName  text           
  tdClassName       string         
}

entity TPopoverMenu {
  data          -> T[]  required
  keyExtractor  number  required
  render        number  required
}

