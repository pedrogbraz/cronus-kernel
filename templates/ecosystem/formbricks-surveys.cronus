# ── API Routes ──

api /api/google-sheet {
  list         GET      /                    auth:jwt
  list         GET      /callback            auth:jwt
}

api /api/pipeline {
  create       POST     /                    auth:jwt
}

api /api/v1 {
  list         GET      /webhooks            auth:jwt
  create       POST     /webhooks            auth:jwt
  detail       GET      /webhooks/:webhookId auth:jwt
  delete       DELETE   /webhooks/:webhookId auth:jwt
  list         GET      /management/surveys  auth:jwt
  create       POST     /management/surveys  auth:jwt
  detail       GET      /management/surveys/:surveyId/singleUseIds auth:jwt
  detail       GET      /management/surveys/:surveyId auth:jwt
  update       PUT      /management/surveys/:surveyId auth:jwt
  delete       DELETE   /management/surveys/:surveyId auth:jwt
  create       POST     /management/storage  auth:jwt
  list         GET      /management/responses auth:jwt
  create       POST     /management/responses auth:jwt
  detail       GET      /management/responses/:responseId auth:jwt
  update       PUT      /management/responses/:responseId auth:jwt
  delete       DELETE   /management/responses/:responseId auth:jwt
  list         GET      /management/me       auth:jwt
  list         GET      /management/action-classes auth:jwt
  create       POST     /management/action-classes auth:jwt
  detail       GET      /management/action-classes/:actionClassId auth:jwt
  update       PUT      /management/action-classes/:actionClassId auth:jwt
  delete       DELETE   /management/action-classes/:actionClassId auth:jwt
  list         GET      /integrations/slack  auth:jwt
  list         GET      /integrations/slack/callback auth:jwt
  list         GET      /integrations/notion auth:jwt
  list         GET      /integrations/notion/callback auth:jwt
  list         GET      /integrations/airtable/tables auth:jwt
  list         GET      /integrations/airtable auth:jwt
  list         GET      /integrations/airtable/callback auth:jwt
  list         GET      /client/og           auth:public
  create       POST     /client/:environmentId/storage auth:jwt
  handle       OPTIONS  /client/:environmentId/storage auth:jwt
  create       POST     /client/:environmentId/responses auth:public
  handle       OPTIONS  /client/:environmentId/responses auth:public
  update       PUT      /client/:environmentId/responses/:responseId auth:public
  handle       OPTIONS  /client/:environmentId/responses/:responseId auth:public
  detail       GET      /client/:environmentId/environment auth:public
  handle       OPTIONS  /client/:environmentId/environment auth:public
  create       POST     /client/:environmentId/displays auth:public
  handle       OPTIONS  /client/:environmentId/displays auth:public
}

api /api/v2 {
  create       POST     /client/:environmentId/responses auth:public
  handle       OPTIONS  /client/:environmentId/responses auth:public
  create       POST     /client/:environmentId/displays auth:public
  handle       OPTIONS  /client/:environmentId/displays auth:public
}

api /api/v3 {
  list         GET      /surveys             auth:jwt
}

