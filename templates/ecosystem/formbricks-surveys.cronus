# Source: Next.js App Router project
# Pages: 62 | API Routes: 30 | Layouts: 18

app "@formbricks/web" {
  stack react + tailwind
  port 3000
  database sqlite "./data.db"
}

auth {
  entity User
  login email + password
  session jwt expires:24h
  roles [admin, user]
}

style {
  theme light
}

