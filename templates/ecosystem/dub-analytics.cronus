}

api /api/webhooks {
  list         GET      /                    auth:jwt
  create       POST     /                    auth:jwt
  create       POST     /callback            auth:public
  detail       GET      /:webhookId          auth:jwt
  update       PATCH    /:webhookId          auth:jwt
  delete       DELETE   /:webhookId          auth:jwt
