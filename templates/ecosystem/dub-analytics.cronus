# ── API Routes ──

api /api {
  list         GET      /                    auth:public
}

api /api/activity-logs {
  list         GET      /                    auth:jwt
}

api /api/ai {
  create       POST     /sync-embeddings     auth:jwt
  create       POST     /support-chat/upload auth:jwt
  create       POST     /support-chat        auth:jwt
  create       POST     /completion          auth:jwt
}

api /api/analytics {
  list         GET      /                    auth:jwt
  list         GET      /export              auth:jwt
  list         GET      /dashboard           auth:public
}

api /api/auth {
  create       POST     /reset-password      auth:jwt
}

api /api/callback {
  create       POST     /plain/workspace     auth:jwt
  create       POST     /plain/partner       auth:jwt
  list         GET      /bitly               auth:jwt
}

api /api/dashboards {
  list         GET      /                    auth:jwt
  create       POST     /                    auth:jwt
  update       PATCH    /:id                 auth:jwt
  delete       DELETE   /:id                 auth:jwt
}

api /api/docs {
  detail       GET      /guides/:guide       auth:jwt
}

api /api/domains {
  list         GET      /search-availability auth:jwt
  list         GET      /                    auth:jwt
  create       POST     /                    auth:jwt
  list         GET      /default             auth:jwt
  update       PATCH    /default             auth:jwt
  list         GET      /count               auth:jwt
  create       POST     /client/saved        auth:jwt
  create       POST     /client/register     auth:jwt
  detail       GET      /:domain/verify      auth:jwt
  detail       GET      /:domain/validate    auth:jwt
  create       POST     /:domain/transfer    auth:jwt
  detail       GET      /:domain             auth:jwt
  update       PATCH    /:domain             auth:jwt
  delete       DELETE   /:domain             auth:jwt
  create       POST     /:domain/primary     auth:jwt
}

api /api/dub {
  create       POST     /webhook             auth:public
}

api /api/folders {
  list         GET      /                    auth:jwt
  create       POST     /                    auth:jwt
  list         GET      /permissions         auth:jwt
  list         GET      /count               auth:jwt
  list         GET      /access-requests     auth:jwt
  detail       GET      /:folderId/users     auth:jwt
  detail       GET      /:folderId           auth:jwt
  update       PATCH    /:folderId           auth:jwt
  delete       DELETE   /:folderId           auth:jwt
  detail       GET      /:folderId/dashboard auth:jwt
}

api /api/integrations {
  delete       DELETE   /uninstall           auth:jwt
  list         GET      /                    auth:jwt
}

api /api/links {
  update       PUT      /upsert              auth:jwt
  create       POST     /sync                auth:jwt
  list         GET      /                    auth:jwt
  create       POST     /                    auth:jwt
  list         GET      /random              auth:public
  list         GET      /metatags            auth:public
  list         GET      /info                auth:jwt
  list         GET      /iframeable          auth:public
  list         GET      /export              auth:jwt
  list         GET      /exists              auth:public
  list         GET      /count               auth:jwt
  create       POST     /bulk                auth:jwt
  update       PATCH    /bulk                auth:jwt
  delete       DELETE   /bulk                auth:jwt
  create       POST     /:linkId/transfer    auth:jwt
  detail       GET      /:linkId             auth:jwt
  update       PUT      /:linkId             auth:jwt
  update       PATCH    /:linkId             auth:jwt
  delete       DELETE   /:linkId             auth:jwt
  detail       GET      /:linkId/dashboard   auth:jwt
}

api /api/me {
  list         GET      /                    auth:jwt
}

api /api/misc {
  list         GET      /check-workspace-slug auth:jwt
  list         GET      /check-favicon       auth:jwt
}

api /api/oauth {
  list         GET      /userinfo            auth:jwt
  handle       OPTIONS  /userinfo            auth:jwt
  create       POST     /token               auth:jwt
  handle       OPTIONS  /token               auth:jwt
  create       POST     /authorize           auth:jwt
  list         GET      /apps                auth:jwt
  create       POST     /apps                auth:jwt
  detail       GET      /apps/:appId         auth:jwt
  update       PATCH    /apps/:appId         auth:jwt
  delete       DELETE   /apps/:appId         auth:jwt
}

api /api/og {
  list         GET      /program             auth:public
  list         GET      /partner-rewind      auth:jwt
  list         GET      /partner-earnings    auth:jwt
  detail       GET      /avatar/:[seed]      auth:public
  list         GET      /analytics           auth:public
}

api /api/postbacks {
  create       POST     /callback            auth:public
}

api /api/providers {
  list         GET      /                    auth:public
}

api /api/qr {
  list         GET      /                    auth:public
  handle       OPTIONS  /                    auth:public
}

api /api/resend {
  create       POST     /webhook             auth:public
}

api /api/resumes {
  create       POST     /upload-url          auth:public
}

api /api/slack {
