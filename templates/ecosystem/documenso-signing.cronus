# Generated by: cronus dump /tmp/dumps/documenso/apps/remix
# Stack: react

app "@documenso/remix" {
  stack react + tailwind
  port 3000
  database sqlite "./data.db"
  theme dark
}

auth {
  entity User
  login email + password
  session jwt
}

style {
  theme light
  accent "red"
  font "Inter"
  radius lg
}

# Entities extracted from TypeScript interfaces
entity TGetEnvelopeItemFileRequestQuery {
  token           string  required
  envelopeItemId  string  required
}

entity TNormalizedFieldWithPage {
  type            -> ZDetectableFieldType  required
  positionX       number                   required
  positionY       number                   required
  width           number                   required
  height          number                   required
  confidence      -> ZConfidenceLevel      required
  pageNumber      number                   required
  recipientId     number                   required
  envelopeItemId  string                   required
}

# API endpoints detected from fetch calls
api /api/ai {
  list_ai              GET      /                        auth:jwt
  list_*               GET      /*                       auth:jwt
  list_detect-fields   GET      /detect-fields           auth:jwt
  list_detect-recipients GET      /detect-recipients       auth:jwt
}

api /api/auth {
  list_auth            GET      /                        auth:jwt
}

api /api/branding {
  list_team            GET      /logo/team/              auth:jwt
}

api /api/files {
  list_files           GET      /                        auth:jwt
  create_presigned-post-url POST     /presigned-post-url      auth:jwt
  list_upload-pdf      GET      /upload-pdf              auth:jwt
}

api /api/jobs {
  list_*               GET      /*                       auth:jwt
}

api /api/locale {
  list_locale          GET      /                        auth:jwt
}

api /api/theme {
  list_theme           GET      /                        auth:jwt
}

api /api/trpc {
  list_trpc            GET      /                        auth:jwt
  list_*               GET      /*                       auth:jwt
}

api /api/v1 {
  list_v1              GET      /                        auth:jwt
  list_*               GET      /*                       auth:jwt
}

api /api/v2 {
  list_v2              GET      /                        auth:jwt
  list_*               GET      /*                       auth:jwt
  list_create-presign-token GET      /embedding/create-presign-token auth:jwt
  list_openapi.json    GET      /openapi.json            auth:jwt
}

api /api/v2-beta {
  list_v2-beta         GET      /                        auth:jwt
  list_*               GET      /*                       auth:jwt
  list_openapi.json    GET      /openapi.json            auth:jwt
}

