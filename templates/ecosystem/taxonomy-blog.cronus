# Generated by cronus dump --nextjs
# Source: Next.js App Router project
# Pages: 14 | API Routes: 7 | Layouts: 8

app "taxonomy" {
  stack react + tailwind
  port 3000
  database sqlite "./data.db"
}

auth {
  entity User
  login email + password
  session jwt expires:24h
  roles [admin, user]
}

style {
  theme dark
  accent 222.2 47.4% 11.2%
}

# ── Entities (from Prisma schema) ──



entity Account {
  userId            string  required
  type              string  required
  provider          string  required
  providerAccountId string  required
  refresh_token     string
  access_token      string
  expires_at        number
  token_type        string
  scope             string
  id_token          string
  session_state     string
  updatedAt         date    required
  user              -> User
}

entity Session {
  sessionToken string  required unique
  userId       string  required
  expires      date    required
  user         -> User
}

entity User {
  name                   string
  email                  email  unique
  emailVerified          date
  image                  string
  updatedAt              date   required
  stripeCustomerId       string unique
  stripeSubscriptionId   string unique
  stripePriceId          string
  stripeCurrentPeriodEnd date
}

entity VerificationToken {
  identifier string required
  token      string required unique
  expires    date   required
}

entity Post {
  title     string  required
  content   json
  published boolean required
  updatedAt date    required
  authorId  string  required
  author    -> User
}

