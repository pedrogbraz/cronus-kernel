# ── API Routes ──

api /api/auth {
  list         GET      /[                   auth:jwt
  create       POST     /[                   auth:jwt
  update       PUT      /[                   auth:jwt
  update       PATCH    /[                   auth:jwt
  delete       DELETE   /[                   auth:jwt
}

api /api/og {
  list         GET      /                    auth:public
}

api /api/posts {
  list         GET      /                    auth:jwt
  create       POST     /                    auth:jwt
  update       PATCH    /:postId             auth:jwt
  delete       DELETE   /:postId             auth:jwt
}

api /api/users {
  list         GET      /stripe              auth:jwt
  update       PATCH    /:userId             auth:jwt
}

api /api/webhooks {
  create       POST     /stripe              auth:jwt
}

