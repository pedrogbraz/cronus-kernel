# ── API Routes ──

api /api/better-auth {
  detail       GET      /:all                auth:jwt
  create       POST     /:all                auth:jwt
}

api /api/event {
  detail       GET      /:route              auth:public
}

api /api/house-keeping {
  detail       GET      /:method             auth:jwt
}

api /api/integrations {
  detail       GET      /:connection         auth:jwt
  create       POST     /:connection         auth:jwt
}

api /api/legacy {
  detail       GET      /:route              auth:public
}

api /api/licensing {
  detail       GET      /v1/:route           auth:jwt
  create       POST     /v1/:route           auth:jwt
}

api /api/og-image-poll {
  list         GET      /                    auth:jwt
}

api /api/private {
  detail       GET      /:route              auth:public
  create       POST     /:route              auth:public
  delete       DELETE   /:route              auth:public
}

api /api/status {
  list         GET      /                    auth:public
}

api /api/storage {
  detail       GET      /:key                auth:public
}

api /api/stripe {
  create       POST     /webhook             auth:public
  list         GET      /portal              auth:jwt
  list         GET      /portal/payment-methods auth:jwt
  create       POST     /checkout            auth:jwt
  list         GET      /buy-license         auth:jwt
}

api /api/user {
  list         GET      /verify-email-change auth:jwt
}

