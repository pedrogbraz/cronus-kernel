# Pages: 35 | API Routes: 16 | Layouts: 8

app "@rallly/web" {
  stack react
  port 3000
  database sqlite "./data.db"
}

auth {
  entity User
  login email + password
  session jwt expires:24h
  roles [admin, user]
}

style {
  theme light
}

layout Main {
  sidebar {
    "Home" -> "/"
  }
}

