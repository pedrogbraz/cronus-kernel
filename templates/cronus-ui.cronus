## Aurora + Voodoo starter. Authoring stays .cronus.
## Sections read `bind`. app.scriptcronus reacts to `on Lead.create`.
## Leads are shared and read-only in public on purpose: this is a demo board.

app "Aurora" {
  stack voodoo
  port 5175
  database sqlite "./data.db"
}

style {
  theme dark
  preset aurora
  runtime voodoo
  accent-hex "#0ea5e9"
  font "Inter"
  radius 14px
  background "#09090b"
  surface "#111113"
  text "#fafaf9"
}

entity Lead shared {
  name   string!
  email  email!
  status enum [new, won] default:new
}

api /leads {
  list   GET  /    auth:public
  detail GET  /:id auth:public
}

page "/" type:custom {
  section metric {
    bind Lead { aggregate count scope:public }
    item "Leads"
  }
  section bar-chart {
    title "By status"
    bind Lead { query all scope:public }
  }
  section data-table {
    title "Pipeline"
    bind Lead { query all order created_at desc limit 20 scope:public }
  }
}
