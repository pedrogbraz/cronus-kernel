/// E-commerce — a public product catalog and private orders.
/// Products are `shared` (everyone reads them); only admins change them.
/// Orders are owner-scoped: each customer sees only their own.
/// Prices are money (stored in centavos: 2990 = R$29.90).
/// @template ecommerce
app "Store" {
  port 5175
  database sqlite "./data.db"
}

auth {
  entity Customer
  login email + password
  session jwt expires:24h
  roles [customer, admin]
  redirect "/orders"
}

entity Customer {
  name     string!
  email    email! unique
  password string! sensitive
  role     string
}

entity Product shared {
  name        string! searchable
  description text
  price       money!
  stock       number default:0
}

entity Order {
  product  string!
  quantity number! default:1
  total    money
  status   enum [pending, paid, shipped, cancelled] default:pending

  transition status {
    pending -> paid | cancelled
    paid -> shipped | cancelled
  }
}

api /products {
  list   GET    /    auth:public
  detail GET    /:id auth:public
  create POST   /    auth:admin
  update PATCH  /:id auth:admin
  delete DELETE /:id auth:admin
}

api /orders {
  list   GET    /    auth:jwt
  create POST   /    auth:jwt
  detail GET    /:id auth:jwt
}

layout Main {
  brand "Store"
  sidebar {
    "Shop"      -> "/"       icon:storefront
    "My orders" -> "/orders" icon:receipt_long
  }
}

page "/" type:custom {
  section hero {
    title "The Store"
    subtitle "Good things, fairly priced."
    cta_text "Sign in to order"
    cta_link "/login"
  }
  section table {
    title "Products"
    bind Product { query all order name scope:public }
    columns "Name, Description, Price"
  }
}

page "/orders" type:custom requires:auth {
  section page-header {
    title "My orders"
  }
  section table {
    bind Order { query all order created_at desc limit 50 }
    columns "Product, Quantity, Status, Created At"
  }
  section form {
    title "Place an order"
    bind Order { query all }
    field "product" type:text required
    field "quantity" type:number required
    on submit {
      create Order
      toast "Order placed" success
      navigate "/orders"
    }
  }
}

style {
  theme dark
  accent rose
  font "Inter"
}
