/// Helpdesk — open support tickets and track them to resolution.
/// @template helpdesk
app "Helpdesk" {
  port 5175
  database sqlite "./data.db"
}

auth {
  entity User
  login email + password
  session jwt expires:24h
  roles [customer, agent, admin]
  redirect "/dashboard"
}

entity User {
  name     string!
  email    email! unique
  password string! sensitive
  role     string
}

entity Ticket {
  subject     string! searchable
  description text!
  priority    enum [low, medium, high, urgent] default:medium
  status      enum [open, pending, resolved, closed] default:open

  transition status {
    open -> pending | resolved
    pending -> open | resolved
    resolved -> closed | open
  }
}

api /tickets {
  list   GET    /    auth:jwt
  create POST   /    auth:jwt
  detail GET    /:id auth:jwt
  update PATCH  /:id auth:jwt
}

layout Main {
  brand "Helpdesk"
  sidebar {
    "Dashboard"  -> "/dashboard"   icon:dashboard
    "Tickets"    -> "/tickets"     icon:support_agent
    "New ticket" -> "/tickets/new" icon:add
  }
}

page "/" type:custom {
  section hero {
    title "How can we help?"
    subtitle "Open a ticket and follow it until it's resolved."
    cta_text "Get support"
    cta_link "/register"
  }
}

page "/dashboard" type:dashboard requires:auth {
  section kpi {
    bind Ticket { aggregate count }
    item "Tickets" value:bind icon:confirmation_number
  }
  section table {
    title "Open tickets"
    bind Ticket { query all where status eq:"open" order created_at desc limit 10 }
    columns "Subject, Priority, Status, Created At"
  }
}

page "/tickets" type:custom requires:auth {
  section page-header {
    title "Tickets"
  }
  section table {
    bind Ticket { query all order created_at desc limit 50 }
    columns "Subject, Priority, Status, Created At"
  }
}

page "/tickets/new" type:custom requires:auth {
  section form {
    title "New ticket"
    bind Ticket { query all }
    field "subject" type:text required
    field "description" type:textarea required
    on submit {
      create Ticket
      toast "Ticket opened" success
      navigate "/tickets"
    }
  }
}

style {
  theme dark
  accent orange
  font "Inter"
}
