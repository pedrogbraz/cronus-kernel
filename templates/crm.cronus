/// CRM — contacts and a deal pipeline, private to each signed-in user.
/// @template crm
app "CRM" {
  port 5175
  database sqlite "./data.db"
}

auth {
  entity User
  login email + password
  session jwt expires:24h
  roles [rep, admin]
  redirect "/dashboard"
}

entity User {
  name     string!
  email    email! unique
  password string! sensitive
  role     string
}

entity Contact {
  name    string! searchable
  email   email
  company string
  phone   phone
}

entity Deal {
  title   string!
  company string
  value   money!
  stage   enum [lead, qualified, proposal, won, lost] default:lead
}

api /contacts {
  list   GET    /    auth:jwt
  create POST   /    auth:jwt
  detail GET    /:id auth:jwt
  update PATCH  /:id auth:jwt
  delete DELETE /:id auth:jwt
}

api /deals {
  list   GET    /    auth:jwt
  create POST   /    auth:jwt
  detail GET    /:id auth:jwt
  update PATCH  /:id auth:jwt
  delete DELETE /:id auth:jwt
}

layout Main {
  brand "CRM"
  sidebar {
    "Dashboard" -> "/dashboard" icon:dashboard
    "Deals"     -> "/deals"     icon:handshake
    "Contacts"  -> "/contacts"  icon:contacts
  }
}

page "/" type:custom {
  section hero {
    title "Your pipeline, in one place"
    subtitle "Track contacts and deals from lead to won."
    cta_text "Create an account"
    cta_link "/register"
  }
}

page "/dashboard" type:dashboard requires:auth {
  section kpi {
    bind Deal { aggregate count }
    item "Open deals" value:bind icon:handshake
  }
  section kpi {
    bind Deal { aggregate sum field:value }
    item "Pipeline value" value:bind icon:payments
  }
  section table {
    title "Latest deals"
    bind Deal { query all order created_at desc limit 10 }
    columns "Title, Company, Value, Stage"
  }
}

page "/deals" type:custom requires:auth {
  section page-header {
    title "Deals"
  }
  section table {
    bind Deal { query all order created_at desc limit 50 }
    columns "Title, Company, Value, Stage, Created At"
  }
  section form {
    title "New deal"
    bind Deal { query all }
    field "title" type:text required
    field "company" type:text
    field "value" type:money required
    on submit {
      create Deal
      toast "Deal added" success
      navigate "/deals"
    }
  }
}

page "/contacts" type:custom requires:auth {
  section page-header {
    title "Contacts"
  }
  section table {
    bind Contact { query all order name limit 50 }
    columns "Name, Email, Company, Phone"
  }
  section form {
    title "New contact"
    bind Contact { query all }
    field "name" type:text required
    field "email" type:email
    field "company" type:text
    field "phone" type:text
    on submit {
      create Contact
      toast "Contact added" success
      navigate "/contacts"
    }
  }
}

style {
  theme dark
  accent emerald
  font "Inter"
}
