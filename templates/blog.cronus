/// Blog — authors write posts; published posts are public on the home page.
/// @template blog
app "Blog" {
  port 5175
  database sqlite "./data.db"
}

auth {
  entity Author
  login email + password
  session jwt expires:24h
  roles [writer, admin]
  redirect "/dashboard"
}

entity Author {
  name     string!
  email    email! unique
  password string! sensitive
  role     string
  bio      text
}

entity Post {
  title   string! searchable
  excerpt text
  content text!
  status  enum [draft, published, archived] default:draft

  transition status {
    draft -> published
    published -> archived | draft
    archived -> draft
  }
}

api /posts {
  list   GET    /    auth:jwt
  create POST   /    auth:jwt
  detail GET    /:id auth:jwt
  update PATCH  /:id auth:jwt
  delete DELETE /:id auth:jwt
}

layout Main {
  brand "Blog"
  sidebar {
    "Home"      -> "/"          icon:home
    "Dashboard" -> "/dashboard" icon:dashboard
    "Write"     -> "/posts/new" icon:edit
  }
}

page "/" type:custom {
  section hero {
    title "The Blog"
    subtitle "Notes, releases and stories."
    cta_text "Start writing"
    cta_link "/register"
  }
  section table {
    title "Latest posts"
    bind Post { query all where status eq:"published" order created_at desc limit 20 scope:public }
    columns "Title, Excerpt, Created At"
  }
}

page "/dashboard" type:dashboard requires:auth {
  section kpi {
    bind Post { aggregate count }
    item "Your posts" value:bind icon:article
  }
  section table {
    title "Your posts"
    bind Post { query all order created_at desc limit 25 }
    columns "Title, Status, Created At"
  }
}

page "/posts/new" type:custom requires:auth {
  section form {
    title "New post"
    bind Post { query all }
    field "title" type:text required
    field "excerpt" type:textarea
    field "content" type:textarea required
    on submit {
      create Post
      toast "Draft saved" success
      navigate "/dashboard"
    }
  }
}

style {
  theme dark
  accent sky
  font "Inter"
}
