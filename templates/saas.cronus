/// SaaS Starter — sign up, create projects, see your own dashboard.
/// Data is owner-scoped: every signed-in user only sees their own projects.
/// @template saas
app "SaaS Starter" {
  port 5175
  database sqlite "./data.db"
}

auth {
  entity User
  login email + password
  session jwt expires:24h
  roles [member, admin]
  redirect "/dashboard"
}

entity User {
  name     string!
  email    email! unique
  password string! sensitive
  role     string
}

entity Project {
  name        string!
  description text
  status      enum [active, paused, archived] default:active
}

api /projects {
  list   GET    /    auth:jwt
  create POST   /    auth:jwt
  detail GET    /:id auth:jwt
  update PATCH  /:id auth:jwt
  delete DELETE /:id auth:jwt
}

layout Main {
  brand "SaaS Starter"
  sidebar {
    "Dashboard"   -> "/dashboard"    icon:home
    "New project" -> "/projects/new" icon:add
  }
}

page "/" type:custom {
  section hero {
    title "Ship your SaaS today"
    subtitle "Accounts, projects and a private dashboard, from one file."
    cta_text "Create an account"
    cta_link "/register"
  }
}

page "/dashboard" type:dashboard requires:auth {
  section kpi {
    bind Project { aggregate count }
    item "Projects" value:bind icon:folder
  }
  section table {
    title "Your projects"
    bind Project { query all order created_at desc limit 20 }
    columns "Name, Status, Created At"
  }
}

page "/projects/new" type:custom requires:auth {
  section form {
    title "New project"
    bind Project { query all }
    field "name" type:text required
    field "description" type:textarea
    on submit {
      create Project
      toast "Project created" success
      navigate "/dashboard"
    }
  }
}

style {
  theme dark
  accent violet
  font "Inter"
}
