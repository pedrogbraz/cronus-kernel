{
  "schema": 1,
  "harness_version": "1.0.0",
  "profile": "rust-cargo",
  "base_branch": "main",
  "max_active": 1,
  "checks": {
    "quick": [
      {
        "name": "kernel-quick",
        "argv": ["python3", "scripts/harness/check.py", "quick"],
        "timeout_seconds": 1800
      }
    ],
    "full": [
      {
        "name": "kernel-full",
        "argv": ["python3", "scripts/harness/check.py", "full"],
        "timeout_seconds": 7200
      }
    ],
    "critical": [
      {
        "name": "kernel-critical",
        "argv": ["python3", "scripts/harness/check.py", "critical"],
        "timeout_seconds": 7200
      }
    ]
  }
}
