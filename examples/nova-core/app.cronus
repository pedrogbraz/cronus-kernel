/// Nova Core — High-performance operational dashboard.
/// Real-time deployment pipeline monitoring for SRE teams.
/// @team Platform Engineering
/// @status production
/// @since 2026-04-01
app "NOVA CORE" {
  stack voodoo
  port 5175
  database sqlite "./data.db"

  constitution {
    must "prices in centavos — use formatPrice()"
    must "all data sections require bind"
    must "auth required on all admin endpoints"
    never "expose passwords in API responses"
    never "hardcode user data in templates"
    never "use location.reload()"
  }
}

style {
  theme dark
  preset midnight
  runtime voodoo
  font "Space Grotesk"
  accent-hex "#87adff"
  radius 12px
}

layout Main {
  sidebar {
    brand "NOVA CORE"
    "Overview" -> "/" icon:rocket_launch
    "Deployments" -> "/deployments" icon:deployed_code
    "Analytics" -> "/analytics" icon:monitoring
    "Security" -> "/security" icon:security
    "Server" -> "/server" icon:dns
    "Alerts" -> "/notifications" icon:notifications
    "Settings" -> "/settings" icon:settings
  }
}

# ── Entities (auto-migrated to SQLite) ──

/// Tracks deployment pipeline across all clusters.
/// @owner sre-team
/// @lifecycle retain 90 days
entity Deployment shared {
  /// Unique deploy identifier (format: DPL-XXXX)
  /// @example "DPL-5001"
  deploy_id string required
  /// Target microservice name
  /// @example "api-gateway-v3"
  service string required
  /// AWS/GCP region for this deploy
  cluster string required
  /// Total deployment time
  duration string
  /// Current pipeline state
  /// @business "Failed" triggers PagerDuty alert
  status enum ["Live", "Rolling", "Failed", "Pending"] required
  /// Engineer who initiated the deploy
  deployed_by string

  transition status {
    Pending -> Rolling
    Rolling -> Live | Failed
    Failed -> Pending
  }

  on create {
    log "Deploy {{deploy_id}} started by {{deployed_by}}"
    notify "slack" "#deploys" "New deploy: {{deploy_id}} on {{cluster}}"
  }

  on update status {
    when "Failed" {
      notify "pagerduty" "critical" "Deploy {{deploy_id}} FAILED on {{cluster}}"
      log "ALERT: {{deploy_id}} failed"
    }
    when "Live" {
      notify "slack" "#deploys" "{{deploy_id}} is LIVE on {{cluster}}"
    }
  }

  on delete {
    log "Deploy {{deploy_id}} removed"
  }
}

entity SecurityEvent shared {
  event_id string required
  event_type string required
  source_ip string
  severity enum ["Critical", "High", "Medium", "Warning", "Info"] required
  status enum ["Blocked", "Throttled", "Rejected", "Flagged", "Completed"] required
}

entity Endpoint shared {
  path string required
  method enum ["GET", "POST", "PUT", "DELETE", "WS"] required
  requests number
  avg_latency string
  p99 string
  error_rate string
}

entity KpiSnapshot shared {
  label string required
  value string required
  change string
  icon string
  subtitle string
  page string required
}

entity Notification shared {
  title string required
  message string
  type enum ["info", "warning", "error", "success"] required
  read boolean
}

entity User {
  name string required
  email email required unique
  password string sensitive
  role enum ["admin", "operator", "viewer"]
  avatar string
}

auth {
  entity User
  login email + password
  session jwt expires:24h
  roles [admin, operator, viewer]
}

# ── APIs (CRUD auto-generated) ──

api /deployments {
  list    GET    /deployments
  find    GET    /deployments/:id
  create  POST   /deployments    auth:jwt
  update  PATCH  /deployments/:id auth:jwt
  remove  DELETE /deployments/:id auth:jwt
}

api /securityevents {
  list    GET    /securityevents
  create  POST   /securityevents  auth:jwt
}

api /endpoints {
  list    GET    /endpoints
  create  POST   /endpoints       auth:jwt
}

api /kpisnapshots {
  list    GET    /kpisnapshots
  create  POST   /kpisnapshots    auth:jwt
}

api /notifications {
  list    GET    /notifications
  create  POST   /notifications   auth:jwt
  update  PATCH  /notifications/:id auth:jwt
  remove  DELETE /notifications/:id auth:jwt
}

webhook /deployments {
  on create -> POST "https://hooks.slack.com/services/nova-core/deployments"
  on delete -> POST "https://hooks.slack.com/services/nova-core/alerts"
}

webhook /securityevents {
  on create -> POST "https://hooks.slack.com/services/nova-core/security"
}

# ── Pages ──

page "/dashboard" type:dashboard requires:auth {
  title "Overview"

  section page-header {
    title "Operational Flux"
    subtitle "Live system throughput — all data from your account."
  }

  section kpi {
    bind Deployment { query count }
    item "Deployments" value:bind icon:rocket_launch
  }

  section table {
    title "Recent Activity"
    columns "deploy_id, service, cluster, status, duration"
    bind Deployment { query all order created_at desc limit 5 }
  }
}

page "/" type:dashboard requires:auth {
  title "Overview"

  section page-header {
    title "Operational Flux"
    subtitle "Live system throughput — all data from your account."
  }

  section kpi cols:4 {
    bind KpiSnapshot { query all where page eq "overview" }
  }

  section kpi {
    bind Deployment { query count }
    item "Deployments" value:bind icon:rocket_launch
  }

  section kpi {
    bind SecurityEvent { query count }
    item "Security Events" value:bind icon:security
  }

  section chart type:bar {
    title "Deployments by Status"
    bind Deployment { aggregate count group status }
  }

  section table {
    title "Recent Activity"
    columns "deploy_id, service, cluster, status, duration"
    bind Deployment { query all order created_at desc limit 5 }
  }
}

page "/deployments" type:dashboard requires:auth {
  title "Deployments"

  section page-header {
    title "Active Deployments"
    subtitle "Real-time deployment pipeline status across all clusters and regions."
  }

  section kpi cols:4 {
    bind KpiSnapshot { query all where page eq "deployments" }
  }

  section kpi {
    bind Deployment { query count }
    item "Total Deploys" value:bind icon:deployed_code
  }

  section kpi {
    bind Deployment { query count where status eq "Live" }
    item "Live" value:bind icon:check_circle
  }

  section kpi {
    bind Deployment { query count where status eq "Failed" }
    item "Failed" value:bind icon:error
  }

  section chart type:bar {
    title "Pipeline by Status"
    bind Deployment { aggregate count group status }
  }

  section table {
    title "Recent Deployments"
    search "Filter by service, cluster, or status..."
    columns "deploy_id, service, cluster, duration, status, deployed_by"
    bind Deployment { query all order created_at desc limit 20 }
  }
}

page "/analytics" type:dashboard requires:auth {
  title "Analytics"

  section page-header {
    title "System Analytics"
    subtitle "Aggregated telemetry data from all nodes."
  }

  section kpi cols:4 {
    bind KpiSnapshot { query all where page eq "analytics" }
  }

  section kpi {
    bind Endpoint { query count }
    item "Endpoints" value:bind icon:monitoring
  }

  section chart type:bar {
    title "Requests by Method"
    bind Endpoint { aggregate sum(requests) group method }
  }

  section table {
    title "Top Endpoints by Volume"
    columns "path, method, requests, avg_latency, p99, error_rate"
    bind Endpoint { query all order created_at desc limit 20 }
  }
}

page "/security" type:dashboard requires:auth {
  title "Security"

  section page-header {
    title "Security Posture"
    subtitle "Continuous threat monitoring, access control policies, and compliance status."
  }

  section kpi cols:4 {
    bind KpiSnapshot { query all where page eq "security" }
  }

  section kpi {
    bind SecurityEvent { query count }
    item "Events" value:bind icon:security
  }

  section kpi {
    bind SecurityEvent { query count where severity eq "Critical" }
    item "Critical" value:bind icon:warning
  }

  section chart type:bar {
    title "Events by Severity"
    bind SecurityEvent { aggregate count group severity }
  }

  section table {
    title "Recent Security Events"
    search "Filter events..."
    columns "event_id, event_type, source_ip, severity, status"
    bind SecurityEvent { query all order created_at desc limit 20 }
  }
}

page "/server" type:dashboard requires:auth {
  title "Server"

  section page-header {
    title "Server"
    subtitle "Request metrics and endpoint health."
  }

  section kpi {
    bind Endpoint { query count }
    item "Endpoints" value:bind icon:dns
  }

  section kpi {
    bind Deployment { query count }
    item "Deployments" value:bind icon:deployed_code
  }

  section kpi {
    bind Notification { query count }
    item "Alerts" value:bind icon:notifications
  }

  section table {
    title "Endpoints"
    columns "path, method, requests, avg_latency, p99, error_rate"
    bind Endpoint { query all order created_at desc }
  }
}

page "/notifications" type:dashboard requires:auth {
  title "Notifications"

  section page-header {
    title "Notifications"
    subtitle "System alerts, deployment events and security warnings."
  }

  section kpi {
    bind Notification { query count }
    item "Alerts" value:bind icon:notifications
  }

  section notifications {
    title "Inbox"
    bind Notification { query all order created_at desc limit 50 }
  }

  section table {
    title "All Alerts"
    columns "title, message, type, read"
    bind Notification { query all order created_at desc }
  }
}

page "/settings" type:dashboard requires:auth {
  title "Settings"

  section page-header {
    title "Settings"
    subtitle "Manage your profile, preferences and security."
  }

  section kpi {
    bind User { query count }
    item "Operators" value:bind icon:settings
  }

  section form entity:User {
    title "Profile"
    bind User { query one }
    field "name" type:text required
    field "email" type:email required
    field "role" type:select options:"admin||operator||viewer"
    field "avatar" type:text

    on submit {
      update User
      toast "Profile updated" style:success
      refresh page
    }
  }
}
