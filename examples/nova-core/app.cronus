# Generated by cronus dump + fullstack bind

app "NOVA CORE | High-Performance Dashboard" {
  stack fullstack
  port 5175
  database sqlite "./data.db"
  theme dark
}

# ── Entities (auto-migrated to SQLite) ──

entity Deployment {
  deploy_id string required
  service string required
  cluster string required
  duration string
  status enum ["Live", "Rolling", "Failed", "Pending"] required
  deployed_by string
}

entity SecurityEvent {
  event_id string required
  event_type string required
  source_ip string
  severity enum ["Critical", "High", "Medium", "Warning", "Info"] required
  status enum ["Blocked", "Throttled", "Rejected", "Flagged", "Completed"] required
}

entity Endpoint {
  path string required
  method enum ["GET", "POST", "PUT", "DELETE", "WS"] required
  requests number
  avg_latency string
  p99 string
  error_rate string
}

entity KpiSnapshot {
  label string required
  value string required
  change string
  icon string
  subtitle string
  page string required
}

entity User {
  name string required
  email email required unique
  password string sensitive
  role enum ["admin", "operator", "viewer"]
  avatar string
}

# ── APIs (CRUD auto-generated) ──

api /deployments {
  list    GET    /deployments
  find    GET    /deployments/:id
  create  POST   /deployments
  update  PATCH  /deployments/:id
  remove  DELETE /deployments/:id
}

api /securityevents {
  list    GET    /securityevents
  create  POST   /securityevents
}

api /endpoints {
  list    GET    /endpoints
  create  POST   /endpoints
}

api /kpisnapshots {
  list    GET    /kpisnapshots
  create  POST   /kpisnapshots
}

style {
  theme dark
  accent #87adff
  font "Space Grotesk"
  glow-1 "rgba(135,173,255,0.08)"
  glow-2 "rgba(210,119,255,0.05)"
  glow-3 "rgba(129,236,255,0.04)"
}

tailwind_config "tailwind.config = { darkMode: \"class\", theme: { extend: { colors: { \"tertiary\": \"#81ecff\", \"surface-container-lowest\": \"#000000\", \"on-secondary-fixed\": \"#56007c\", \"tertiary-container\": \"#00e3fd\", \"outline\": \"#757575\", \"secondary-dim\": \"#d277ff\", \"on-tertiary-container\": \"#004d57\", \"on-secondary-container\": \"#f3cfff\", \"primary-dim\": \"#006ff0\", \"tertiary-dim\": \"#00d4ec\", \"error-container\": \"#9f0519\", \"on-surface\": \"#ffffff\", \"on-primary-container\": \"#002151\", \"on-surface-variant\": \"#ababab\", \"primary-fixed-dim\": \"#5690ff\", \"primary\": \"#87adff\", \"surface-bright\": \"#2c2c2c\", \"on-primary\": \"#002c67\", \"secondary-container\": \"#7d01b1\", \"outline-variant\": \"#484848\", \"on-tertiary-fixed\": \"#003840\", \"inverse-primary\": \"#005ac6\", \"surface-container-high\": \"#1f1f1f\", \"inverse-surface\": \"#f9f9f9\", \"secondary-fixed\": \"#eec2ff\", \"tertiary-fixed-dim\": \"#00d4ec\", \"surface-container\": \"#191919\", \"error\": \"#ff716c\", \"primary-container\": \"#6f9fff\", \"tertiary-fixed\": \"#00e3fd\", \"on-background\": \"#ffffff\", \"surface\": \"#0e0e0e\", \"on-error-container\": \"#ffa8a3\", \"secondary-fixed-dim\": \"#e7afff\", \"on-tertiary-fixed-variant\": \"#005762\", \"on-primary-fixed-variant\": \"#002a63\", \"background\": \"#0e0e0e\", \"on-primary-fixed\": \"#000000\", \"on-tertiary\": \"#005762\", \"on-secondary\": \"#380052\", \"surface-variant\": \"#262626\", \"primary-fixed\": \"#6f9fff\", \"surface-container-low\": \"#131313\", \"error-dim\": \"#d7383b\", \"secondary\": \"#d277ff\", \"inverse-on-surface\": \"#555555\", \"on-error\": \"#490006\", \"surface-container-highest\": \"#262626\", \"on-secondary-fixed-variant\": \"#800ab4\", \"surface-dim\": \"#0e0e0e\", \"surface-tint\": \"#87adff\" }, fontFamily: { \"headline\": [\"Space Grotesk\"], \"body\": [\"Inter\"], \"label\": [\"Space Grotesk\"] }, borderRadius: { \"DEFAULT\": \"0.125rem\", \"lg\": \"0.25rem\", \"xl\": \"0.5rem\", \"full\": \"0.75rem\" }, }, }, }"

page "/" type:custom {
  use NovaCoreChrome

  section page-header style:dark {
    eyebrow "System Overview"
    title "Operational Flux"
    subtitle "Live system throughput — all data from your account."
  }

  section kpi cols:4 {
    bind KpiSnapshot {
      where page eq "overview"
    }
  }

  section table style:dark {
    title "Recent Activity"
    columns "Deploy ID, Service, Cluster, Status, Duration"
    bind Deployment {
      query all
      order created_at desc
      limit 5
    }
  }
}

define NovaCoreChrome {
  section topbar {
    brand "NOVA CORE"
    template "<header class=\"backdrop-blur-2xl bg-[#0e0e0e]/80 border-[#484848]/15 border-b fixed flex h-14 items-center justify-between px-6 shadow-[0px_0px_40px_rgba(135,173,255,0.04)] top-0 w-full z-50\"><div class=\"flex gap-8 items-center\"><span class=\"font-['Space_Grotesk'] font-black text-white text-xl tracking-tighter uppercase\">NOVA CORE</span><nav class=\"font-['Space_Grotesk'] font-bold gap-6 hidden md:flex tracking-tight\"><a href=\"#\" class=\"hover:text-white text-[#ffffff]/60 transition-colors\">Docs</a><a href=\"#\" class=\"hover:text-white text-[#ffffff]/60 transition-colors\">API</a><a href=\"#\" class=\"hover:text-white text-[#ffffff]/60 transition-colors\">Logs</a></nav></div><div class=\"flex gap-4 items-center\"><div class=\"group relative\"><span class=\"active:scale-95 cursor-pointer duration-100 hover:bg-[#262626] material-symbols-outlined p-2 rounded text-[#87adff] transition-all\">notifications</span><span class=\"absolute animate-pulse bg-tertiary h-1.5 right-2 rounded-full top-2 w-1.5\"></span></div><span class=\"active:scale-95 cursor-pointer duration-100 hover:bg-[#262626] material-symbols-outlined p-2 rounded text-[#ffffff]/60 transition-all\">settings</span></div></header>"
    style_block "     html, body { background: #000000; color: #ffffff; font-family: 'Inter', sans-serif; margin: 0; }     header { position: fixed; top: 0; left: 0; width: 100%; height: 3.5rem; z-index: 50; display: flex; align-items: center; justify-content: space-between; padding: 0 1.5rem; background: rgba(14,14,14,0.8); backdrop-filter: blur(40px); border-bottom: 1px solid rgba(72,72,72,0.15); box-sizing: border-box; }     aside { position: fixed; top: 3.5rem; left: 0; width: 16rem; height: calc(100vh - 3.5rem); background: #000; border-right: 1px solid rgba(72,72,72,0.15); z-index: 40; overflow-y: auto; box-sizing: border-box; }     #cronus-main { margin-left: 16rem; padding: 0; max-width: calc(100% - 16rem); overflow-x: hidden; }     .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24; }     .glass-panel { background: rgba(25, 25, 25, 0.8); backdrop-filter: blur(40px); }     .edge-light { border-top: 0.5px solid rgba(135, 173, 255, 0.2); }     .kinetic-gradient { background: linear-gradient(135deg, #87adff 0%, #d277ff 100%); }     .ambient-glow { box-shadow: 0px 0px 60px rgba(135, 173, 255, 0.04); }     a { color: inherit; text-decoration: none; }   "
  }

  section sidebar {
    brand "Vault OS"
    item "Projects" -> "/" icon:rocket_launch
    item "Deployments" -> "/deployments" icon:terminal
    item "Analytics" -> "/analytics" icon:insert_chart
    item "Security" -> "/security" icon:shield
    template "<aside class=\"bg-[#000000] border-[#484848]/15 border-r fixed flex flex-col font-['Space_Grotesk'] font-medium gap-2 h-[calc(100vh-3.5rem)] left-0 p-4 text-sm top-14 w-64\"><div class=\"mb-6 px-2\"><div class=\"flex gap-3 items-center\"><img src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuATvH3rEjlhQ6WyYQDlk96qT7qoB8jFnQHKfkERqRpNIS1hnphEIDpyx894L5DO53E1_TX2iw94L6bgmfncWNaXCmk15PjXFgu9jzjBn3h_0_YijAQMWPscqtX9ec5SMXgjMvWpYBo8mRw2D4yTJAKuO_u-ueFSZxGfJ6c3sSftLBoy-YCyUn4NwyNSBfp4LdYrSeduin7cYMHh6dmOYHfzJD8eYhwNMUEOqIvcAJt9PVEOkyUd5TPDEHZX5HLHl17L2Kvg_8d_uQvW\" class=\"bg-surface-container h-8 rounded w-8\"><div><p class=\"font-bold text-white text-xs tracking-widest uppercase\">System Admin</p><p class=\"text-[#ffffff]/40 text-[10px]\">Cluster: Alpha-9</p></div></div></div><div class=\"space-y-1\" id=\"cronus-nav\"><a href=\"/\" class=\"cursor-pointer flex gap-3 hover:translate-x-1 items-center px-3 py-2 text-[#ffffff]/40 transition-all\" data-nav><span class=\"material-symbols-outlined\">rocket_launch</span><span>Overview</span></a><a href=\"/deployments\" class=\"cursor-pointer flex gap-3 hover:translate-x-1 items-center px-3 py-2 text-[#ffffff]/40 transition-all\" data-nav><span class=\"material-symbols-outlined\">terminal</span><span>Deployments</span></a><a href=\"/analytics\" class=\"cursor-pointer flex gap-3 hover:translate-x-1 items-center px-3 py-2 text-[#ffffff]/40 transition-all\" data-nav><span class=\"material-symbols-outlined\">insert_chart</span><span>Analytics</span></a><a href=\"/security\" class=\"cursor-pointer flex gap-3 hover:translate-x-1 items-center px-3 py-2 text-[#ffffff]/40 transition-all\" data-nav><span class=\"material-symbols-outlined\">shield</span><span>Security</span></a></div><div class=\"border-[#484848]/15 border-t mt-auto pt-4 space-y-1\"><button onclick=\"cronusModal.open('new-deployment')\" class=\"active:scale-95 font-bold kinetic-gradient mb-4 py-2 rounded text-white text-xs tracking-tighter transition-transform uppercase w-full cursor-pointer border-0\">New Deployment</button></div></aside><script>!function(){var p=location.pathname;document.querySelectorAll('[data-nav]').forEach(function(a){if(a.getAttribute('href')===p){a.className='bg-[#191919] border-[#87adff] border-r-2 cursor-pointer flex gap-3 hover:translate-x-1 items-center px-3 py-2 text-white transition-all';var ic=a.querySelector('.material-symbols-outlined');if(ic)ic.style.fontVariationSettings=\"'FILL' 1\";}});}();</script>"
  }

  section modal id:"new-deployment" icon:"rocket_launch" entity:"Deployment" {
    title "New Deployment"
    subtitle "Configure and launch a new deployment to your cluster."

    field "Deploy ID" type:text placeholder:"DPL-5001" required:true
    field "Service" type:text placeholder:"e.g. api-gateway-v3" required:true
    field "Cluster" type:select options:"us-east-1||eu-west-2||ap-south-1||us-west-2"
    field "Status" type:select options:"Pending||Rolling||Live"
    field "Duration" type:text placeholder:"0s"
    field "Deployed By" type:text placeholder:"zedd"

    summary "Estimated Build Time" value:"~45s"
    summary "Target Replicas" value:"3 instances"
    summary "Health Check" value:"Enabled" color:"#10b981"

    action "Cancel" style:secondary
    action "Deploy Now" style:primary
  }

  section footer style:dark {
    template "<footer class=\"bg-[#000000] border-[#484848]/15 border-t bottom-0 fixed flex font-['Space_Grotesk'] h-8 items-center justify-between px-6 text-[10px] tracking-widest uppercase w-full z-50\"><div class=\"flex gap-4 items-center text-[#ffffff]/30\"><span>Uptime: 99.99%</span><span class=\"bg-[#484848]/40 h-1 rounded-full w-1\"></span><span class=\"animate-pulse text-[#81ecff]\">Latency: 14ms</span><span class=\"bg-[#484848]/40 h-1 rounded-full w-1\"></span><span>Region: US-EAST</span></div><div class=\"text-[#ffffff]/30\">v2.4.0-stable</div></footer>"
  }
}

page "/deployments" type:custom {
  use NovaCoreChrome

  section page-header style:dark {
    eyebrow "Infrastructure"
    title "Active Deployments"
    subtitle "Real-time deployment pipeline status across all clusters and regions."
  }

  section kpi cols:4 {
    bind KpiSnapshot {
      where page eq "deployments"
    }
  }

  section table style:dark {
    title "Recent Deployments"
    search "Filter by service, cluster, or status..."
    columns "Deploy ID, Service, Cluster, Duration, Status"
    bind Deployment {
      query all
      order created_at desc
      limit 20
    }
  }

}

page "/analytics" type:custom {
  use NovaCoreChrome

  section page-header style:dark {
    eyebrow "Observability"
    title "System Analytics"
    subtitle "Aggregated telemetry data from all nodes. Precision-verified by the Nova Core engine."
  }

  section kpi cols:4 {
    bind KpiSnapshot {
      where page eq "analytics"
    }
  }

  section chart style:dark {
    title "Request Volume (7d)"
    subtitle "Inbound traffic across all endpoints"
    type area
    periods "1h, 6h, 24h, 7d"
    y_axis "300K, 200K, 100K, 0"
    x_axis "Mon, Tue, Wed, Thu, Fri, Sat, Sun"
  }

  section table style:dark {
    title "Top Endpoints by Volume"
    columns "Path, Method, Requests, Avg Latency, P99, Error Rate"
    bind Endpoint {
      query all
      order created_at desc
      limit 20
    }
  }

}

page "/security" type:custom {
  use NovaCoreChrome

  section page-header style:dark {
    eyebrow "Zero Trust"
    title "Security Posture"
    subtitle "Continuous threat monitoring, access control policies, and compliance status."
  }

  section kpi cols:4 {
    bind KpiSnapshot {
      where page eq "security"
    }
  }

  section table style:dark {
    title "Recent Security Events"
    search "Filter events..."
    columns "Event ID, Event Type, Source IP, Severity, Status"
    bind SecurityEvent {
      query all
      order created_at desc
      limit 20
    }
  }

}
page "/login" type:custom {
  section hero {
    template "<div style='min-height:100vh;display:flex;align-items:center;justify-content:center;background:#0e0e0e;position:relative;overflow:hidden;font-family:Inter,sans-serif'><div style='position:fixed;inset:0;pointer-events:none'><div style='position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:800px;height:800px;background:rgba(135,173,255,0.04);border-radius:50%;filter:blur(120px)'></div><div style='position:absolute;top:20%;right:10%;width:400px;height:400px;background:rgba(210,119,255,0.04);border-radius:50%;filter:blur(100px)'></div><div style='position:absolute;bottom:-100px;left:-100px;width:400px;height:400px;background:rgba(210,119,255,0.06);border-radius:50%;filter:blur(120px)'></div></div><div style='position:relative;z-index:10;width:100%;max-width:440px;padding:0 24px'><div style='background:rgba(25,25,25,0.7);backdrop-filter:blur(40px);-webkit-backdrop-filter:blur(40px);border-radius:12px;padding:40px;box-shadow:0 0 60px rgba(135,173,255,0.04);border-top:0.5px solid rgba(135,173,255,0.2);border-left:0.5px solid rgba(135,173,255,0.1)'><div style='text-align:center;margin-bottom:32px'><h1 style='font-family:Space Grotesk,sans-serif;font-size:32px;font-weight:700;letter-spacing:-0.02em;color:#fff;margin:0 0 8px;text-shadow:0 0 20px rgba(135,173,255,0.3)'>Secure Access</h1><p style='font-size:11px;font-family:Space Grotesk,sans-serif;letter-spacing:0.15em;text-transform:uppercase;color:#ababab;margin:0'>Enter the operational command center</p></div><form id='login-form' style='display:flex;flex-direction:column;gap:20px'><div><label style='display:block;font-size:10px;font-family:Space Grotesk,sans-serif;letter-spacing:0.15em;text-transform:uppercase;color:#ababab;margin:0 0 6px 4px'>Identity Token</label><input type='email' name='email' placeholder='operator@nova-core.io' required style='width:100%;background:#000;border:1px solid rgba(255,255,255,0.05);border-radius:8px;padding:14px 18px;color:#fff;font-size:14px;outline:none;transition:all 0.3s;box-sizing:border-box' onfocus=\"this.style.borderColor='rgba(135,173,255,0.3)';this.style.boxShadow='0 0 4px rgba(135,173,255,0.2)'\" onblur=\"this.style.borderColor='rgba(255,255,255,0.05)';this.style.boxShadow='none'\"></div><div><div style='display:flex;justify-content:space-between;align-items:center;margin:0 0 6px 4px'><label style='font-size:10px;font-family:Space Grotesk,sans-serif;letter-spacing:0.15em;text-transform:uppercase;color:#ababab'>Passphrase</label></div><input type='password' name='password' placeholder='••••••••••••' required style='width:100%;background:#000;border:1px solid rgba(255,255,255,0.05);border-radius:8px;padding:14px 18px;color:#fff;font-size:14px;outline:none;transition:all 0.3s;box-sizing:border-box' onfocus=\"this.style.borderColor='rgba(135,173,255,0.3)';this.style.boxShadow='0 0 4px rgba(135,173,255,0.2)'\" onblur=\"this.style.borderColor='rgba(255,255,255,0.05)';this.style.boxShadow='none'\"></div><div id='login-msg' style='display:none;padding:10px 14px;border-radius:8px;font-size:12px;text-align:center'></div><button type='submit' id='login-btn' style='width:100%;padding:14px;border:none;border-radius:8px;background:linear-gradient(135deg,#87adff,#d277ff);color:#000;font-family:Space Grotesk,sans-serif;font-size:13px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;cursor:pointer;box-shadow:0 0 20px rgba(135,173,255,0.15);transition:all 0.15s;position:relative;overflow:hidden' onmouseover=\"this.style.filter='brightness(1.1)'\" onmouseout=\"this.style.filter='none'\">Initialize Portal</button></form><div style='display:flex;align-items:center;gap:16px;margin-top:24px'><div style='flex:1;height:1px;background:linear-gradient(to right,transparent,rgba(72,72,72,0.3),transparent)'></div><span style='font-size:9px;font-family:Space Grotesk,sans-serif;letter-spacing:0.2em;text-transform:uppercase;color:#555'>Or</span><div style='flex:1;height:1px;background:linear-gradient(to right,transparent,rgba(72,72,72,0.3),transparent)'></div></div><p style='text-align:center;margin-top:16px;font-size:13px;color:#ababab'>No account? <a href=\"/signup\" style='color:#87adff;text-decoration:none;font-weight:600'>Create Access</a></p></div><div style='text-align:center;margin-top:24px'><div style='display:flex;align-items:center;justify-content:center;gap:8px'><span style='width:6px;height:6px;border-radius:50%;background:#81ecff;box-shadow:0 0 8px #81ecff;animation:pulse 2s ease-in-out infinite'></span><span style='font-family:Space Grotesk,sans-serif;font-size:10px;letter-spacing:0.15em;text-transform:uppercase;color:#81ecff'>Live Uplink</span></div></div></div></div><script>document.getElementById('login-form').addEventListener('submit',async function(e){e.preventDefault();var btn=document.getElementById('login-btn');var msg=document.getElementById('login-msg');btn.disabled=true;btn.innerHTML='<span style=\"display:inline-block;width:16px;height:16px;border:2px solid rgba(0,0,0,0.2);border-top-color:#000;border-radius:50%;animation:spin 0.6s linear infinite\"></span>';msg.style.display='none';var data={};new FormData(this).forEach(function(v,k){data[k]=v});try{var r=await fetch('/api/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});var body=await r.json();if(r.ok&&body.token){localStorage.setItem('token',body.token);localStorage.setItem('user',JSON.stringify(body.user||{}));window.location.href='/'}else{msg.style.display='block';msg.style.background='rgba(239,68,68,0.1)';msg.style.color='#ef4444';msg.style.border='1px solid rgba(239,68,68,0.2)';msg.textContent=body.error||'Invalid credentials';btn.disabled=false;btn.textContent='Initialize Portal'}}catch(err){msg.style.display='block';msg.style.background='rgba(239,68,68,0.1)';msg.style.color='#ef4444';msg.textContent='Connection error';btn.disabled=false;btn.textContent='Initialize Portal'}});</script>"
  }
}

page "/signup" type:custom {
  section hero {
    template "<div style='min-height:100vh;display:flex;align-items:center;justify-content:center;background:#0e0e0e;position:relative;overflow:hidden;font-family:Inter,sans-serif'><div style='position:fixed;inset:0;pointer-events:none'><div style='position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:800px;height:800px;background:rgba(135,173,255,0.04);border-radius:50%;filter:blur(120px)'></div><div style='position:absolute;top:20%;right:10%;width:400px;height:400px;background:rgba(210,119,255,0.04);border-radius:50%;filter:blur(100px)'></div></div><div style='position:relative;z-index:10;width:100%;max-width:440px;padding:0 24px'><div style='background:rgba(25,25,25,0.7);backdrop-filter:blur(40px);-webkit-backdrop-filter:blur(40px);border-radius:12px;padding:40px;box-shadow:0 0 60px rgba(135,173,255,0.04);border-top:0.5px solid rgba(135,173,255,0.2);border-left:0.5px solid rgba(135,173,255,0.1)'><div style='text-align:center;margin-bottom:32px'><h1 style='font-family:Space Grotesk,sans-serif;font-size:32px;font-weight:700;letter-spacing:-0.02em;color:#fff;margin:0 0 8px;text-shadow:0 0 20px rgba(135,173,255,0.3)'>Create Access</h1><p style='font-size:11px;font-family:Space Grotesk,sans-serif;letter-spacing:0.15em;text-transform:uppercase;color:#ababab;margin:0'>Join the operational network</p></div><form id='signup-form' style='display:flex;flex-direction:column;gap:20px'><div><label style='display:block;font-size:10px;font-family:Space Grotesk,sans-serif;letter-spacing:0.15em;text-transform:uppercase;color:#ababab;margin:0 0 6px 4px'>Operator Name</label><input type='text' name='name' placeholder='Commander Zedd' required style='width:100%;background:#000;border:1px solid rgba(255,255,255,0.05);border-radius:8px;padding:14px 18px;color:#fff;font-size:14px;outline:none;transition:all 0.3s;box-sizing:border-box' onfocus=\"this.style.borderColor='rgba(135,173,255,0.3)'\" onblur=\"this.style.borderColor='rgba(255,255,255,0.05)'\"></div><div><label style='display:block;font-size:10px;font-family:Space Grotesk,sans-serif;letter-spacing:0.15em;text-transform:uppercase;color:#ababab;margin:0 0 6px 4px'>Identity Token</label><input type='email' name='email' placeholder='operator@nova-core.io' required style='width:100%;background:#000;border:1px solid rgba(255,255,255,0.05);border-radius:8px;padding:14px 18px;color:#fff;font-size:14px;outline:none;transition:all 0.3s;box-sizing:border-box' onfocus=\"this.style.borderColor='rgba(135,173,255,0.3)'\" onblur=\"this.style.borderColor='rgba(255,255,255,0.05)'\"></div><div><label style='display:block;font-size:10px;font-family:Space Grotesk,sans-serif;letter-spacing:0.15em;text-transform:uppercase;color:#ababab;margin:0 0 6px 4px'>Passphrase</label><input type='password' name='password' placeholder='••••••••••••' required style='width:100%;background:#000;border:1px solid rgba(255,255,255,0.05);border-radius:8px;padding:14px 18px;color:#fff;font-size:14px;outline:none;transition:all 0.3s;box-sizing:border-box' onfocus=\"this.style.borderColor='rgba(135,173,255,0.3)'\" onblur=\"this.style.borderColor='rgba(255,255,255,0.05)'\"></div><div id='signup-msg' style='display:none;padding:10px 14px;border-radius:8px;font-size:12px;text-align:center'></div><button type='submit' id='signup-btn' style='width:100%;padding:14px;border:none;border-radius:8px;background:linear-gradient(135deg,#87adff,#d277ff);color:#000;font-family:Space Grotesk,sans-serif;font-size:13px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;cursor:pointer;box-shadow:0 0 20px rgba(135,173,255,0.15);transition:all 0.15s' onmouseover=\"this.style.filter='brightness(1.1)'\" onmouseout=\"this.style.filter='none'\">Initialize Access</button></form><p style='text-align:center;margin-top:20px;font-size:13px;color:#ababab'>Already have access? <a href=\"/login\" style='color:#87adff;text-decoration:none;font-weight:600'>Sign In</a></p></div><div style='text-align:center;margin-top:24px'><div style='display:flex;align-items:center;justify-content:center;gap:8px'><span style='width:6px;height:6px;border-radius:50%;background:#81ecff;box-shadow:0 0 8px #81ecff;animation:pulse 2s ease-in-out infinite'></span><span style='font-family:Space Grotesk,sans-serif;font-size:10px;letter-spacing:0.15em;text-transform:uppercase;color:#81ecff'>Live Uplink</span></div></div></div></div><script>document.getElementById('signup-form').addEventListener('submit',async function(e){e.preventDefault();var btn=document.getElementById('signup-btn');var msg=document.getElementById('signup-msg');btn.disabled=true;btn.innerHTML='<span style=\"display:inline-block;width:16px;height:16px;border:2px solid rgba(0,0,0,0.2);border-top-color:#000;border-radius:50%;animation:spin 0.6s linear infinite\"></span>';msg.style.display='none';var data={};new FormData(this).forEach(function(v,k){data[k]=v});try{var r=await fetch('/api/auth/signup',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});var body=await r.json();if(r.ok&&body.token){localStorage.setItem('token',body.token);localStorage.setItem('user',JSON.stringify(body.user||{}));window.location.href='/'}else{msg.style.display='block';msg.style.background='rgba(239,68,68,0.1)';msg.style.color='#ef4444';msg.style.border='1px solid rgba(239,68,68,0.2)';msg.textContent=body.error||'Registration failed';btn.disabled=false;btn.textContent='Initialize Access'}}catch(err){msg.style.display='block';msg.style.background='rgba(239,68,68,0.1)';msg.style.color='#ef4444';msg.textContent='Connection error';btn.disabled=false;btn.textContent='Initialize Access'}});</script>"
  }
}
