/// Nova Core — High-performance operational dashboard.
/// Real-time deployment pipeline monitoring for SRE teams.
/// @team Platform Engineering
/// @status production
/// @since 2026-04-01
app "NOVA CORE | High-Performance Dashboard" {
  stack fullstack
  port 5175
  database sqlite "./data.db"
  theme dark

  constitution {
    must "prices in centavos — use formatPrice()"
    must "all data sections require bind"
    must "auth required on all admin endpoints"
    never "expose passwords in API responses"
    never "hardcode user data in templates"
    never "use location.reload()"
  }
}

# ── Entities (auto-migrated to SQLite) ──

/// Tracks deployment pipeline across all clusters.
/// @owner sre-team
/// @lifecycle retain 90 days
entity Deployment shared {
  /// Unique deploy identifier (format: DPL-XXXX)
  /// @example "DPL-5001"
  deploy_id string required
  /// Target microservice name
  /// @example "api-gateway-v3"
  service string required
  /// AWS/GCP region for this deploy
  cluster string required
  /// Total deployment time
  duration string
  /// Current pipeline state
  /// @business "Failed" triggers PagerDuty alert
  status enum ["Live", "Rolling", "Failed", "Pending"] required
  /// Engineer who initiated the deploy
  deployed_by string
}

entity SecurityEvent shared {
  event_id string required
  event_type string required
  source_ip string
  severity enum ["Critical", "High", "Medium", "Warning", "Info"] required
  status enum ["Blocked", "Throttled", "Rejected", "Flagged", "Completed"] required
}

entity Endpoint shared {
  path string required
  method enum ["GET", "POST", "PUT", "DELETE", "WS"] required
  requests number
  avg_latency string
  p99 string
  error_rate string
}

entity KpiSnapshot shared {
  label string required
  value string required
  change string
  icon string
  subtitle string
  page string required
}

entity Notification shared {
  title string required
  message string
  type enum ["info", "warning", "error", "success"] required
  read boolean
}

entity User {
  name string required
  email email required unique
  password string sensitive
  role enum ["admin", "operator", "viewer"]
  avatar string
}

# ── APIs (CRUD auto-generated) ──

api /deployments {
  list    GET    /deployments
  find    GET    /deployments/:id
  create  POST   /deployments    auth:jwt
  update  PATCH  /deployments/:id auth:jwt
  remove  DELETE /deployments/:id auth:jwt
}

api /securityevents {
  list    GET    /securityevents
  create  POST   /securityevents  auth:jwt
}

api /endpoints {
  list    GET    /endpoints
  create  POST   /endpoints       auth:jwt
}

api /kpisnapshots {
  list    GET    /kpisnapshots
  create  POST   /kpisnapshots    auth:jwt
}

api /notifications {
  list    GET    /notifications
  create  POST   /notifications   auth:jwt
  update  PATCH  /notifications/:id auth:jwt
  remove  DELETE /notifications/:id auth:jwt
}

webhook /deployments {
  on create -> POST "https://hooks.slack.com/services/nova-core/deployments"
  on delete -> POST "https://hooks.slack.com/services/nova-core/alerts"
}

webhook /securityevents {
  on create -> POST "https://hooks.slack.com/services/nova-core/security"
}

style {
  theme dark
  accent #87adff
  font "Space Grotesk"
  glow-1 "rgba(135,173,255,0.08)"
  glow-2 "rgba(210,119,255,0.05)"
  glow-3 "rgba(129,236,255,0.04)"
}

tailwind_config "tailwind.config = { darkMode: \"class\", theme: { extend: { colors: { \"tertiary\": \"#81ecff\", \"surface-container-lowest\": \"#000000\", \"on-secondary-fixed\": \"#56007c\", \"tertiary-container\": \"#00e3fd\", \"outline\": \"#757575\", \"secondary-dim\": \"#d277ff\", \"on-tertiary-container\": \"#004d57\", \"on-secondary-container\": \"#f3cfff\", \"primary-dim\": \"#006ff0\", \"tertiary-dim\": \"#00d4ec\", \"error-container\": \"#9f0519\", \"on-surface\": \"#ffffff\", \"on-primary-container\": \"#002151\", \"on-surface-variant\": \"#ababab\", \"primary-fixed-dim\": \"#5690ff\", \"primary\": \"#87adff\", \"surface-bright\": \"#2c2c2c\", \"on-primary\": \"#002c67\", \"secondary-container\": \"#7d01b1\", \"outline-variant\": \"#484848\", \"on-tertiary-fixed\": \"#003840\", \"inverse-primary\": \"#005ac6\", \"surface-container-high\": \"#1f1f1f\", \"inverse-surface\": \"#f9f9f9\", \"secondary-fixed\": \"#eec2ff\", \"tertiary-fixed-dim\": \"#00d4ec\", \"surface-container\": \"#191919\", \"error\": \"#ff716c\", \"primary-container\": \"#6f9fff\", \"tertiary-fixed\": \"#00e3fd\", \"on-background\": \"#ffffff\", \"surface\": \"#0e0e0e\", \"on-error-container\": \"#ffa8a3\", \"secondary-fixed-dim\": \"#e7afff\", \"on-tertiary-fixed-variant\": \"#005762\", \"on-primary-fixed-variant\": \"#002a63\", \"background\": \"#0e0e0e\", \"on-primary-fixed\": \"#000000\", \"on-tertiary\": \"#005762\", \"on-secondary\": \"#380052\", \"surface-variant\": \"#262626\", \"primary-fixed\": \"#6f9fff\", \"surface-container-low\": \"#131313\", \"error-dim\": \"#d7383b\", \"secondary\": \"#d277ff\", \"inverse-on-surface\": \"#555555\", \"on-error\": \"#490006\", \"surface-container-highest\": \"#262626\", \"on-secondary-fixed-variant\": \"#800ab4\", \"surface-dim\": \"#0e0e0e\", \"surface-tint\": \"#87adff\" }, fontFamily: { \"headline\": [\"Space Grotesk\"], \"body\": [\"Inter\"], \"label\": [\"Space Grotesk\"] }, borderRadius: { \"DEFAULT\": \"0.125rem\", \"lg\": \"0.25rem\", \"xl\": \"0.5rem\", \"full\": \"0.75rem\" }, }, }, }"

page "/" type:custom requires:auth {
  use NovaCoreChrome

  section page-header style:dark {
    eyebrow "System Overview"
    title "Operational Flux"
    subtitle "Live system throughput — all data from your account."
  }

  section kpi cols:4 {
    bind KpiSnapshot {
      where page eq "overview"
    }
  }

  section chart style:dark {
    title "System Throughput"
    subtitle "Request volume across all services"
    type bar
    periods "1h, 6h, 24h, 7d"
    y_axis "300K, 200K, 100K, 0"
    x_axis "00:00, 04:00, 08:00, 12:00, 16:00, 20:00, 00:00"
    bind Deployment { query all }
  }

  section table style:dark {
    title "Recent Activity"
    columns "Deploy ID, Service, Cluster, Status, Duration"
    bind Deployment {
      query all
      order created_at desc
      limit 5
    }
  }
}

define NovaCoreChrome {
  section topbar {
    brand "NOVA CORE"
    template "<header class=\"backdrop-blur-2xl bg-[#0e0e0e]/80 border-[#484848]/15 border-b fixed flex h-14 items-center justify-between px-6 shadow-[0px_0px_40px_rgba(135,173,255,0.04)] top-0 w-full z-50\"><div class=\"flex gap-8 items-center\"><span class=\"font-['Space_Grotesk'] font-black text-white text-xl tracking-tighter uppercase\">NOVA CORE</span><nav class=\"font-['Space_Grotesk'] font-bold gap-6 hidden md:flex tracking-tight\"><a href=\"/docs\" class=\"hover:text-white text-[#ffffff]/60 transition-colors\">Docs</a><a href=\"/deployments\" class=\"hover:text-white text-[#ffffff]/60 transition-colors\">Deployments</a><a href=\"/notifications\" class=\"hover:text-white text-[#ffffff]/60 transition-colors\">Alerts</a></nav></div><div class=\"flex gap-4 items-center\"><a href=\"/notifications\" class=\"group relative\"><span class=\"active:scale-95 cursor-pointer duration-100 hover:bg-[#262626] material-symbols-outlined p-2 rounded text-[#87adff] transition-all\">notifications</span><span id=\"notif-badge\" class=\"absolute animate-pulse bg-tertiary rounded-full top-2 right-2\" style=\"display:none;width:6px;height:6px\"></span></a><a href=\"/settings\" class=\"active:scale-95 cursor-pointer duration-100 hover:bg-[#262626] material-symbols-outlined p-2 rounded text-[#ffffff]/60 transition-all\">settings</a></div></header>"
    style_block "     html, body { background: #000000; color: #ffffff; font-family: 'Inter', sans-serif; margin: 0; }     header { position: fixed; top: 0; left: 0; width: 100%; height: 3.5rem; z-index: 50; display: flex; align-items: center; justify-content: space-between; padding: 0 1.5rem; background: rgba(14,14,14,0.8); backdrop-filter: blur(40px); border-bottom: 1px solid rgba(72,72,72,0.15); box-sizing: border-box; }     aside { position: fixed; top: 3.5rem; left: 0; width: 16rem; height: calc(100vh - 3.5rem); background: #000; border-right: 1px solid rgba(72,72,72,0.15); z-index: 40; overflow-y: auto; box-sizing: border-box; }     #cronus-main { margin-left: 16rem !important; padding: 2rem 2rem 4rem !important; width: calc(100% - 16rem) !important; max-width: calc(100% - 16rem) !important; overflow-x: hidden; min-height: calc(100vh - 3.5rem); box-sizing: border-box; }     .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24; }     .glass-panel { background: rgba(25, 25, 25, 0.8); backdrop-filter: blur(40px); }     .edge-light { border-top: 0.5px solid rgba(135, 173, 255, 0.2); }     .kinetic-gradient { background: linear-gradient(135deg, #87adff 0%, #d277ff 100%); }     .ambient-glow { box-shadow: 0px 0px 60px rgba(135, 173, 255, 0.04); }     a { color: inherit; text-decoration: none; }   "
  }

  section sidebar {
    brand "Vault OS"
    item "Projects" -> "/" icon:rocket_launch
    item "Deployments" -> "/deployments" icon:terminal
    item "Analytics" -> "/analytics" icon:insert_chart
    item "Security" -> "/security" icon:shield
    template "<aside class=\"bg-[#000000] border-[#484848]/15 border-r fixed flex flex-col font-['Space_Grotesk'] font-medium gap-2 h-[calc(100vh-3.5rem)] left-0 p-4 text-sm top-14 w-64\"><div class=\"mb-6 px-2\"><div class=\"flex gap-3 items-center\"><div id=\"user-avatar\" style=\"width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#87adff,#d277ff);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:#fff;flex-shrink:0\">?</div><div><p id=\"user-display-name\" class=\"font-bold text-white text-xs tracking-widest uppercase\">...</p><p id=\"user-display-role\" class=\"text-[#ffffff]/40 text-[10px]\">Loading</p></div></div></div><div class=\"space-y-1\" id=\"cronus-nav\"><a href=\"/\" class=\"cursor-pointer flex gap-3 hover:translate-x-1 items-center px-3 py-2 text-[#ffffff]/40 transition-all\" data-nav><span class=\"material-symbols-outlined\">rocket_launch</span><span>Overview</span></a><a href=\"/deployments\" class=\"cursor-pointer flex gap-3 hover:translate-x-1 items-center px-3 py-2 text-[#ffffff]/40 transition-all\" data-nav><span class=\"material-symbols-outlined\">terminal</span><span>Deployments</span></a><a href=\"/analytics\" class=\"cursor-pointer flex gap-3 hover:translate-x-1 items-center px-3 py-2 text-[#ffffff]/40 transition-all\" data-nav><span class=\"material-symbols-outlined\">insert_chart</span><span>Analytics</span></a><a href=\"/security\" class=\"cursor-pointer flex gap-3 hover:translate-x-1 items-center px-3 py-2 text-[#ffffff]/40 transition-all\" data-nav><span class=\"material-symbols-outlined\">shield</span><span>Security</span></a><a href=\"/server\" class=\"cursor-pointer flex gap-3 hover:translate-x-1 items-center px-3 py-2 text-[#ffffff]/40 transition-all\" data-nav><span class=\"material-symbols-outlined\">dns</span><span>Server</span></a><a href=\"/settings\" class=\"cursor-pointer flex gap-3 hover:translate-x-1 items-center px-3 py-2 text-[#ffffff]/40 transition-all\" data-nav><span class=\"material-symbols-outlined\">settings</span><span>Settings</span></a></div><div class=\"border-[#484848]/15 border-t mt-auto pt-4 space-y-1\"><button onclick=\"cronusModal.open('new-deployment')\" class=\"active:scale-95 font-bold kinetic-gradient mb-4 py-2 rounded text-white text-xs tracking-tighter transition-transform uppercase w-full cursor-pointer border-0\">New Deployment</button><a onclick=\"localStorage.removeItem('token');localStorage.removeItem('user');window.location.href='/login'\" class=\"cursor-pointer flex gap-3 items-center px-3 py-2 text-[#ffffff]/30 hover:text-[#ef4444] transition-all\"><span class=\"material-symbols-outlined\">logout</span><span>Sign Out</span></a></div></aside><script>!function(){var u=JSON.parse(localStorage.getItem('user')||'{}');var n=u.name||'Guest';var r=u.role||'operator';var el=document.getElementById('user-display-name');if(el)el.textContent=n;var rl=document.getElementById('user-display-role');if(rl)rl.textContent=r.charAt(0).toUpperCase()+r.slice(1);var av=document.getElementById('user-avatar');if(av)av.textContent=n.split(' ').map(function(w){return w[0]}).join('').toUpperCase().slice(0,2);var p=location.pathname;document.querySelectorAll('[data-nav]').forEach(function(a){if(a.getAttribute('href')===p){a.className='bg-[#191919] border-[#87adff] border-r-2 cursor-pointer flex gap-3 hover:translate-x-1 items-center px-3 py-2 text-white transition-all';var ic=a.querySelector('.material-symbols-outlined');if(ic)ic.style.fontVariationSettings=\"'FILL' 1\";}});if(!localStorage.getItem('token')&&p!=='/login'&&p!=='/signup')window.location.href='/login';var tk=localStorage.getItem('token');if(tk){fetch('/api/notifications?limit=100',{headers:{'Authorization':'Bearer '+tk}}).then(function(r){return r.json()}).then(function(data){if(!Array.isArray(data))return;var unread=data.filter(function(n){return !n.read||n.read==='false'});var badge=document.getElementById('notif-badge');if(badge&&unread.length>0){badge.style.display='block';badge.style.width=unread.length>9?'16px':'6px';badge.style.height=unread.length>9?'16px':'6px';if(unread.length>1){badge.textContent=unread.length;badge.style.fontSize='9px';badge.style.display='flex';badge.style.alignItems='center';badge.style.justifyContent='center';badge.style.color='#000';badge.style.fontWeight='700';badge.style.fontFamily='Space Grotesk,sans-serif'}}}).catch(function(){});};}();</script>"
  }

  section modal id:"new-deployment" icon:"rocket_launch" entity:"Deployment" {
    title "New Deployment"
    subtitle "Configure and launch a new deployment to your cluster."

    field "Deploy ID" type:text placeholder:"DPL-5001" required:true
    field "Service" type:text placeholder:"e.g. api-gateway-v3" required:true
    field "Cluster" type:select options:"us-east-1||eu-west-2||ap-south-1||us-west-2"
    field "Status" type:select options:"Pending||Rolling||Live"
    field "Duration" type:text placeholder:"0s"
    field "Deployed By" type:text placeholder:"Your name"

    action "Cancel" style:secondary
    action "Deploy Now" style:primary
  }

  section footer style:dark {
    template "<footer class=\"bg-[#000000] border-[#484848]/15 border-t bottom-0 fixed flex font-['Space_Grotesk'] h-8 items-center justify-between px-6 text-[10px] tracking-widest uppercase w-full z-50\"><div class=\"flex gap-4 items-center text-[#ffffff]/30\"><span id=\"footer-uptime\">Uptime: —</span><span class=\"bg-[#484848]/40 h-1 rounded-full w-1\"></span><span id=\"footer-latency\" class=\"animate-pulse text-[#81ecff]\">Latency: —</span><span class=\"bg-[#484848]/40 h-1 rounded-full w-1\"></span><span id=\"footer-region\">Region: —</span></div><div id=\"footer-version\" class=\"text-[#ffffff]/30\">—</div></footer><script>!function(){var tk=localStorage.getItem('token');var h=tk?{'Authorization':'Bearer '+tk}:{};function updateFooter(){fetch('/api/server/stats',{headers:h}).then(function(r){return r.json()}).then(function(d){var b=d.brain||{};var total=b.total_events||0;var el=document.getElementById('footer-uptime');if(el)el.textContent='Requests: '+total;var lat=document.getElementById('footer-latency');if(lat)lat.textContent='Live';var reg=document.getElementById('footer-region');if(reg)reg.textContent='Pages: '+(d.pages||0);var ver=document.getElementById('footer-version');if(ver)ver.textContent=(d.apis||0)+' API groups'}).catch(function(){})}updateFooter();setInterval(updateFooter,10000);}();</script>"
  }
}

page "/deployments" type:custom requires:auth {
  use NovaCoreChrome

  section page-header style:dark {
    eyebrow "Infrastructure"
    title "Active Deployments"
    subtitle "Real-time deployment pipeline status across all clusters and regions."
  }

  section kpi cols:4 {
    bind KpiSnapshot {
      where page eq "deployments"
    }
  }

  section table style:dark {
    title "Recent Deployments"
    search "Filter by service, cluster, or status..."
    columns "Deploy ID, Service, Cluster, Duration, Status"
    bind Deployment {
      query all
      order created_at desc
      limit 20
    }
  }

}

page "/analytics" type:custom requires:auth {
  use NovaCoreChrome

  section page-header style:dark {
    eyebrow "Observability"
    title "System Analytics"
    subtitle "Aggregated telemetry data from all nodes. Precision-verified by the Nova Core engine."
  }

  section kpi cols:4 {
    bind KpiSnapshot {
      where page eq "analytics"
    }
  }

  section chart style:dark {
    title "Request Volume (7d)"
    subtitle "Inbound traffic across all endpoints"
    type area
    periods "1h, 6h, 24h, 7d"
    y_axis "300K, 200K, 100K, 0"
    x_axis "Mon, Tue, Wed, Thu, Fri, Sat, Sun"
    bind Endpoint { query all }
  }

  section table style:dark {
    title "Top Endpoints by Volume"
    columns "Path, Method, Requests, Avg Latency, P99, Error Rate"
    bind Endpoint {
      query all
      order created_at desc
      limit 20
    }
  }

}

page "/security" type:custom requires:auth {
  use NovaCoreChrome

  section page-header style:dark {
    eyebrow "Zero Trust"
    title "Security Posture"
    subtitle "Continuous threat monitoring, access control policies, and compliance status."
  }

  section kpi cols:4 {
    bind KpiSnapshot {
      where page eq "security"
    }
  }

  section table style:dark {
    title "Recent Security Events"
    search "Filter events..."
    columns "Event ID, Event Type, Source IP, Severity, Status"
    bind SecurityEvent {
      query all
      order created_at desc
      limit 20
    }
  }

}
page "/server" type:custom requires:auth {
  use NovaCoreChrome

  section page-header style:dark {
    eyebrow "Infrastructure"
    title "Server"
    subtitle "Real-time logs, request metrics, and brain insights."
  }

  section hero {
    template "<div style='display:flex;flex-direction:column;gap:24px'><div id='server-stats' style='display:grid;grid-template-columns:repeat(4,1fr);gap:16px'></div><div style='display:flex;gap:16px'><div style='flex:2'><div style='display:flex;justify-content:space-between;align-items:center;margin-bottom:16px'><h3 style='font-family:Space Grotesk,sans-serif;font-size:14px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:rgba(226,226,226,0.4);margin:0'>Request Log</h3><div style='display:flex;gap:8px'><button id='log-refresh' onclick='loadLogs&&loadLogs();loadStats&&loadStats()' style='font-size:10px;color:#87adff;background:none;border:1px solid rgba(135,173,255,0.2);border-radius:4px;padding:4px 12px;cursor:pointer;font-family:Space Grotesk,sans-serif;text-transform:uppercase;letter-spacing:0.1em;font-weight:700'>Refresh</button><span id='log-live' style='display:flex;align-items:center;gap:6px;font-size:10px;color:#81ecff;font-family:Space Grotesk,sans-serif;text-transform:uppercase;letter-spacing:0.1em'><span style='width:6px;height:6px;border-radius:50%;background:#81ecff;animation:pulse 2s infinite'></span>Live</span></div></div><div id='server-logs' style='background:#0e0e0e;border:1px solid rgba(255,255,255,0.03);border-radius:8px;font-family:monospace;font-size:11px;max-height:500px;overflow-y:auto'></div></div><div style='flex:1'><h3 style='font-family:Space Grotesk,sans-serif;font-size:14px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:rgba(226,226,226,0.4);margin:0 0 16px'>Brain Insights</h3><div id='server-insights' style='display:flex;flex-direction:column;gap:8px'></div><h3 style='font-family:Space Grotesk,sans-serif;font-size:14px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:rgba(226,226,226,0.4);margin:24px 0 16px'>Entity Rows</h3><div id='server-entities' style='display:flex;flex-direction:column;gap:4px'></div></div></div><div style='margin-top:8px'><div style='display:flex;justify-content:space-between;align-items:center;margin-bottom:16px'><h3 style='font-family:Space Grotesk,sans-serif;font-size:14px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:rgba(226,226,226,0.4);margin:0'>Audit Trail</h3><div style='display:flex;gap:8px;align-items:center'><button id='verify-chain-btn' onclick='this.dataset.clicked=1' style='font-size:10px;color:#d277ff;background:none;border:1px solid rgba(210,119,255,0.2);border-radius:4px;padding:4px 12px;cursor:pointer;font-family:Space Grotesk,sans-serif;text-transform:uppercase;letter-spacing:0.1em;font-weight:700'>Verify Chain</button><span id='verify-result' style='font-size:11px;font-family:Space Grotesk,sans-serif;display:none'></span><span style='display:flex;align-items:center;gap:6px;font-size:10px;color:#81ecff;font-family:Space Grotesk,sans-serif;text-transform:uppercase;letter-spacing:0.1em'><span style='width:6px;height:6px;border-radius:50%;background:#81ecff;animation:pulse 2s infinite'></span>Live</span></div></div><div id='audit-trail' style='background:#0e0e0e;border:1px solid rgba(255,255,255,0.03);border-radius:8px;font-family:monospace;font-size:11px;max-height:400px;overflow-y:auto'></div></div></div><style>@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.5}}</style><script>!function(){var tk=localStorage.getItem('token');var h=tk?{'Authorization':'Bearer '+tk}:{};function loadStats(){fetch('/api/server/stats',{headers:h}).then(function(r){return r.json()}).then(function(d){var s=document.getElementById('server-stats');if(!s)return;var b=d.brain||{};var total=b.total_events||0;var top=b.top_endpoints||[];var topStr=top.length>0?top[0].endpoint:'—';var topCount=top.length>0?top[0].count:0;s.innerHTML='<div style=\"background:#1b1b1b;border:0.5px solid rgba(76,69,70,0.15);border-radius:12px;padding:20px 24px\"><div style=\"font-size:13px;color:rgba(226,226,226,0.5);margin-bottom:8px\">Total Requests</div><span style=\"font-size:32px;font-weight:700;color:#e2e2e2\">'+total+'</span></div><div style=\"background:#1b1b1b;border:0.5px solid rgba(76,69,70,0.15);border-radius:12px;padding:20px 24px\"><div style=\"font-size:13px;color:rgba(226,226,226,0.5);margin-bottom:8px\">Top Endpoint</div><span style=\"font-size:14px;font-weight:600;color:#87adff;font-family:monospace\">'+topStr+'</span><div style=\"font-size:11px;color:rgba(226,226,226,0.3);margin-top:4px\">'+topCount+' hits</div></div><div style=\"background:#1b1b1b;border:0.5px solid rgba(76,69,70,0.15);border-radius:12px;padding:20px 24px\"><div style=\"font-size:13px;color:rgba(226,226,226,0.5);margin-bottom:8px\">Pages</div><span style=\"font-size:32px;font-weight:700;color:#e2e2e2\">'+(d.pages||0)+'</span></div><div style=\"background:#1b1b1b;border:0.5px solid rgba(76,69,70,0.15);border-radius:12px;padding:20px 24px\"><div style=\"font-size:13px;color:rgba(226,226,226,0.5);margin-bottom:8px\">API Groups</div><span style=\"font-size:32px;font-weight:700;color:#e2e2e2\">'+(d.apis||0)+'</span></div>';var ins=document.getElementById('server-insights');if(ins){var sug=b.suggestions||[];ins.innerHTML=sug.map(function(s){var ico=s.indexOf('Hot')===0?'local_fire_department':s.indexOf('Cold')===0?'ac_unit':s.indexOf('Error')===0?'error':s.indexOf('Slow')===0?'speed':'lightbulb';var clr=s.indexOf('Error')===0?'#ef4444':s.indexOf('Slow')===0?'#f59e0b':'#87adff';return '<div style=\"background:rgba(25,25,25,0.8);border-radius:8px;padding:12px 16px;border-left:2px solid '+clr+';display:flex;gap:10px;align-items:flex-start\"><span class=\"material-symbols-outlined\" style=\"font-size:16px;color:'+clr+'\">'+ico+'</span><span style=\"font-size:12px;color:#ababab;line-height:1.4\">'+s+'</span></div>'}).join('')}var ent=document.getElementById('server-entities');if(ent){ent.innerHTML=(d.entities||[]).map(function(e){return '<div style=\"display:flex;justify-content:space-between;padding:8px 12px;background:#1b1b1b;border-radius:6px\"><span style=\"font-size:12px;color:#e2e2e2\">'+e.entity+'</span><span style=\"font-size:12px;color:#87adff;font-family:monospace\">'+e.count+' rows</span></div>'}).join('')}}).catch(function(){})}function loadLogs(){fetch('/api/server/logs?limit=50',{headers:h}).then(function(r){return r.json()}).then(function(data){var el=document.getElementById('server-logs');if(!el||!Array.isArray(data))return;if(!data.length){el.innerHTML='<div style=\"padding:24px;text-align:center;color:rgba(226,226,226,0.3)\">No logs yet</div>';return}el.innerHTML=data.map(function(log){var meta={};try{meta=JSON.parse(log.metadata||'{}')}catch(e){}var method=meta.method||'';var path=meta.path||log.event||'';var status=meta.status||'';var dur=meta.duration_ms||'';var ts=log.timestamp||(log.created_at||'').split('T').pop()||'';var sColor=status>=500?'#ef4444':status>=400?'#f59e0b':status>=300?'#87adff':'#10b981';var mColor=method==='GET'?'#10b981':method==='POST'?'#87adff':method==='DELETE'?'#ef4444':'#f59e0b';return '<div style=\"display:flex;align-items:center;gap:12px;padding:8px 16px;border-bottom:1px solid rgba(255,255,255,0.02)\"><span style=\"font-size:10px;color:#484848;min-width:60px\">'+ts.slice(0,8)+'</span><span style=\"font-size:10px;font-weight:700;color:'+mColor+';min-width:45px\">'+method+'</span><span style=\"font-size:11px;color:#e2e2e2;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap\">'+path+'</span><span style=\"font-size:10px;font-weight:700;color:'+sColor+';min-width:30px;text-align:right\">'+status+'</span><span style=\"font-size:10px;color:#484848;min-width:45px;text-align:right\">'+(dur?dur+'ms':'')+'</span></div>'}).join('')}).catch(function(){})}function loadAudit(){fetch('/api/audit/trail?limit=20',{headers:h}).then(function(r){return r.json()}).then(function(data){var el=document.getElementById('audit-trail');if(!el)return;if(!data||!data.entries||!data.entries.length){el.innerHTML='<div style=\"padding:24px;text-align:center;color:rgba(226,226,226,0.3)\">No audit entries yet</div>';return}el.innerHTML=data.entries.map(function(e){var aClr=e.action==='INSERT'?'#10b981':e.action==='UPDATE'?'#f59e0b':e.action==='DELETE'?'#ef4444':'#ababab';var ts=(e.timestamp||e.created_at||'').split('T').pop()||'';ts=ts.slice(0,8);var verified=e.hash_valid!==false;var badge=verified?'<span style=\"color:#10b981\">\\u2713 hash verified</span>':'<span style=\"color:#ef4444\">\\u2717 hash broken</span>';return '<div style=\"display:flex;align-items:center;gap:12px;padding:8px 16px;border-bottom:1px solid rgba(255,255,255,0.02)\"><span style=\"font-size:10px;color:#484848;min-width:60px\">'+ts+'</span><span style=\"font-size:10px;font-weight:700;color:'+aClr+';min-width:55px\">'+e.action+'</span><span style=\"font-size:11px;color:#e2e2e2;min-width:100px\">'+(e.entity_type||'')+'</span><span style=\"font-size:10px;color:#87adff;font-family:monospace;min-width:80px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap\">'+(e.record_id||'').slice(0,12)+'</span><span style=\"font-size:10px;color:#484848;min-width:80px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap\">by '+(e.user_id||'system').slice(0,12)+'</span><span style=\"font-size:10px;margin-left:auto\">'+badge+'</span></div>'}).join('')}).catch(function(){var el=document.getElementById('audit-trail');if(el)el.innerHTML='<div style=\"padding:24px;text-align:center;color:rgba(226,226,226,0.3)\">Failed to load audit trail</div>'})}document.getElementById('verify-chain-btn').addEventListener('click',function(){var btn=this;var res=document.getElementById('verify-result');btn.disabled=true;btn.textContent='Verifying...';res.style.display='none';fetch('/api/audit/trail/verify',{headers:h}).then(function(r){return r.json()}).then(function(d){res.style.display='inline';if(d.valid){res.innerHTML='<span style=\"color:#10b981\">\\u2713 Chain Valid</span>';res.style.color='#10b981'}else{res.innerHTML='<span style=\"color:#ef4444\">\\u2717 Chain Broken</span> <span style=\"color:#484848\">'+(d.broken_at?'at entry '+d.broken_at:'')+'</span>';res.style.color='#ef4444'}btn.disabled=false;btn.textContent='VERIFY CHAIN'}).catch(function(){res.style.display='inline';res.innerHTML='<span style=\"color:#ef4444\">\\u2717 Error</span>';res.style.color='#ef4444';btn.disabled=false;btn.textContent='VERIFY CHAIN'})});loadStats();loadLogs();loadAudit();document.getElementById('log-refresh').addEventListener('click',function(){loadLogs();loadStats();loadAudit()});setInterval(function(){loadLogs();loadStats();loadAudit()},5000);}();</script>"
  }
}

page "/notifications" type:custom requires:auth {
  use NovaCoreChrome

  section page-header style:dark {
    eyebrow "Alerts"
    title "Notifications"
    subtitle "System alerts, deployment events and security warnings."
  }

  section hero {
    template "<div id='notif-list' style='display:flex;flex-direction:column;gap:8px'><div style='padding:48px;text-align:center'><span class='material-symbols-outlined' style='font-size:32px;color:rgba(226,226,226,0.15)'>notifications_none</span><p id='notif-loading-text' style='font-size:13px;color:rgba(226,226,226,0.3);margin:8px 0 0'>Loading...</p></div></div><script>!function(){var tk=localStorage.getItem('token');if(!tk)return;fetch('/api/notifications?limit=50',{headers:{'Authorization':'Bearer '+tk}}).then(function(r){return r.json()}).then(function(data){var el=document.getElementById('notif-list');if(!el||!Array.isArray(data))return;if(!data.length){el.innerHTML='<div style=\"padding:48px;text-align:center\"><span class=\"material-symbols-outlined\" style=\"font-size:32px;color:rgba(226,226,226,0.15)\">notifications_none</span><p style=\"font-size:13px;color:rgba(226,226,226,0.3);margin:8px 0 0\">No notifications yet</p></div>';return}var html='<div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:16px\"><span style=\"font-size:12px;color:rgba(226,226,226,0.4)\">'+data.length+' notification'+(data.length!==1?'s':'')+'</span><button id=\"mark-all-read\" onclick=\"this.dataset.clicked=1\" style=\"font-size:11px;color:#87adff;background:none;border:none;cursor:pointer;font-family:Space Grotesk,sans-serif;text-transform:uppercase;letter-spacing:0.1em;font-weight:700\">Mark all read</button></div>';data.forEach(function(n){var ico=n.type===\"error\"?\"error\":n.type===\"warning\"?\"warning\":n.type===\"success\"?\"check_circle\":\"info\";var clr=n.type===\"error\"?\"#ef4444\":n.type===\"warning\"?\"#f59e0b\":n.type===\"success\"?\"#10b981\":\"#87adff\";var bg=(!n.read||n.read===\"false\")?\"#1b1b1b\":\"#131313\";var brd=(!n.read||n.read===\"false\")?\"border-left:2px solid \"+clr:\"border-left:2px solid transparent\";html+='<div style=\"background:'+bg+';'+brd+';border-radius:8px;padding:16px 20px;display:flex;gap:12px;align-items:flex-start;transition:background 0.15s\" onmouseover=\"this.style.background=\\'#1f1f1f\\'\" onmouseout=\"this.style.background=\\''+bg+'\\'\">';html+='<span class=\"material-symbols-outlined\" style=\"color:'+clr+';font-size:20px;margin-top:2px\">'+ico+'</span>';html+='<div style=\"flex:1\"><p style=\"font-size:14px;color:#e2e2e2;margin:0;font-weight:500\">'+n.title+'</p>';if(n.message)html+='<p style=\"font-size:12px;color:rgba(226,226,226,0.4);margin:4px 0 0\">'+n.message+'</p>';html+='<p style=\"font-size:10px;color:rgba(226,226,226,0.2);margin:6px 0 0\">'+new Date(n.created_at).toLocaleString()+'</p>';html+='</div></div>'});el.innerHTML=html;var markBtn=document.getElementById('mark-all-read');if(markBtn)markBtn.addEventListener('click',function(){data.forEach(function(n){if(!n.read||n.read==='false'){fetch('/api/notifications/'+n.id,{method:'PATCH',headers:{'Content-Type':'application/json','Authorization':'Bearer '+tk},body:JSON.stringify({read:'true'})})}});markBtn.textContent='Done';setTimeout(function(){if(window.CRONUS)window.CRONUS.reload()},500)})}).catch(function(){var el=document.getElementById('notif-list');if(el)el.innerHTML='<div style=\"padding:48px;text-align:center\"><p style=\"font-size:13px;color:rgba(226,226,226,0.3)\">Failed to load</p></div>'});}();</script>"
  }
}

page "/settings" type:custom requires:auth {
  use NovaCoreChrome

  section page-header style:dark {
    eyebrow "Account"
    title "Settings"
    subtitle "Manage your profile, preferences and security."
  }

  section hero {
    template "<div style='display:flex;flex-direction:column;gap:24px'><div style='background:#1b1b1b;border:0.5px solid rgba(76,69,70,0.15);border-radius:12px;padding:32px'><h3 style='font-family:Space Grotesk,sans-serif;font-size:14px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:rgba(226,226,226,0.4);margin:0 0 24px'>Profile</h3><div style='display:flex;align-items:center;gap:20px;margin-bottom:32px'><div id='settings-avatar' style='width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,#87adff,#d277ff);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:700;color:#fff;flex-shrink:0'>?</div><div><p id='settings-name' style='font-size:18px;font-weight:600;color:#e2e2e2;margin:0'>...</p><p id='settings-email' style='font-size:13px;color:rgba(226,226,226,0.4);margin:4px 0 0'>...</p></div></div><form id='profile-form' style='display:flex;flex-direction:column;gap:20px'><div style='display:grid;grid-template-columns:1fr 1fr;gap:16px'><div><label style='display:block;font-size:10px;font-family:Space Grotesk,sans-serif;letter-spacing:0.15em;text-transform:uppercase;color:#ababab;margin:0 0 6px 4px'>Name</label><input type='text' name='name' id='input-name' style='width:100%;background:#000;border:1px solid rgba(255,255,255,0.05);border-radius:8px;padding:12px 16px;color:#fff;font-size:14px;outline:none;box-sizing:border-box' onfocus=\"this.style.borderColor='rgba(135,173,255,0.3)'\" onblur=\"this.style.borderColor='rgba(255,255,255,0.05)'\"></div><div><label style='display:block;font-size:10px;font-family:Space Grotesk,sans-serif;letter-spacing:0.15em;text-transform:uppercase;color:#ababab;margin:0 0 6px 4px'>Email</label><input type='email' name='email' id='input-email' disabled style='width:100%;background:#000;border:1px solid rgba(255,255,255,0.05);border-radius:8px;padding:12px 16px;color:rgba(255,255,255,0.4);font-size:14px;outline:none;box-sizing:border-box;cursor:not-allowed'></div></div><div><label style='display:block;font-size:10px;font-family:Space Grotesk,sans-serif;letter-spacing:0.15em;text-transform:uppercase;color:#ababab;margin:0 0 6px 4px'>Role</label><input type='text' id='input-role' disabled style='width:100%;background:#000;border:1px solid rgba(255,255,255,0.05);border-radius:8px;padding:12px 16px;color:rgba(255,255,255,0.4);font-size:14px;outline:none;box-sizing:border-box;cursor:not-allowed'></div><div style='display:flex;justify-content:flex-end;gap:12px;margin-top:8px'><button type='submit' id='save-btn' style='padding:10px 24px;border:none;border-radius:8px;background:linear-gradient(135deg,#87adff,#d277ff);color:#000;font-family:Space Grotesk,sans-serif;font-size:12px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;cursor:pointer;transition:filter 0.15s' onmouseover=\"this.style.filter='brightness(1.1)'\" onmouseout=\"this.style.filter='none'\">Save Changes</button></div></form><div id='profile-msg' style='display:none;margin-top:16px;padding:10px 14px;border-radius:8px;font-size:12px;text-align:center'></div></div><div style='background:#1b1b1b;border:0.5px solid rgba(76,69,70,0.15);border-radius:12px;padding:32px'><h3 style='font-family:Space Grotesk,sans-serif;font-size:14px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:rgba(226,226,226,0.4);margin:0 0 24px'>Security</h3><div style='display:flex;flex-direction:column;gap:16px'><div style='display:flex;justify-content:space-between;align-items:center;padding:16px 0;border-bottom:1px solid rgba(76,69,70,0.1)'><div><p style='font-size:14px;color:#e2e2e2;margin:0;font-weight:500'>Change Password</p><p style='font-size:12px;color:rgba(226,226,226,0.3);margin:4px 0 0'>Update your authentication passphrase</p></div><span class='material-symbols-outlined' style='color:rgba(226,226,226,0.3)'>chevron_right</span></div><div style='display:flex;justify-content:space-between;align-items:center;padding:16px 0;border-bottom:1px solid rgba(76,69,70,0.1)'><div><p style='font-size:14px;color:#e2e2e2;margin:0;font-weight:500'>Active Sessions</p><p style='font-size:12px;color:rgba(226,226,226,0.3);margin:4px 0 0'>Manage your active sessions</p></div><span class='material-symbols-outlined' style='color:rgba(226,226,226,0.3)'>chevron_right</span></div><div style='display:flex;justify-content:space-between;align-items:center;padding:16px 0'><div><p style='font-size:14px;color:#ef4444;margin:0;font-weight:500'>Delete Account</p><p style='font-size:12px;color:rgba(226,226,226,0.3);margin:4px 0 0'>Permanently remove your account and data</p></div><span class='material-symbols-outlined' style='color:rgba(226,226,226,0.3)'>chevron_right</span></div></div></div></div><script>!function(){var u=JSON.parse(localStorage.getItem('user')||'{}');var n=u.name||'';var e=u.email||'';var r=u.role||'operator';document.getElementById('settings-name').textContent=n;document.getElementById('settings-email').textContent=e;var av=document.getElementById('settings-avatar');if(av&&n)av.textContent=n.split(' ').map(function(w){return w[0]}).join('').toUpperCase().slice(0,2);document.getElementById('input-name').value=n;document.getElementById('input-email').value=e;document.getElementById('input-role').value=r.charAt(0).toUpperCase()+r.slice(1);document.getElementById('profile-form').addEventListener('submit',async function(ev){ev.preventDefault();var btn=document.getElementById('save-btn');var msg=document.getElementById('profile-msg');var newName=document.getElementById('input-name').value;btn.disabled=true;btn.textContent='Saving...';try{var t=localStorage.getItem('token');var res=await fetch('/api/auth/me',{headers:{'Authorization':'Bearer '+t}});var me=await res.json();var r2=await fetch('/api/users/'+me.id,{method:'PATCH',headers:{'Content-Type':'application/json','Authorization':'Bearer '+t},body:JSON.stringify({name:newName})});if(r2.ok){var updated=await r2.json();u.name=newName;localStorage.setItem('user',JSON.stringify(u));document.getElementById('settings-name').textContent=newName;var av2=document.getElementById('settings-avatar');if(av2)av2.textContent=newName.split(' ').map(function(w){return w[0]}).join('').toUpperCase().slice(0,2);msg.style.display='block';msg.style.background='rgba(16,185,129,0.1)';msg.style.color='#10b981';msg.style.border='1px solid rgba(16,185,129,0.2)';msg.textContent='Profile updated';setTimeout(function(){msg.style.display='none'},3000)}else{msg.style.display='block';msg.style.background='rgba(239,68,68,0.1)';msg.style.color='#ef4444';msg.textContent='Failed to update'}}catch(err){msg.style.display='block';msg.style.background='rgba(239,68,68,0.1)';msg.style.color='#ef4444';msg.textContent='Connection error'}btn.disabled=false;btn.textContent='Save Changes'});}();</script>"
  }
}

page "/login" type:custom {
  section hero {
    template "<div style='min-height:100vh;display:flex;align-items:center;justify-content:center;background:#0e0e0e;position:relative;overflow:hidden;font-family:Inter,sans-serif'><div style='position:fixed;inset:0;pointer-events:none'><div style='position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:800px;height:800px;background:rgba(135,173,255,0.04);border-radius:50%;filter:blur(120px)'></div><div style='position:absolute;top:20%;right:10%;width:400px;height:400px;background:rgba(210,119,255,0.04);border-radius:50%;filter:blur(100px)'></div><div style='position:absolute;bottom:-100px;left:-100px;width:400px;height:400px;background:rgba(210,119,255,0.06);border-radius:50%;filter:blur(120px)'></div></div><div style='position:relative;z-index:10;width:100%;max-width:440px;padding:0 24px'><div style='background:rgba(25,25,25,0.7);backdrop-filter:blur(40px);-webkit-backdrop-filter:blur(40px);border-radius:12px;padding:40px;box-shadow:0 0 60px rgba(135,173,255,0.04);border-top:0.5px solid rgba(135,173,255,0.2);border-left:0.5px solid rgba(135,173,255,0.1)'><div style='text-align:center;margin-bottom:32px'><h1 style='font-family:Space Grotesk,sans-serif;font-size:32px;font-weight:700;letter-spacing:-0.02em;color:#fff;margin:0 0 8px;text-shadow:0 0 20px rgba(135,173,255,0.3)'>Secure Access</h1><p style='font-size:11px;font-family:Space Grotesk,sans-serif;letter-spacing:0.15em;text-transform:uppercase;color:#ababab;margin:0'>Enter the operational command center</p></div><form id='login-form' style='display:flex;flex-direction:column;gap:20px'><div><label style='display:block;font-size:10px;font-family:Space Grotesk,sans-serif;letter-spacing:0.15em;text-transform:uppercase;color:#ababab;margin:0 0 6px 4px'>Identity Token</label><input type='email' name='email' placeholder='operator@nova-core.io' required style='width:100%;background:#000;border:1px solid rgba(255,255,255,0.05);border-radius:8px;padding:14px 18px;color:#fff;font-size:14px;outline:none;transition:all 0.3s;box-sizing:border-box' onfocus=\"this.style.borderColor='rgba(135,173,255,0.3)';this.style.boxShadow='0 0 4px rgba(135,173,255,0.2)'\" onblur=\"this.style.borderColor='rgba(255,255,255,0.05)';this.style.boxShadow='none'\"></div><div><div style='display:flex;justify-content:space-between;align-items:center;margin:0 0 6px 4px'><label style='font-size:10px;font-family:Space Grotesk,sans-serif;letter-spacing:0.15em;text-transform:uppercase;color:#ababab'>Passphrase</label></div><input type='password' name='password' placeholder='••••••••••••' required style='width:100%;background:#000;border:1px solid rgba(255,255,255,0.05);border-radius:8px;padding:14px 18px;color:#fff;font-size:14px;outline:none;transition:all 0.3s;box-sizing:border-box' onfocus=\"this.style.borderColor='rgba(135,173,255,0.3)';this.style.boxShadow='0 0 4px rgba(135,173,255,0.2)'\" onblur=\"this.style.borderColor='rgba(255,255,255,0.05)';this.style.boxShadow='none'\"></div><div id='login-msg' style='display:none;padding:10px 14px;border-radius:8px;font-size:12px;text-align:center'></div><button type='submit' id='login-btn' style='width:100%;padding:14px;border:none;border-radius:8px;background:linear-gradient(135deg,#87adff,#d277ff);color:#000;font-family:Space Grotesk,sans-serif;font-size:13px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;cursor:pointer;box-shadow:0 0 20px rgba(135,173,255,0.15);transition:all 0.15s;position:relative;overflow:hidden' onmouseover=\"this.style.filter='brightness(1.1)'\" onmouseout=\"this.style.filter='none'\">Initialize Portal</button></form><div style='display:flex;align-items:center;gap:16px;margin-top:24px'><div style='flex:1;height:1px;background:linear-gradient(to right,transparent,rgba(72,72,72,0.3),transparent)'></div><span style='font-size:9px;font-family:Space Grotesk,sans-serif;letter-spacing:0.2em;text-transform:uppercase;color:#555'>Or</span><div style='flex:1;height:1px;background:linear-gradient(to right,transparent,rgba(72,72,72,0.3),transparent)'></div></div><p style='text-align:center;margin-top:16px;font-size:13px;color:#ababab'>No account? <a href=\"/signup\" style='color:#87adff;text-decoration:none;font-weight:600'>Create Access</a></p></div><div style='text-align:center;margin-top:24px'><div style='display:flex;align-items:center;justify-content:center;gap:8px'><span style='width:6px;height:6px;border-radius:50%;background:#81ecff;box-shadow:0 0 8px #81ecff;animation:pulse 2s ease-in-out infinite'></span><span style='font-family:Space Grotesk,sans-serif;font-size:10px;letter-spacing:0.15em;text-transform:uppercase;color:#81ecff'>Live Uplink</span></div></div></div></div><script>document.getElementById('login-form').addEventListener('submit',async function(e){e.preventDefault();var btn=document.getElementById('login-btn');var msg=document.getElementById('login-msg');btn.disabled=true;btn.innerHTML='<span style=\"display:inline-block;width:16px;height:16px;border:2px solid rgba(0,0,0,0.2);border-top-color:#000;border-radius:50%;animation:spin 0.6s linear infinite\"></span>';msg.style.display='none';var data={};new FormData(this).forEach(function(v,k){data[k]=v});try{var r=await fetch('/api/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});var body=await r.json();if(r.ok&&body.token){localStorage.setItem('token',body.token);localStorage.setItem('user',JSON.stringify(body.user||{}));window.location.href='/'}else{msg.style.display='block';msg.style.background='rgba(239,68,68,0.1)';msg.style.color='#ef4444';msg.style.border='1px solid rgba(239,68,68,0.2)';msg.textContent=body.error||'Invalid credentials';btn.disabled=false;btn.textContent='Initialize Portal'}}catch(err){msg.style.display='block';msg.style.background='rgba(239,68,68,0.1)';msg.style.color='#ef4444';msg.textContent='Connection error';btn.disabled=false;btn.textContent='Initialize Portal'}});</script>"
  }
}

page "/signup" type:custom {
  section hero {
    template "<div style='min-height:100vh;display:flex;align-items:center;justify-content:center;background:#0e0e0e;position:relative;overflow:hidden;font-family:Inter,sans-serif'><div style='position:fixed;inset:0;pointer-events:none'><div style='position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:800px;height:800px;background:rgba(135,173,255,0.04);border-radius:50%;filter:blur(120px)'></div><div style='position:absolute;top:20%;right:10%;width:400px;height:400px;background:rgba(210,119,255,0.04);border-radius:50%;filter:blur(100px)'></div></div><div style='position:relative;z-index:10;width:100%;max-width:440px;padding:0 24px'><div style='background:rgba(25,25,25,0.7);backdrop-filter:blur(40px);-webkit-backdrop-filter:blur(40px);border-radius:12px;padding:40px;box-shadow:0 0 60px rgba(135,173,255,0.04);border-top:0.5px solid rgba(135,173,255,0.2);border-left:0.5px solid rgba(135,173,255,0.1)'><div style='text-align:center;margin-bottom:32px'><h1 style='font-family:Space Grotesk,sans-serif;font-size:32px;font-weight:700;letter-spacing:-0.02em;color:#fff;margin:0 0 8px;text-shadow:0 0 20px rgba(135,173,255,0.3)'>Create Access</h1><p style='font-size:11px;font-family:Space Grotesk,sans-serif;letter-spacing:0.15em;text-transform:uppercase;color:#ababab;margin:0'>Join the operational network</p></div><form id='signup-form' style='display:flex;flex-direction:column;gap:20px'><div><label style='display:block;font-size:10px;font-family:Space Grotesk,sans-serif;letter-spacing:0.15em;text-transform:uppercase;color:#ababab;margin:0 0 6px 4px'>Operator Name</label><input type='text' name='name' placeholder='Your name' required style='width:100%;background:#000;border:1px solid rgba(255,255,255,0.05);border-radius:8px;padding:14px 18px;color:#fff;font-size:14px;outline:none;transition:all 0.3s;box-sizing:border-box' onfocus=\"this.style.borderColor='rgba(135,173,255,0.3)'\" onblur=\"this.style.borderColor='rgba(255,255,255,0.05)'\"></div><div><label style='display:block;font-size:10px;font-family:Space Grotesk,sans-serif;letter-spacing:0.15em;text-transform:uppercase;color:#ababab;margin:0 0 6px 4px'>Identity Token</label><input type='email' name='email' placeholder='operator@nova-core.io' required style='width:100%;background:#000;border:1px solid rgba(255,255,255,0.05);border-radius:8px;padding:14px 18px;color:#fff;font-size:14px;outline:none;transition:all 0.3s;box-sizing:border-box' onfocus=\"this.style.borderColor='rgba(135,173,255,0.3)'\" onblur=\"this.style.borderColor='rgba(255,255,255,0.05)'\"></div><div><label style='display:block;font-size:10px;font-family:Space Grotesk,sans-serif;letter-spacing:0.15em;text-transform:uppercase;color:#ababab;margin:0 0 6px 4px'>Passphrase</label><input type='password' name='password' placeholder='••••••••••••' required style='width:100%;background:#000;border:1px solid rgba(255,255,255,0.05);border-radius:8px;padding:14px 18px;color:#fff;font-size:14px;outline:none;transition:all 0.3s;box-sizing:border-box' onfocus=\"this.style.borderColor='rgba(135,173,255,0.3)'\" onblur=\"this.style.borderColor='rgba(255,255,255,0.05)'\"></div><div id='signup-msg' style='display:none;padding:10px 14px;border-radius:8px;font-size:12px;text-align:center'></div><button type='submit' id='signup-btn' style='width:100%;padding:14px;border:none;border-radius:8px;background:linear-gradient(135deg,#87adff,#d277ff);color:#000;font-family:Space Grotesk,sans-serif;font-size:13px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;cursor:pointer;box-shadow:0 0 20px rgba(135,173,255,0.15);transition:all 0.15s' onmouseover=\"this.style.filter='brightness(1.1)'\" onmouseout=\"this.style.filter='none'\">Initialize Access</button></form><p style='text-align:center;margin-top:20px;font-size:13px;color:#ababab'>Already have access? <a href=\"/login\" style='color:#87adff;text-decoration:none;font-weight:600'>Sign In</a></p></div><div style='text-align:center;margin-top:24px'><div style='display:flex;align-items:center;justify-content:center;gap:8px'><span style='width:6px;height:6px;border-radius:50%;background:#81ecff;box-shadow:0 0 8px #81ecff;animation:pulse 2s ease-in-out infinite'></span><span style='font-family:Space Grotesk,sans-serif;font-size:10px;letter-spacing:0.15em;text-transform:uppercase;color:#81ecff'>Live Uplink</span></div></div></div></div><script>document.getElementById('signup-form').addEventListener('submit',async function(e){e.preventDefault();var btn=document.getElementById('signup-btn');var msg=document.getElementById('signup-msg');btn.disabled=true;btn.innerHTML='<span style=\"display:inline-block;width:16px;height:16px;border:2px solid rgba(0,0,0,0.2);border-top-color:#000;border-radius:50%;animation:spin 0.6s linear infinite\"></span>';msg.style.display='none';var data={};new FormData(this).forEach(function(v,k){data[k]=v});try{var r=await fetch('/api/auth/signup',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});var body=await r.json();if(r.ok&&body.token){localStorage.setItem('token',body.token);localStorage.setItem('user',JSON.stringify(body.user||{}));window.location.href='/'}else{msg.style.display='block';msg.style.background='rgba(239,68,68,0.1)';msg.style.color='#ef4444';msg.style.border='1px solid rgba(239,68,68,0.2)';msg.textContent=body.error||'Registration failed';btn.disabled=false;btn.textContent='Initialize Access'}}catch(err){msg.style.display='block';msg.style.background='rgba(239,68,68,0.1)';msg.style.color='#ef4444';msg.textContent='Connection error';btn.disabled=false;btn.textContent='Initialize Access'}});</script>"
  }
}
