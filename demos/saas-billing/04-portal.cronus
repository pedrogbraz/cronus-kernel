    template "<div class=\"space-y-8\"><div class=\"glass-panel rounded-xl overflow-hidden\"><div class=\"border-b border-white/5 p-6\"><h3 class=\"font-bold text-lg text-white tracking-tight\">Profile</h3><p class=\"text-neutral-500 text-xs\">Your personal information</p></div><div class=\"p-6 space-y-6\"><div class=\"flex items-center gap-6 mb-2\"><div class=\"w-16 h-16 rounded-full bg-white/10 flex items-center justify-center\"><span class=\"text-white text-2xl font-bold\" id=\"settings-initial\">?</span></div><div><div class=\"text-white text-lg font-semibold\" id=\"settings-name\">User</div><div class=\"text-neutral-500 text-sm\" id=\"settings-email\">user@email.com</div><div class=\"text-neutral-600 text-xs mt-1\" id=\"settings-role\">Role: billing</div></div></div><div class=\"grid grid-cols-2 gap-6 mt-6\"><div><label class=\"text-neutral-400 text-xs uppercase tracking-widest block mb-2\">Full Name</label><input type=\"text\" id=\"input-name\" placeholder=\"Your name\" class=\"w-full\"></div><div><label class=\"text-neutral-400 text-xs uppercase tracking-widest block mb-2\">Email</label><input type=\"email\" id=\"input-email\" placeholder=\"your@email.com\" class=\"w-full\"></div></div><div class=\"flex justify-end pt-2\"><button class=\"bg-white text-black font-semibold text-sm px-6 py-2.5 rounded-full hover:bg-white/90 transition-colors\" onclick=\"alert('Profile update not implemented in demo')\">Save Changes</button></div></div></div><div class=\"glass-panel rounded-xl overflow-hidden\"><div class=\"border-b border-white/5 p-6\"><h3 class=\"font-bold text-lg text-white tracking-tight\">Security</h3><p class=\"text-neutral-500 text-xs\">Password and authentication</p></div><div class=\"p-6 space-y-6\"><div class=\"grid grid-cols-2 gap-6\"><div><label class=\"text-neutral-400 text-xs uppercase tracking-widest block mb-2\">Current Password</label><input type=\"password\" placeholder=\"••••••••\" class=\"w-full\"></div><div><label class=\"text-neutral-400 text-xs uppercase tracking-widest block mb-2\">New Password</label><input type=\"password\" placeholder=\"••••••••\" class=\"w-full\"></div></div><div class=\"flex justify-end pt-2\"><button class=\"bg-white text-black font-semibold text-sm px-6 py-2.5 rounded-full hover:bg-white/90 transition-colors\" onclick=\"alert('Password change not implemented in demo')\">Update Password</button></div></div></div><div class=\"glass-panel rounded-xl overflow-hidden\"><div class=\"border-b border-white/5 p-6\"><h3 class=\"font-bold text-lg text-white tracking-tight\">Notifications</h3><p class=\"text-neutral-500 text-xs\">How you receive updates</p></div><div class=\"p-6 space-y-4\"><div class=\"flex items-center justify-between py-3 border-b border-white/5\"><div><div class=\"text-white text-sm font-medium\">Invoice emails</div><div class=\"text-neutral-500 text-xs\">Receive a copy of each invoice</div></div><div class=\"w-10 h-6 bg-white rounded-full relative cursor-pointer\"><div class=\"w-4 h-4 bg-black rounded-full absolute top-1 right-1\"></div></div></div><div class=\"flex items-center justify-between py-3 border-b border-white/5\"><div><div class=\"text-white text-sm font-medium\">Usage alerts</div><div class=\"text-neutral-500 text-xs\">Notify when usage exceeds 80%</div></div><div class=\"w-10 h-6 bg-white rounded-full relative cursor-pointer\"><div class=\"w-4 h-4 bg-black rounded-full absolute top-1 right-1\"></div></div></div><div class=\"flex items-center justify-between py-3\"><div><div class=\"text-white text-sm font-medium\">Marketing emails</div><div class=\"text-neutral-500 text-xs\">Product updates and announcements</div></div><div class=\"w-10 h-6 bg-white/20 rounded-full relative cursor-pointer\"><div class=\"w-4 h-4 bg-white/60 rounded-full absolute top-1 left-1\"></div></div></div></div></div><div class=\"glass-panel rounded-xl overflow-hidden\"><div class=\"p-6 flex items-center justify-between\"><div><div class=\"text-white text-sm font-medium\">Sign Out</div><div class=\"text-neutral-500 text-xs\">End your current session</div></div><button class=\"bg-white/10 text-white border border-white/10 font-semibold text-sm px-6 py-2.5 rounded-full hover:bg-white/20 transition-colors flex items-center gap-2\" onclick=\"localStorage.removeItem('token');localStorage.removeItem('user');document.cookie='cronus_token=;Path=/;Max-Age=0';window.location.href='/login'\"><span class=\"material-symbols-outlined text-sm\">logout</span>Sign Out</button></div></div><div class=\"glass-panel rounded-xl overflow-hidden border-red-500/20\"><div class=\"border-b border-white/5 p-6\"><h3 class=\"font-bold text-lg text-red-400 tracking-tight\">Danger Zone</h3><p class=\"text-neutral-500 text-xs\">Irreversible actions</p></div><div class=\"p-6 flex items-center justify-between\"><div><div class=\"text-white text-sm font-medium\">Delete Account</div><div class=\"text-neutral-500 text-xs\">Permanently delete your account and all data</div></div><button class=\"bg-red-500/10 text-red-400 border border-red-500/20 font-semibold text-sm px-6 py-2.5 rounded-full hover:bg-red-500/20 transition-colors\" onclick=\"alert('Account deletion not implemented in demo')\">Delete Account</button></div></div></div><script>try{var u=JSON.parse(localStorage.getItem('user')||'{}');var sn=document.getElementById('settings-name');if(sn&&u.name)sn.textContent=u.name;var se=document.getElementById('settings-email');if(se&&u.email)se.textContent=u.email;var si=document.getElementById('settings-initial');if(si&&u.name)si.textContent=u.name.charAt(0).toUpperCase();var sr=document.getElementById('settings-role');if(sr&&u.role)sr.textContent='Role: '+u.role;var inp=document.getElementById('input-name');if(inp&&u.name)inp.value=u.name;var ine=document.getElementById('input-email');if(ine&&u.email)ine.value=u.email;}catch(e){}</script>"
  }
}
