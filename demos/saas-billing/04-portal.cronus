## Portal — User-facing billing dashboard

page "/" requires:auth type:custom {
  layout sidebar

  section sidebar {
    brand "NovaPay"
    subtitle "My Account"
    item "Overview" -> "/portal" icon:dashboard active:true
    item "Invoices" -> "/invoices" icon:receipt_long
    item "Subscription" -> "/subscription" icon:autorenew
    item "Payment Methods" -> "/billing" icon:credit_card
    item "Usage" -> "/usage" icon:analytics
    style_block "body { background-color: #000; background-image: radial-gradient(#ffffff08 1px, transparent 1px); background-size: 40px 40px; color: #fff; font-family: 'Inter', sans-serif; } .glass-panel { background: rgba(255,255,255,0.03); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.1); } .glass-panel:hover { background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.15); } #cronus-content th { color: rgba(255,255,255,0.4) !important; font-size: 10px !important; letter-spacing: 0.15em !important; text-transform: uppercase !important; } #cronus-content td { border-bottom: 1px solid rgba(255,255,255,0.05) !important; } #cronus-content tr:hover td { background: rgba(255,255,255,0.03) !important; } #cronus-content input { background: rgba(255,255,255,0.05) !important; border: 1px solid rgba(255,255,255,0.1) !important; border-radius: 8px !important; color: white !important; } #cronus-content [style*='border-radius'] { background: rgba(255,255,255,0.03) !important; backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.08) !important; }"
    template "<aside class=\"bg-[#131313] border-r border-white/5 fixed flex flex-col h-full left-0 p-4 pt-8 space-y-2 top-0 w-64 z-40\"><div class=\"mb-8 px-2\"><h2 class=\"font-black text-2xl text-white tracking-tighter\">NovaPay</h2><p class=\"text-neutral-500 text-xs tracking-widest uppercase\">My Account</p></div><nav class=\"flex flex-1 flex-col space-y-1\"><a href=\"/\" class=\"bg-white flex gap-3 items-center px-4 py-3 rounded-lg shadow-[0_0_15px_rgba(255,255,255,0.1)] text-black\"><span class=\"material-symbols-outlined\">dashboard</span><span class=\"font-bold text-sm\">Overview</span></a><a href=\"/invoices\" class=\"flex gap-3 hover:bg-white/5 hover:text-white items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span class=\"material-symbols-outlined\">receipt_long</span><span class=\"text-sm\">Invoices</span></a><a href=\"/subscription\" class=\"flex gap-3 hover:bg-white/5 hover:text-white items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span class=\"material-symbols-outlined\">autorenew</span><span class=\"text-sm\">Subscription</span></a><a href=\"/billing\" class=\"flex gap-3 hover:bg-white/5 hover:text-white items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span class=\"material-symbols-outlined\">credit_card</span><span class=\"text-sm\">Payment Methods</span></a><a href=\"/usage\" class=\"flex gap-3 hover:bg-white/5 hover:text-white items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span class=\"material-symbols-outlined\">analytics</span><span class=\"text-sm\">Usage</span></a></nav><a href=\"/settings\" class=\"border-t border-white/5 mt-auto pt-4 px-2 block hover:opacity-80 transition-opacity\"><div class=\"flex items-center gap-3\"><div class=\"w-8 h-8 rounded-full bg-white/10 flex items-center justify-center\"><span class=\"text-white/60 text-xs font-bold\" id=\"user-initial\">?</span></div><div><div class=\"text-white text-sm font-medium\" id=\"user-name\">User</div><div class=\"text-neutral-500 text-xs\">My Account</div></div></div></a></aside><script>try{var u=JSON.parse(localStorage.getItem('user')||'{}');if(u.name){var el=document.getElementById('user-name');if(el)el.textContent=u.name;var ini=document.getElementById('user-initial');if(ini)ini.textContent=u.name.charAt(0).toUpperCase();}}catch(e){}</script>"
  }

  section page-header {
    title "Billing"
    subtitle "Manage your subscription, usage, and payment methods."
    template "<header class=\"mb-12\"><h1 class=\"font-black leading-none mb-2 text-5xl text-white tracking-tighter\">{{title}}</h1><p class=\"font-light leading-relaxed max-w-2xl text-lg text-neutral-400\">{{subtitle}}</p></header>"
  }

  section stats {
    template "<div class=\"gap-6 grid grid-cols-1 md:grid-cols-2 mb-8\"><div class=\"glass-panel p-8 rounded-xl\"><div class=\"flex items-center justify-between mb-6\"><div><span class=\"bg-white/10 font-mono px-3 py-1 rounded-full text-white/60 text-[10px] tracking-widest uppercase\">Current Plan</span></div><button class=\"bg-white text-black font-semibold text-sm px-5 py-2 rounded-full hover:bg-white/90 transition-colors\">Change plan</button></div><h3 class=\"font-black text-3xl text-white tracking-tight mb-8\">Pro Plan</h3><div class=\"space-y-5\"><div class=\"flex justify-between items-end border-b border-white/5 pb-4\"><span class=\"text-neutral-400\">Price</span><span class=\"text-white font-semibold\">R$99 <span class=\"text-neutral-500 text-sm\">/month</span></span></div><div class=\"flex justify-between items-end border-b border-white/5 pb-4\"><span class=\"text-neutral-400\">Billing cycle</span><span class=\"text-white font-semibold\">Monthly</span></div><div class=\"flex justify-between items-end border-b border-white/5 pb-4\"><span class=\"text-neutral-400\">Next invoice</span><span class=\"text-white font-semibold\">May 7, 2026</span></div><div class=\"flex justify-between items-end\"><span class=\"text-neutral-400\">Status</span><span class=\"text-green-400 font-semibold\">Active</span></div></div></div><div class=\"glass-panel p-8 rounded-xl\"><h4 class=\"text-neutral-500 text-xs tracking-widest uppercase mb-8\">Usage this period</h4><div class=\"space-y-6\"><div><div class=\"flex justify-between mb-2\"><span class=\"text-neutral-400 text-sm\">API Calls</span><span class=\"text-white font-mono text-sm\">12,847 / 50,000</span></div><div class=\"bg-white/5 h-1.5 rounded-full overflow-hidden\"><div class=\"bg-white h-full rounded-full\" style=\"width:25.7%\"></div></div></div><div><div class=\"flex justify-between mb-2\"><span class=\"text-neutral-400 text-sm\">Storage</span><span class=\"text-white font-mono text-sm\">3.2 GB / 10 GB</span></div><div class=\"bg-white/5 h-1.5 rounded-full overflow-hidden\"><div class=\"bg-white h-full rounded-full\" style=\"width:32%\"></div></div></div><div><div class=\"flex justify-between mb-2\"><span class=\"text-neutral-400 text-sm\">Team Members</span><span class=\"text-white font-mono text-sm\">4 / 10</span></div><div class=\"bg-white/5 h-1.5 rounded-full overflow-hidden\"><div class=\"bg-white h-full rounded-full\" style=\"width:40%\"></div></div></div></div></div></div>"
  }

  section stats {
    template "<div class=\"gap-6 grid grid-cols-1 md:grid-cols-4 mb-8\"><div class=\"glass-panel p-6 rounded-xl\"><div class=\"mb-3 text-neutral-500 text-xs tracking-widest uppercase\">Total Spent</div><div class=\"flex items-baseline justify-between\"><span class=\"font-black text-3xl text-white\">R$594</span><span class=\"material-symbols-outlined text-white/15 text-3xl\">payments</span></div></div><div class=\"glass-panel p-6 rounded-xl\"><div class=\"mb-3 text-neutral-500 text-xs tracking-widest uppercase\">Invoices Paid</div><div class=\"flex items-baseline justify-between\"><span class=\"font-black text-3xl text-white\">6</span><span class=\"material-symbols-outlined text-white/15 text-3xl\">check_circle</span></div></div><div class=\"glass-panel p-6 rounded-xl\"><div class=\"mb-3 text-neutral-500 text-xs tracking-widest uppercase\">Payment Method</div><div class=\"flex items-baseline justify-between\"><span class=\"font-black text-xl text-white\">Visa •••• 4242</span><span class=\"material-symbols-outlined text-white/15 text-3xl\">credit_card</span></div></div><div class=\"glass-panel p-6 rounded-xl\"><div class=\"mb-3 text-neutral-500 text-xs tracking-widest uppercase\">Member Since</div><div class=\"flex items-baseline justify-between\"><span class=\"font-black text-3xl text-white\">Nov 2025</span><span class=\"material-symbols-outlined text-white/15 text-3xl\">calendar_today</span></div></div></div>"
  }

  section stats {
    template "<div class=\"gap-4 grid grid-cols-2 md:grid-cols-4 mb-8\"><a href=\"/subscription\" class=\"glass-panel p-5 rounded-xl flex items-center gap-3 hover:bg-white/[0.06] transition-colors group cursor-pointer\"><div class=\"w-10 h-10 rounded-lg bg-white/10 flex items-center justify-center group-hover:bg-white/15 transition-colors\"><span class=\"material-symbols-outlined text-white/60\">upgrade</span></div><div><div class=\"text-white text-sm font-medium\">Upgrade Plan</div><div class=\"text-neutral-500 text-xs\">See all plans</div></div></a><a href=\"/billing\" class=\"glass-panel p-5 rounded-xl flex items-center gap-3 hover:bg-white/[0.06] transition-colors group cursor-pointer\"><div class=\"w-10 h-10 rounded-lg bg-white/10 flex items-center justify-center group-hover:bg-white/15 transition-colors\"><span class=\"material-symbols-outlined text-white/60\">credit_card</span></div><div><div class=\"text-white text-sm font-medium\">Add Card</div><div class=\"text-neutral-500 text-xs\">Payment methods</div></div></a><a href=\"/invoices\" class=\"glass-panel p-5 rounded-xl flex items-center gap-3 hover:bg-white/[0.06] transition-colors group cursor-pointer\"><div class=\"w-10 h-10 rounded-lg bg-white/10 flex items-center justify-center group-hover:bg-white/15 transition-colors\"><span class=\"material-symbols-outlined text-white/60\">download</span></div><div><div class=\"text-white text-sm font-medium\">Download Invoice</div><div class=\"text-neutral-500 text-xs\">Latest receipt</div></div></a><a href=\"/settings\" class=\"glass-panel p-5 rounded-xl flex items-center gap-3 hover:bg-white/[0.06] transition-colors group cursor-pointer\"><div class=\"w-10 h-10 rounded-lg bg-white/10 flex items-center justify-center group-hover:bg-white/15 transition-colors\"><span class=\"material-symbols-outlined text-white/60\">settings</span></div><div><div class=\"text-white text-sm font-medium\">Settings</div><div class=\"text-neutral-500 text-xs\">Account prefs</div></div></a></div>"
  }

  section stats {
    template "<div class=\"glass-panel rounded-xl overflow-hidden mb-8\"><div class=\"border-b border-white/5 p-6\"><h3 class=\"font-bold text-lg text-white tracking-tight\">Recent Activity</h3><p class=\"text-neutral-500 text-xs\">Your account timeline</p></div><div class=\"p-6\"><div class=\"relative pl-6 space-y-6 before:absolute before:left-[7px] before:top-2 before:bottom-2 before:w-[2px] before:bg-white/5\"><div class=\"relative\"><div class=\"absolute -left-6 top-1 w-3.5 h-3.5 rounded-full bg-green-500 border-2 border-black\"></div><div class=\"flex items-center justify-between\"><div><div class=\"text-white text-sm font-medium\">Payment successful</div><div class=\"text-neutral-500 text-xs\">Invoice INV-006 — R$99.00</div></div><span class=\"text-neutral-600 text-xs\">Apr 7</span></div></div><div class=\"relative\"><div class=\"absolute -left-6 top-1 w-3.5 h-3.5 rounded-full bg-blue-500 border-2 border-black\"></div><div class=\"flex items-center justify-between\"><div><div class=\"text-white text-sm font-medium\">Plan renewed</div><div class=\"text-neutral-500 text-xs\">Pro Plan — monthly billing cycle</div></div><span class=\"text-neutral-600 text-xs\">Apr 7</span></div></div><div class=\"relative\"><div class=\"absolute -left-6 top-1 w-3.5 h-3.5 rounded-full bg-white/20 border-2 border-black\"></div><div class=\"flex items-center justify-between\"><div><div class=\"text-white text-sm font-medium\">API key created</div><div class=\"text-neutral-500 text-xs\">Production key ending in ...x4f2</div></div><span class=\"text-neutral-600 text-xs\">Mar 28</span></div></div><div class=\"relative\"><div class=\"absolute -left-6 top-1 w-3.5 h-3.5 rounded-full bg-green-500 border-2 border-black\"></div><div class=\"flex items-center justify-between\"><div><div class=\"text-white text-sm font-medium\">Payment successful</div><div class=\"text-neutral-500 text-xs\">Invoice INV-005 — R$99.00</div></div><span class=\"text-neutral-600 text-xs\">Mar 7</span></div></div><div class=\"relative\"><div class=\"absolute -left-6 top-1 w-3.5 h-3.5 rounded-full bg-yellow-500 border-2 border-black\"></div><div class=\"flex items-center justify-between\"><div><div class=\"text-white text-sm font-medium\">Team member added</div><div class=\"text-neutral-500 text-xs\">joao@novapay.com joined as viewer</div></div><span class=\"text-neutral-600 text-xs\">Feb 20</span></div></div></div></div></div>"
  }

  section stats {
    template "<div class=\"gap-6 grid grid-cols-1 lg:grid-cols-3\"><div class=\"glass-panel lg:col-span-2 rounded-xl overflow-hidden\"><div class=\"border-b border-white/5 flex items-center justify-between p-6\"><div><h3 class=\"font-bold text-lg text-white tracking-tight\">Payment Methods</h3><p class=\"text-neutral-500 text-xs\">Your saved payment methods</p></div><button class=\"bg-white/10 hover:bg-white/15 text-white text-sm px-4 py-2 rounded-lg transition-colors\">+ Add</button></div><div class=\"p-6 space-y-4\"><div class=\"flex items-center justify-between p-4 rounded-lg bg-white/[0.02] border border-white/5\"><div class=\"flex items-center gap-4\"><div class=\"w-12 h-8 bg-white/10 rounded flex items-center justify-center text-white text-xs font-bold\">VISA</div><div><div class=\"text-white text-sm font-medium\">Visa ending in 4242</div><div class=\"text-neutral-500 text-xs\">Expires 12/27</div></div></div><span class=\"bg-white/10 text-white/60 text-[10px] font-bold tracking-widest uppercase px-2 py-0.5 rounded\">Default</span></div><div class=\"flex items-center justify-between p-4 rounded-lg bg-white/[0.02] border border-white/5\"><div class=\"flex items-center gap-4\"><div class=\"w-12 h-8 bg-white/10 rounded flex items-center justify-center text-white text-xs font-bold\">PIX</div><div><div class=\"text-white text-sm font-medium\">Pix</div><div class=\"text-neutral-500 text-xs\">zedd@email.com</div></div></div><span class=\"text-neutral-600 text-xs\"></span></div></div></div><div class=\"glass-panel rounded-xl\"><div class=\"border-b border-white/5 p-6\"><h3 class=\"font-bold text-lg text-white tracking-tight\">Recent Invoices</h3><p class=\"text-neutral-500 text-xs\">Last 4 invoices</p></div><div class=\"p-6 space-y-4\"><div class=\"flex items-center justify-between\"><div><div class=\"text-white text-sm font-medium\">INV-006</div><div class=\"text-neutral-500 text-xs\">Apr 7</div></div><div class=\"text-right\"><div class=\"text-white text-sm font-mono\">R$99.00</div><span class=\"text-green-400 text-[10px] font-bold tracking-widest uppercase\">Paid</span></div></div><div class=\"flex items-center justify-between\"><div><div class=\"text-white text-sm font-medium\">INV-005</div><div class=\"text-neutral-500 text-xs\">Mar 7</div></div><div class=\"text-right\"><div class=\"text-white text-sm font-mono\">R$99.00</div><span class=\"text-green-400 text-[10px] font-bold tracking-widest uppercase\">Paid</span></div></div><div class=\"flex items-center justify-between\"><div><div class=\"text-white text-sm font-medium\">INV-004</div><div class=\"text-neutral-500 text-xs\">Feb 7</div></div><div class=\"text-right\"><div class=\"text-white text-sm font-mono\">R$99.00</div><span class=\"text-green-400 text-[10px] font-bold tracking-widest uppercase\">Paid</span></div></div><div class=\"flex items-center justify-between\"><div><div class=\"text-white text-sm font-medium\">INV-003</div><div class=\"text-neutral-500 text-xs\">Jan 7</div></div><div class=\"text-right\"><div class=\"text-white text-sm font-mono\">R$99.00</div><span class=\"text-green-400 text-[10px] font-bold tracking-widest uppercase\">Paid</span></div></div></div></div></div>"
  }
}

page "/invoices" requires:auth type:custom {
  layout sidebar

  section sidebar {
    brand "NovaPay"
    subtitle "My Account"
    item "Overview" -> "/portal" icon:dashboard
    item "Invoices" -> "/invoices" icon:receipt_long active:true
    item "Subscription" -> "/subscription" icon:autorenew
    item "Payment Methods" -> "/billing" icon:credit_card
    item "Usage" -> "/usage" icon:analytics
    style_block "body { background-color: #000; background-image: radial-gradient(#ffffff08 1px, transparent 1px); background-size: 40px 40px; color: #fff; font-family: 'Inter', sans-serif; } .glass-panel { background: rgba(255,255,255,0.03); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.1); } .glass-panel:hover { background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.15); } #cronus-content th { color: rgba(255,255,255,0.4) !important; font-size: 10px !important; letter-spacing: 0.15em !important; text-transform: uppercase !important; } #cronus-content td { border-bottom: 1px solid rgba(255,255,255,0.05) !important; } #cronus-content tr:hover td { background: rgba(255,255,255,0.03) !important; } #cronus-content input { background: rgba(255,255,255,0.05) !important; border: 1px solid rgba(255,255,255,0.1) !important; border-radius: 8px !important; color: white !important; } #cronus-content [style*='border-radius'] { background: rgba(255,255,255,0.03) !important; backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.08) !important; }"
    template "<aside class=\"bg-[#131313] border-r border-white/5 fixed flex flex-col h-full left-0 p-4 pt-8 space-y-2 top-0 w-64 z-40\"><div class=\"mb-8 px-2\"><h2 class=\"font-black text-2xl text-white tracking-tighter\">NovaPay</h2><p class=\"text-neutral-500 text-xs tracking-widest uppercase\">My Account</p></div><nav class=\"flex flex-1 flex-col space-y-1\"><a href=\"/\" class=\"flex gap-3 hover:bg-white/5 hover:text-white items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span class=\"material-symbols-outlined\">dashboard</span><span class=\"text-sm\">Overview</span></a><a href=\"/invoices\" class=\"bg-white flex gap-3 items-center px-4 py-3 rounded-lg shadow-[0_0_15px_rgba(255,255,255,0.1)] text-black\"><span class=\"material-symbols-outlined\">receipt_long</span><span class=\"font-bold text-sm\">Invoices</span></a><a href=\"/subscription\" class=\"flex gap-3 hover:bg-white/5 hover:text-white items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span class=\"material-symbols-outlined\">autorenew</span><span class=\"text-sm\">Subscription</span></a><a href=\"/billing\" class=\"flex gap-3 hover:bg-white/5 hover:text-white items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span class=\"material-symbols-outlined\">credit_card</span><span class=\"text-sm\">Payment Methods</span></a><a href=\"/usage\" class=\"flex gap-3 hover:bg-white/5 hover:text-white items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span class=\"material-symbols-outlined\">analytics</span><span class=\"text-sm\">Usage</span></a></nav><a href=\"/settings\" class=\"border-t border-white/5 mt-auto pt-4 px-2 block hover:opacity-80 transition-opacity\"><div class=\"flex items-center gap-3\"><div class=\"w-8 h-8 rounded-full bg-white/10 flex items-center justify-center\"><span class=\"text-white/60 text-xs font-bold\" id=\"user-initial\">?</span></div><div><div class=\"text-white text-sm font-medium\" id=\"user-name\">User</div><div class=\"text-neutral-500 text-xs\">My Account</div></div></div></a></aside><script>try{var u=JSON.parse(localStorage.getItem('user')||'{}');if(u.name){var el=document.getElementById('user-name');if(el)el.textContent=u.name;var ini=document.getElementById('user-initial');if(ini)ini.textContent=u.name.charAt(0).toUpperCase();}}catch(e){}</script>"
  }

  section page-header {
    title "Invoices"
    subtitle "Your billing history and receipts."
    template "<header class=\"mb-12\"><h1 class=\"font-black leading-none mb-2 text-5xl text-white tracking-tighter\">{{title}}</h1><p class=\"font-light leading-relaxed max-w-2xl text-lg text-neutral-400\">{{subtitle}}</p></header>"
  }

  section table style:dark {
    title "All Invoices"
    columns "invoice_number, amount, currency, status, due_date, paid_at"
    bind Invoice { query all order created_at desc }
    search true
    pagination 20
  }
}

page "/subscription" requires:auth type:custom {
  layout sidebar

  section sidebar {
    brand "NovaPay"
    subtitle "My Account"
    item "Overview" -> "/portal" icon:dashboard
    item "Invoices" -> "/invoices" icon:receipt_long
    item "Subscription" -> "/subscription" icon:autorenew active:true
    item "Payment Methods" -> "/billing" icon:credit_card
    item "Usage" -> "/usage" icon:analytics
    style_block "body { background-color: #000; background-image: radial-gradient(#ffffff08 1px, transparent 1px); background-size: 40px 40px; color: #fff; font-family: 'Inter', sans-serif; } .glass-panel { background: rgba(255,255,255,0.03); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.1); } .glass-panel:hover { background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.15); } #cronus-content th { color: rgba(255,255,255,0.4) !important; font-size: 10px !important; letter-spacing: 0.15em !important; text-transform: uppercase !important; } #cronus-content td { border-bottom: 1px solid rgba(255,255,255,0.05) !important; } #cronus-content tr:hover td { background: rgba(255,255,255,0.03) !important; } #cronus-content input { background: rgba(255,255,255,0.05) !important; border: 1px solid rgba(255,255,255,0.1) !important; border-radius: 8px !important; color: white !important; } #cronus-content [style*='border-radius'] { background: rgba(255,255,255,0.03) !important; backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.08) !important; }"
    template "<aside class=\"bg-[#131313] border-r border-white/5 fixed flex flex-col h-full left-0 p-4 pt-8 space-y-2 top-0 w-64 z-40\"><div class=\"mb-8 px-2\"><h2 class=\"font-black text-2xl text-white tracking-tighter\">NovaPay</h2><p class=\"text-neutral-500 text-xs tracking-widest uppercase\">My Account</p></div><nav class=\"flex flex-1 flex-col space-y-1\"><a href=\"/\" class=\"flex gap-3 hover:bg-white/5 hover:text-white items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span class=\"material-symbols-outlined\">dashboard</span><span class=\"text-sm\">Overview</span></a><a href=\"/invoices\" class=\"flex gap-3 hover:bg-white/5 hover:text-white items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span class=\"material-symbols-outlined\">receipt_long</span><span class=\"text-sm\">Invoices</span></a><a href=\"/subscription\" class=\"bg-white flex gap-3 items-center px-4 py-3 rounded-lg shadow-[0_0_15px_rgba(255,255,255,0.1)] text-black\"><span class=\"material-symbols-outlined\">autorenew</span><span class=\"font-bold text-sm\">Subscription</span></a><a href=\"/billing\" class=\"flex gap-3 hover:bg-white/5 hover:text-white items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span class=\"material-symbols-outlined\">credit_card</span><span class=\"text-sm\">Payment Methods</span></a><a href=\"/usage\" class=\"flex gap-3 hover:bg-white/5 hover:text-white items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span class=\"material-symbols-outlined\">analytics</span><span class=\"text-sm\">Usage</span></a></nav><a href=\"/settings\" class=\"border-t border-white/5 mt-auto pt-4 px-2 block hover:opacity-80 transition-opacity\"><div class=\"flex items-center gap-3\"><div class=\"w-8 h-8 rounded-full bg-white/10 flex items-center justify-center\"><span class=\"text-white/60 text-xs font-bold\" id=\"user-initial\">?</span></div><div><div class=\"text-white text-sm font-medium\" id=\"user-name\">User</div><div class=\"text-neutral-500 text-xs\">My Account</div></div></div></a></aside><script>try{var u=JSON.parse(localStorage.getItem('user')||'{}');if(u.name){var el=document.getElementById('user-name');if(el)el.textContent=u.name;var ini=document.getElementById('user-initial');if(ini)ini.textContent=u.name.charAt(0).toUpperCase();}}catch(e){}</script>"
  }

  section page-header {
    title "Subscription"
    subtitle "Your current plan and billing cycle."
