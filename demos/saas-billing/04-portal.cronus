## Portal — user-facing billing. Navigation comes from layout Main.

page "/dashboard" type:dashboard requires:auth {
  title "Overview"

  section page-header {
    title "Billing"
    subtitle "Your invoices, subscription, and usage."
  }

  section kpi {
    bind Invoice { query count }
    item "Invoices" value:bind icon:receipt_long
  }

  section table {
    title "Recent Invoices"
    columns "invoice_number, amount, currency, status, due_date, paid_at"
    bind Invoice { query all order created_at desc limit 10 }
  }
}

page "/" type:dashboard requires:auth {
  title "Overview"

  section page-header {
    title "Billing"
    subtitle "Your invoices, subscription, and usage."
  }

  section kpi {
    bind Invoice { query count }
    item "Invoices" value:bind icon:receipt_long
  }

  section kpi {
    bind Subscription { query count }
    item "Subscriptions" value:bind icon:autorenew
  }

  section kpi {
    bind PaymentMethod { query count }
    item "Payment methods" value:bind icon:credit_card
  }

  section kpi {
    bind UsageRecord { query count }
    item "Usage records" value:bind icon:analytics
  }

  section table {
    title "Recent Invoices"
    columns "invoice_number, amount, currency, status, due_date, paid_at"
    bind Invoice { query all order created_at desc limit 10 }
  }
}

page "/invoices" requires:auth {
  title "Invoices"

  section page-header {
    title "Invoices"
    subtitle "Your billing history and receipts."
  }

  section table {
    title "All Invoices"
    columns "invoice_number, amount, currency, status, due_date, paid_at"
    bind Invoice { query all order created_at desc }
    search "invoice_number,status"
    paginate 20
  }
}

page "/subscription" requires:auth {
  title "Subscription"

  section page-header {
    title "Subscription"
    subtitle "Your current plan and billing cycle."
  }

  section table {
    title "Subscriptions"
    columns "plan, status, current_period_start, current_period_end, cancel_at"
    bind Subscription { query all order created_at desc }
  }
}

page "/billing" requires:auth {
  title "Payment Methods"

  section page-header {
    title "Payment Methods"
    subtitle "Manage how you pay for your subscription."
  }

  section alert style:info {
    title "Card data"
    subtitle "Only last four digits and brand are stored. Never send full card numbers."
  }

  section table {
    title "Saved methods"
    columns "type, last_four, brand, exp_month, exp_year, is_default"
    bind PaymentMethod { query all }
  }

  section form entity:PaymentMethod {
    title "Add payment method"
    bind PaymentMethod { }
    field "type" type:select options:["credit_card", "pix", "boleto", "wire"] required
    field "last_four" type:text
    field "brand" type:text
    field "exp_month" type:number
    field "exp_year" type:number
    field "is_default" type:checkbox

    on submit {
      create PaymentMethod
      toast "Payment method added" style:success
      navigate "/billing"
    }
  }
}

page "/usage" requires:auth {
  title "Usage"

  section page-header {
    title "Usage"
    subtitle "Resource consumption this billing period."
  }

  section progress {
    title "Usage this period"
    bind UsageRecord { query all order recorded_at desc }
  }

  section table {
    title "Usage Records"
    columns "metric, value, period, recorded_at"
    bind UsageRecord { query all order recorded_at desc }
    paginate 20
  }
}

page "/settings" type:form requires:auth {
  title "Settings"

  section page-header {
    title "Settings"
    subtitle "Manage your account."
  }

  section form entity:User {
    title "Profile"
    bind User { query one }
    field "name" type:text required
    field "email" type:email required

    on submit {
      update User
      toast "Settings saved" style:success
      navigate "/settings"
    }
  }
}
