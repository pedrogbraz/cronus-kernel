## Admin — billing operations. Navigation comes from layout Main.

page "/admin" type:dashboard requires:role(admin) {
  title "Billing Overview"

  section page-header {
    title "Billing Overview"
    subtitle "Subscription metrics, invoices, and customers from the database."
  }

  section alert style:info {
    title "Prices in centavos"
    subtitle "Money fields are integers. 2990 means R$29.90."
  }

  section kpi {
    bind Customer { query count }
    item "Customers" value:bind icon:people
  }

  section kpi {
    bind Invoice { query count }
    item "Invoices" value:bind icon:receipt_long
  }

  section kpi {
    bind Subscription { query count }
    item "Subscriptions" value:bind icon:autorenew
  }

  section kpi {
    bind Plan { query count }
    item "Plans" value:bind icon:loyalty
  }

  section chart type:bar {
    title "Invoices by status"
    bind Invoice { aggregate count group status }
  }

  section table {
    title "Recent Invoices"
    columns "invoice_number, amount, currency, status, due_date, paid_at"
    bind Invoice { query all order created_at desc limit 10 }
  }

  section table {
    title "Customers"
    columns "name, email, company, plan_name, mrr, status"
    bind Customer { query all order created_at desc limit 5 }
  }
}

page "/admin/customers" requires:role(admin) {
  title "Customers"

  section page-header {
    title "Customers"
    subtitle "Manage your customer base and subscription status."
  }

  section table {
    title "All Customers"
    columns "name, email, company, plan_name, mrr, status"
    bind Customer { query all order created_at desc }
    search "name,email,company"
    paginate 20
  }
}

page "/admin/customers/new" type:form requires:role(admin) {
  title "New Customer"

  section page-header {
    title "New Customer"
    subtitle "Create a customer record. MRR is stored in centavos."
  }

  section form entity:Customer {
    title "New Customer"
    bind Customer { }
    field "name" type:text required
    field "email" type:email required
    field "company" type:text
    field "phone" type:text
    field "country" type:text
    field "plan_name" type:text
    field "mrr" type:money

    on submit {
      create Customer
      toast "Customer created" style:success
      navigate "/admin/customers"
    }
  }
}

page "/admin/invoices" requires:role(admin) {
  title "Invoices"

  section page-header {
    title "Invoices"
    subtitle "Billing history and payment tracking."
  }

  section table {
    title "All Invoices"
    columns "invoice_number, amount, currency, status, due_date, paid_at"
    bind Invoice { query all order created_at desc }
    search "invoice_number,status"
    paginate 25
  }
}

page "/admin/subscriptions" requires:role(admin) {
  title "Subscriptions"

  section page-header {
    title "Subscriptions"
    subtitle "Active subscriptions and billing cycles."
  }

  section table {
    title "All Subscriptions"
    columns "customer, plan, status, current_period_start, current_period_end"
    bind Subscription { query all order created_at desc }
    search "status"
    paginate 20
  }
}

page "/admin/plans" requires:role(admin) {
  title "Plans"

  section page-header {
    title "Plans & Pricing"
    subtitle "Configure subscription tiers. Price is stored in centavos."
  }

  section table {
    title "Available Plans"
    columns "name, slug, price, interval, trial_days, active"
    bind Plan { query all order sort_order asc }
  }
}

page "/admin/plans/new" type:form requires:role(admin) {
  title "New Plan"

  section page-header {
    title "New Plan"
    subtitle "Price is an integer in centavos — 2990 is R$29.90."
  }

  section form entity:Plan {
    title "New Plan"
    bind Plan { }
    field "name" type:text required
    field "slug" type:text required
    field "price" type:money required
    field "interval" type:select options:["monthly", "yearly"]
    field "trial_days" type:number
    field "features" type:textarea

    on submit {
      create Plan
      toast "Plan created" style:success
      navigate "/admin/plans"
    }
  }
}

page "/admin/usage" requires:role(admin) {
  title "Usage"

  section page-header {
    title "Usage Analytics"
    subtitle "Resource consumption and metering data."
  }

  section table {
    title "Usage Records"
    columns "customer, metric, value, period, recorded_at"
    bind UsageRecord { query all order recorded_at desc }
    paginate 50
  }
}
