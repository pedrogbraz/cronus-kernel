## NovaPay — SaaS Billing & Subscription Management

app "NovaPay" {
  stack voodoo
  port 5220
  database sqlite "./data.db"
  constitution {
    must "prices stored in centavos — 2990 = R$29.90"
    must "every subscription has exactly one active plan"
    never "delete a customer with active subscriptions"
  }
}

auth {
  entity User
  login email + password
  session jwt expires:24h
  roles [admin, billing, viewer]
}

style {
  theme dark
  preset aurora
  runtime voodoo
  font "Inter"
  radius 14px
}

layout Main {
  sidebar {
    brand "NovaPay"
    "Overview" -> "/" icon:dashboard
    "Invoices" -> "/invoices" icon:receipt_long
    "Subscription" -> "/subscription" icon:autorenew
    "Billing" -> "/billing" icon:credit_card
    "Usage" -> "/usage" icon:analytics
    "Settings" -> "/settings" icon:settings
    divider
    "Admin" -> "/admin" icon:admin_panel_settings
    "Customers" -> "/admin/customers" icon:people
    "Admin Invoices" -> "/admin/invoices" icon:receipt
    "Plans" -> "/admin/plans" icon:loyalty
    "Admin Usage" -> "/admin/usage" icon:monitoring
  }
}
