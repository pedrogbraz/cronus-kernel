## NovaPay — SaaS Billing & Subscription Management

app "NovaPay" {
  stack react + tailwind
  port 5220
  database sqlite "./data.db"
  theme dark

  constitution {
    must "prices stored in centavos — 2990 = R$29.90"
    must "every subscription has exactly one active plan"
    never "delete a customer with active subscriptions"
  }
}

auth {
  entity User
  login email + password
  session jwt expires:24h
  roles [admin, billing, viewer]
}

style {
  theme dark
  accent white
  font "Inter"
}

tailwind_config "tailwind.config = { darkMode: \"class\", theme: { extend: { \"colors\": { \"surface\": \"#131313\", \"surface-container\": \"#1f1f1f\", \"surface-container-high\": \"#2a2a2a\", \"surface-container-lowest\": \"#0e0e0e\", \"on-surface\": \"#e2e2e2\", \"on-surface-variant\": \"#c6c6c6\", \"outline\": \"#919191\", \"outline-variant\": \"#474747\", \"primary\": \"#ffffff\", \"background\": \"#000000\", \"on-background\": \"#e2e2e2\", \"error\": \"#ffb4ab\" }, \"fontFamily\": { \"headline\": [\"Inter\"], \"body\": [\"Inter\"] } }, }, }"
