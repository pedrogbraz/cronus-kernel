## Reusable components for NovaPay

## Admin topbar — NovaPay + Live badge
component AdminTopbar {
  template "<nav class=\"backdrop-blur-xl bg-black/60 border-b border-white/10 fixed flex h-16 items-center justify-between px-6 top-0 w-full z-50\"><div class=\"flex gap-8 items-center\"><span class=\"font-black text-white text-xl tracking-tighter\">NovaPay</span></div><div class=\"flex gap-3 items-center\"><span class=\"bg-green-500/20 border border-green-500/30 font-mono px-3 py-1 rounded-full text-green-400 text-xs\">Live</span></div></nav>"
}

## Admin sidebar — auto-detects active route via JS
component AdminSidebar {
  template "<aside class=\"bg-[#131313] border-r border-white/5 fixed flex flex-col h-full left-0 p-4 pt-20 space-y-2 top-0 w-64 z-40\"><div class=\"mb-8 px-2\"><h2 class=\"font-black text-2xl text-white tracking-tighter\">NovaPay</h2><p class=\"text-neutral-500 text-xs tracking-widest uppercase\">Billing Admin</p></div><nav class=\"flex flex-1 flex-col space-y-1\" id=\"admin-nav\"><a href=\"/admin\" data-nav class=\"flex gap-3 items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span class=\"material-symbols-outlined\">dashboard</span><span class=\"text-sm\">Dashboard</span></a><a href=\"/admin/customers\" data-nav class=\"flex gap-3 items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span class=\"material-symbols-outlined\">people</span><span class=\"text-sm\">Customers</span></a><a href=\"/admin/invoices\" data-nav class=\"flex gap-3 items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span class=\"material-symbols-outlined\">receipt_long</span><span class=\"text-sm\">Invoices</span></a><a href=\"/admin/subscriptions\" data-nav class=\"flex gap-3 items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span class=\"material-symbols-outlined\">autorenew</span><span class=\"text-sm\">Subscriptions</span></a><a href=\"/admin/plans\" data-nav class=\"flex gap-3 items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span class=\"material-symbols-outlined\">loyalty</span><span class=\"text-sm\">Plans</span></a><a href=\"/admin/usage\" data-nav class=\"flex gap-3 items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span class=\"material-symbols-outlined\">analytics</span><span class=\"text-sm\">Usage</span></a></nav><div class=\"border-t border-white/5 flex flex-col pt-4 space-y-1\"><a href=\"/\" class=\"flex gap-3 hover:text-white items-center px-4 py-2 text-neutral-500 transition-colors\"><span class=\"material-symbols-outlined scale-75\">visibility</span><span class=\"text-sm\">View as User</span></a><a href=\"/docs\" class=\"flex gap-3 hover:text-white items-center px-4 py-2 text-neutral-500 transition-colors\"><span class=\"material-symbols-outlined scale-75\">menu_book</span><span class=\"text-sm\">Docs</span></a></div></aside><script>!function(){var p=location.pathname.replace(/\\/$/,'');document.querySelectorAll('#admin-nav [data-nav]').forEach(function(a){if(a.getAttribute('href')===p){a.className='bg-white flex gap-3 items-center px-4 py-3 rounded-lg shadow-[0_0_15px_rgba(255,255,255,0.1)] text-black';a.querySelector('span:last-child').className='font-bold text-sm';}else{a.className='flex gap-3 hover:bg-white/5 hover:text-white items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors';}})}();</script>"
}

## Admin style block
component AdminStyles {
  template "<style>body { background-color: #000; background-image: radial-gradient(#ffffff08 1px, transparent 1px); background-size: 40px 40px; color: #fff; font-family: 'Inter', sans-serif; } #cronus-main { padding: 0; max-width: 100vw; overflow-x: hidden; } .glass-panel { background: rgba(255,255,255,0.03); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.1); } #cronus-content th { color: rgba(255,255,255,0.4) !important; font-size: 10px !important; letter-spacing: 0.15em !important; text-transform: uppercase !important; } #cronus-content td { border-bottom: 1px solid rgba(255,255,255,0.05) !important; } #cronus-content tr:hover td { background: rgba(255,255,255,0.03) !important; } #cronus-content [style*='border-radius'] { background: rgba(255,255,255,0.03) !important; backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.08) !important; } #cronus-content input[type='text'], #cronus-content input[type='search'] { background: rgba(255,255,255,0.05) !important; border: 1px solid rgba(255,255,255,0.1) !important; border-radius: 8px !important; color: white !important; }</style>"
}

## Page header — reusable with title and subtitle
component PageHeader(title: text, subtitle: text) {
  template "<header class=\"mb-12\"><h1 class=\"font-black leading-none mb-2 text-5xl text-white tracking-tighter\">{{title}}</h1><p class=\"font-light leading-relaxed max-w-2xl text-lg text-neutral-400\">{{subtitle}}</p></header>"
}

## User sidebar — auto-detects active route via JS
component UserSidebar {
  template "<aside class=\"bg-[#131313] border-r border-white/5 fixed flex flex-col h-full left-0 p-4 pt-8 space-y-2 top-0 w-56 z-40\"><div class=\"mb-6 px-2\"><h2 class=\"font-black text-xl text-white tracking-tighter\">NovaPay</h2><p class=\"text-neutral-500 text-[10px] tracking-widest uppercase\">My Account</p></div><nav class=\"flex flex-1 flex-col space-y-1\" id=\"user-nav\"><a href=\"/\" data-nav class=\"flex gap-2 items-center px-3 py-2 rounded-lg text-neutral-500 text-sm\"><span class=\"material-symbols-outlined text-base\">dashboard</span>Overview</a><a href=\"/invoices\" data-nav class=\"flex gap-2 items-center px-3 py-2 rounded-lg text-neutral-500 text-sm\"><span class=\"material-symbols-outlined text-base\">receipt_long</span>Invoices</a><a href=\"/subscription\" data-nav class=\"flex gap-2 items-center px-3 py-2 rounded-lg text-neutral-500 text-sm\"><span class=\"material-symbols-outlined text-base\">autorenew</span>Subscription</a><a href=\"/billing\" data-nav class=\"flex gap-2 items-center px-3 py-2 rounded-lg text-neutral-500 text-sm\"><span class=\"material-symbols-outlined text-base\">credit_card</span>Payment Methods</a><a href=\"/usage\" data-nav class=\"flex gap-2 items-center px-3 py-2 rounded-lg text-neutral-500 text-sm\"><span class=\"material-symbols-outlined text-base\">analytics</span>Usage</a></nav><a href=\"/settings\" id=\"user-settings-link\" class=\"border-t border-white/5 mt-auto pt-4 px-2 block hover:opacity-80 transition-opacity\"><div class=\"flex items-center gap-3\"><div class=\"w-8 h-8 rounded-full bg-white/10 flex items-center justify-center\"><span class=\"text-white/60 text-xs font-bold\" id=\"user-initial\">?</span></div><div><div class=\"text-white text-sm font-medium\" id=\"user-name\">User</div><div class=\"text-neutral-500 text-xs\">My Account</div></div></div></a></aside><script>!function(){var p=location.pathname.replace(/\\/$/,'');document.querySelectorAll('#user-nav [data-nav]').forEach(function(a){if(a.getAttribute('href')===p){a.className='bg-white/10 flex gap-2 items-center px-3 py-2 rounded-lg text-white text-sm';} else{a.className='flex gap-2 hover:bg-white/5 items-center px-3 py-2 rounded-lg text-neutral-500 text-sm';}});if(p==='/settings'){var sl=document.getElementById('user-settings-link');if(sl)sl.className='border-t border-white/5 mt-auto pt-4 px-2 block bg-white/5 rounded-lg pb-3';}try{var u=JSON.parse(localStorage.getItem('user')||'{}');if(u.name){var el=document.getElementById('user-name');if(el)el.textContent=u.name;var ini=document.getElementById('user-initial');if(ini)ini.textContent=u.name.charAt(0).toUpperCase();}}catch(e){}}();</script>"
}

## User styles
component UserStyles {
  template "<style>body { background-color: #000; background-image: radial-gradient(#ffffff08 1px, transparent 1px); background-size: 40px 40px; color: #fff; font-family: 'Inter', sans-serif; } .glass-panel { background: rgba(255,255,255,0.03); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.1); } .glass-panel:hover { background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.15); } #cronus-content th { color: rgba(255,255,255,0.4) !important; font-size: 10px !important; letter-spacing: 0.15em !important; text-transform: uppercase !important; } #cronus-content td { border-bottom: 1px solid rgba(255,255,255,0.05) !important; } #cronus-content tr:hover td { background: rgba(255,255,255,0.03) !important; } #cronus-content input { background: rgba(255,255,255,0.05) !important; border: 1px solid rgba(255,255,255,0.1) !important; border-radius: 8px !important; color: white !important; } #cronus-content [style*='border-radius'] { background: rgba(255,255,255,0.03) !important; backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.08) !important; }</style>"
}
