## API — REST surface. Kernel already serves /api/auth/signup and /api/auth/login.

api /customers {
  list   GET    /      auth:jwt
  create POST   /      auth:jwt
  detail GET    /:id   auth:jwt
  update PATCH  /:id   auth:jwt
  delete DELETE /:id   auth:jwt
}

api /plans {
  list   GET    /      auth:public
  create POST   /      auth:jwt
  detail GET    /:id   auth:public
  update PATCH  /:id   auth:jwt
  delete DELETE /:id   auth:jwt
}

api /subscriptions {
  list   GET    /      auth:jwt
  create POST   /      auth:jwt
  detail GET    /:id   auth:jwt
  update PATCH  /:id   auth:jwt
  delete DELETE /:id   auth:jwt
}

api /invoices {
  list   GET    /      auth:jwt
  create POST   /      auth:jwt
  detail GET    /:id   auth:jwt
  update PATCH  /:id   auth:jwt
  delete DELETE /:id   auth:jwt
}

api /payment-methods {
  list   GET    /      auth:jwt
  create POST   /      auth:jwt
  detail GET    /:id   auth:jwt
  update PATCH  /:id   auth:jwt
  delete DELETE /:id   auth:jwt
}

api /usage {
  list   GET    /      auth:jwt
  create POST   /      auth:jwt
  detail GET    /:id   auth:jwt
  update PATCH  /:id   auth:jwt
  delete DELETE /:id   auth:jwt
}
