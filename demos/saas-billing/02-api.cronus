## API — full REST endpoints, auto-generated from entities

api /auth {
  login POST /auth/login auth:public
  register POST /auth/register auth:public
  me GET /auth/me auth:jwt
}

api /customers {
  list GET /customers auth:jwt
  create POST /customers auth:jwt
  detail GET /customers/:id auth:jwt
  update PATCH /customers/:id auth:jwt
  remove DELETE /customers/:id auth:jwt
}

api /plans {
  list GET /plans auth:public
  create POST /plans auth:jwt
  detail GET /plans/:id auth:public
  update PATCH /plans/:id auth:jwt
  remove DELETE /plans/:id auth:jwt
}

