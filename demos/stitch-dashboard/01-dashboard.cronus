page "/" type:dashboard requires:auth {
  title "System Status"

  section page-header {
    title "System Status"
    subtitle "Infrastructure integrity and live telemetry from registered nodes."
  }

  section kpi {
    bind Node { query count scope:public }
    item "Active Nodes" value:bind icon:dns
  }

  section kpi {
    bind Session { query count scope:public }
    item "Sessions" value:bind icon:monitoring
  }

  section kpi {
    bind SecurityEvent { query count scope:public }
    item "Events" value:bind icon:security
  }

  section kpi {
    bind Metric { query count scope:public }
    item "Metrics" value:bind icon:speed
  }

  section table {
    title "Active Nodes"
    bind Node { query all order name asc scope:public }
    columns "name, location, load, uptime, status"
    search true
  }

  section chart {
    title "Load"
    bind Node { query all scope:public }
    chart_type bar
  }
}

page "/dashboard" type:dashboard requires:auth {
  title "System Status"

  section page-header {
    title "System Status"
    subtitle "Infrastructure integrity and live telemetry from registered nodes."
  }

  section kpi {
    bind Node { query count scope:public }
    item "Active Nodes" value:bind icon:dns
  }

  section table {
    title "Active Nodes"
    bind Node { query all order name asc scope:public }
    columns "name, location, load, uptime, status"
    search true
  }
}
