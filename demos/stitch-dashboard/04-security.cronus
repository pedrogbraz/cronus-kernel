page "/security" type:dashboard requires:auth {
  title "Security & Firewall"

  section page-header {
    title "Security & Firewall"
    subtitle "Perimeter protection and threat neutralization for the Obsidian ecosystem."
  }

  section alert style:success {
    title "System Status"
    subtitle "Protected. Handshake and packet inspection are live."
  }

  section kpi cols:4 {
    bind SecurityEvent { query count }
    item "Security Events" value:bind icon:security
  }

  section kpi cols:4 {
    bind Node { query count }
    item "Covered Nodes" value:bind icon:lan
  }

  section table {
    title "Access Audit Stream"
    bind SecurityEvent { query all order event_type asc }
    columns "event_type, node, protocol, status, details"
    search true
  }

  section chart {
    title "Threat Monitor"
    bind SecurityEvent { query all }
    chart_type bar
  }
}
