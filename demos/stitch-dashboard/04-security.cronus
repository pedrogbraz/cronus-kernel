page "/security" type:custom {
  section topbar {
    action "Dashboard" -> "/" icon:dashboard
    action "Monitoring" -> "/analytics" icon:monitoring
    action "Lock" -> "/security" icon:lock
    action "Settings" -> "/settings" icon:settings
    template "<nav class=\"bg-[#131313] border-t border-white/5 bottom-0 fixed flex h-16 items-center justify-around left-0 md:hidden w-full z-50\"><button class=\"flex flex-col gap-1 items-center text-neutral-500\"><span class=\"material-symbols-outlined\">dashboard</span><span class=\"text-[10px]\">Home</span></button><button class=\"flex flex-col gap-1 items-center text-neutral-500\"><span class=\"material-symbols-outlined\">monitoring</span><span class=\"text-[10px]\">Analytics</span></button><button class=\"flex flex-col gap-1 items-center text-white\"><span style=\"font-variation-settings: 'FILL' 1;\" class=\"material-symbols-outlined\">lock</span><span class=\"text-[10px]\">Vault</span></button><button class=\"flex flex-col gap-1 items-center text-neutral-500\"><span class=\"material-symbols-outlined\">settings</span><span class=\"text-[10px]\">Settings</span></button></nav>"
    style_block "     body {       background-color: #000000;       background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.05) 1px, transparent 0);       background-size: 40px 40px;     }     .material-symbols-outlined {       font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;     }     .prism-glow {       box-shadow: 0 0 40px rgba(255, 255, 255, 0.05);     }     .glass-panel {       background: rgba(255, 255, 255, 0.03);       backdrop-filter: blur(12px);       border: 1px solid rgba(255, 255, 255, 0.1);     }   "
  }

  section topbar {
    brand "Obsidian Prism"
    item "Search Security..." icon:search
    image "User profile" src:"https://lh3.googleusercontent.com/aida-public/AB6AXuBqGZuTfTb70tr8_7AnTi1Sfv7fnZN2QpTnpyaULJkLUkxmFMrFrKG3pA0JBIwj7dJE4MFktV1zfeXRF_CZcu2MhjoG7V9wZ35ugOUwJK06sR2JskVks20lSbqv5XZMlTCreuxrTzdJ5e2JvLaDQgxXe6nGJ7uG_CoefGi0AJkXwxQidtFvoFK0dHaqD1P7_s7nOO1tSSLV_0DHmL9FvGII1TxUPX5NvWZuvUzlaIpoXnSNu2VQtGEvbg522MjiWJkVaFn8ysw76CzS"
    template "<header class=\"backdrop-blur-xl bg-black/60 border-b border-white/10 fixed flex font-['Inter'] h-16 items-center justify-between px-6 top-0 tracking-tighter w-full z-50\"><div class=\"flex gap-8 items-center\"><span class=\"font-bold text-white text-xl tracking-tighter\">Obsidian Prism</span><nav class=\"gap-6 hidden md:flex\"><a href=\"/\" class=\"duration-300 hover:bg-white/10 px-3 py-1 rounded text-neutral-400 transition-all\">Dashboard</a><a href=\"/security\" class=\"border-b border-white font-bold px-3 py-1 text-white\">Vault</a><a href=\"/analytics\" class=\"duration-300 hover:bg-white/10 px-3 py-1 rounded text-neutral-400 transition-all\">Analytics</a></nav></div><div class=\"flex gap-4 items-center\"><div class=\"hidden relative sm:block\"><span class=\"-translate-y-1/2 absolute left-3 material-symbols-outlined text-neutral-500 text-sm top-1/2\">search</span><input type=\"text\" placeholder=\"Search Security...\" class=\"bg-surface-container-lowest border border-white/10 focus:border-white/50 focus:outline-none pl-10 pr-4 py-1.5 rounded-lg text-sm transition-all w-64\"></div><button class=\"duration-300 hover:bg-white/10 material-symbols-outlined p-2 rounded-full text-white transition-all\">notifications</button><button class=\"duration-300 hover:bg-white/10 material-symbols-outlined p-2 rounded-full text-white transition-all\">settings</button><div class=\"bg-surface-container-high border border-white/20 h-8 overflow-hidden rounded-full w-8\"><img data-alt=\"professional portrait of a security engineer in low light editorial style\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBqGZuTfTb70tr8_7AnTi1Sfv7fnZN2QpTnpyaULJkLUkxmFMrFrKG3pA0JBIwj7dJE4MFktV1zfeXRF_CZcu2MhjoG7V9wZ35ugOUwJK06sR2JskVks20lSbqv5XZMlTCreuxrTzdJ5e2JvLaDQgxXe6nGJ7uG_CoefGi0AJkXwxQidtFvoFK0dHaqD1P7_s7nOO1tSSLV_0DHmL9FvGII1TxUPX5NvWZuvUzlaIpoXnSNu2VQtGEvbg522MjiWJkVaFn8ysw76CzS\" alt=\"User profile\"></div></div></header>"
  }

  section sidebar {
    brand "Obsidian"
    subtitle "Premium Suite"
    item "Dashboard" -> "/" icon:dashboard
    item "Analytics" -> "/analytics" icon:monitoring
    item "Portfolio" -> "/infrastructure" icon:account_balance_wallet
    item "Vault" -> "/security" icon:lock active:true
    item "Reports" -> "/settings" icon:description
    item "Support" -> "/docs" icon:help position:bottom
    item "Logout" -> "/docs" icon:logout position:bottom
    action "Upgrade to Prism Upgrade to Prism" -> "#"
    template "<aside class=\"bg-[#131313] border-r border-white/5 fixed flex flex-col h-full left-0 p-4 pt-20 space-y-2 top-0 w-64 z-40\"><div class=\"mb-8 px-2\"><h2 class=\"font-black text-2xl text-white tracking-tighter\">Obsidian</h2><p class=\"text-neutral-500 text-xs tracking-widest uppercase\">Premium Suite</p></div><nav class=\"flex flex-1 flex-col space-y-1\"><a href=\"/\" class=\"flex gap-3 group hover:bg-white/5 hover:text-white items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span data-icon=\"dashboard\" class=\"material-symbols-outlined\">dashboard</span><span class=\"font-['Inter'] text-sm tracking-tight\">Dashboard</span></a><a href=\"/analytics\" class=\"flex gap-3 group hover:bg-white/5 hover:text-white items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span data-icon=\"monitoring\" class=\"material-symbols-outlined\">monitoring</span><span class=\"font-['Inter'] text-sm tracking-tight\">Analytics</span></a><a href=\"/infrastructure\" class=\"flex gap-3 group hover:bg-white/5 hover:text-white items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span data-icon=\"account_balance_wallet\" class=\"material-symbols-outlined\">account_balance_wallet</span><span class=\"font-['Inter'] text-sm tracking-tight\">Portfolio</span></a><a href=\"/security\" class=\"bg-white flex gap-3 group items-center px-4 py-3 rounded-lg shadow-[0_0_15px_rgba(255,255,255,0.1)] text-black\"><span data-icon=\"lock\" class=\"material-symbols-outlined\">lock</span><span class=\"font-['Inter'] font-bold text-sm tracking-tight\">Vault</span></a><a href=\"/settings\" class=\"flex gap-3 group hover:bg-white/5 hover:text-white items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span data-icon=\"description\" class=\"material-symbols-outlined\">description</span><span class=\"font-['Inter'] text-sm tracking-tight\">Reports</span></a></nav><div class=\"border-t border-white/5 flex flex-col pt-4 space-y-1\"><button class=\"bg-white font-bold hover:scale-[0.98] mb-4 py-3 rounded-lg text-black text-sm transition-transform w-full\">Upgrade to Prism</button><a href=\"/docs\" class=\"flex gap-3 hover:text-white items-center px-4 py-2 text-neutral-500 transition-colors\"><span data-icon=\"help\" class=\"material-symbols-outlined scale-75\">help</span><span class=\"text-sm\">Support</span></a><a href=\"/docs\" class=\"flex gap-3 hover:text-white items-center px-4 py-2 text-neutral-500 transition-colors\"><span data-icon=\"logout\" class=\"material-symbols-outlined scale-75\">logout</span><span class=\"text-sm\">Logout</span></a></div></aside>"
  }

  section page-header {
    title "Security & Firewall"
    subtitle "Advanced perimeter protection and real-time threat neutralization for the Obsidian ecosystem."
    template "<header class=\"max-w-5xl mb-12\"><div class=\"bg-white/5 border border-white/10 font-medium gap-2 inline-flex items-center mb-6 px-3 py-1 rounded-full text-white text-xs\"><span class=\"bg-green-500 h-1.5 rounded-full w-1.5\"></span>        System Status: Protected      </div><h1 class=\"font-black italic mb-4 text-6xl text-white tracking-tighter\">{{title}}</h1><p class=\"leading-relaxed max-w-2xl text-lg text-on-surface-variant\">{{subtitle}}</p></header>"
  }

  section features cols:12 {
    subtitle "Current ecosystem risk assessment."
    item "DDoS Threat Monitor" span:8 {
      "Inbound traffic analysis & packet inspection"
    }
    item "Active Rules" icon:lan span:4
    item "Access Audit Stream" icon:terminal span:12
    item "Network Health" icon:wifi_tethering span:6 {
      "Uptime within SLA parameters."
    }
    item "Vault Utilization" icon:database span:6 {
      "AES-256-GCM hardware encryption active."
    }
    item "Threat Level" icon:radar span:4 {
      "Current ecosystem risk assessment."
    }
    template "<div class=\"gap-6 grid grid-cols-12 max-w-[1400px]\"><div class=\"col-span-12 glass-panel lg:col-span-8 overflow-hidden p-8 prism-glow relative rounded-xl\"><div class=\"flex items-start justify-between mb-12\"><div><h3 class=\"font-bold mb-1 text-white text-xl tracking-tight\">DDoS Threat Monitor</h3><p class=\"text-neutral-500 text-sm\">Inbound traffic analysis & packet inspection</p></div><div class=\"text-right\"><div class=\"font-bold font-mono text-2xl text-white\">12.4 Gb/s</div><div class=\"text-[10px] text-neutral-500 tracking-widest uppercase\">Current Load</div></div></div><div class=\"flex gap-1 h-48 items-end px-4 relative w-full\"><div class=\"absolute bg-gradient-to-t from-white/5 inset-0 pointer-events-none to-transparent\"></div><div class=\"bg-white/10 flex-1 h-[30%] rounded-t-sm\"></div><div class=\"bg-white/10 flex-1 h-[45%] rounded-t-sm\"></div><div class=\"bg-white/10 flex-1 h-[60%] rounded-t-sm\"></div><div class=\"bg-white/10 flex-1 h-[55%] rounded-t-sm\"></div><div class=\"bg-white/10 flex-1 h-[75%] rounded-t-sm\"></div><div class=\"bg-white/20 flex-1 h-[90%] rounded-t-sm\"></div><div class=\"bg-white/10 flex-1 h-[70%] rounded-t-sm\"></div><div class=\"bg-white/10 flex-1 h-[50%] rounded-t-sm\"></div><div class=\"bg-white/30 flex-1 h-[85%] rounded-t-sm shadow-[0_0_15px_rgba(255,255,255,0.2)]\"></div><div class=\"bg-white/10 flex-1 h-[65%] rounded-t-sm\"></div><div class=\"bg-white/10 flex-1 h-[40%] rounded-t-sm\"></div><div class=\"bg-white/10 flex-1 h-[30%] rounded-t-sm\"></div><div class=\"bg-white/20 flex-1 h-[55%] rounded-t-sm\"></div><div class=\"bg-white/10 flex-1 h-[75%] rounded-t-sm\"></div><div class=\"bg-white/10 flex-1 h-[95%] rounded-t-sm\"></div><div class=\"bg-white/10 flex-1 h-[80%] rounded-t-sm\"></div><div class=\"bg-white/10 flex-1 h-[60%] rounded-t-sm\"></div><div class=\"bg-white/20 flex-1 h-[45%] rounded-t-sm\"></div><div class=\"bg-white/10 flex-1 h-[30%] rounded-t-sm\"></div><div class=\"bg-white/10 flex-1 h-[25%] rounded-t-sm\"></div></div><div class=\"border-t border-white/5 gap-4 grid grid-cols-4 mt-12 pt-8\"><div><div class=\"mb-1 text-[10px] text-neutral-500 tracking-tighter uppercase\">Scrubbing</div><div class=\"font-bold text-white\">Active</div></div><div><div class=\"mb-1 text-[10px] text-neutral-500 tracking-tighter uppercase\">Latency</div><div class=\"font-bold text-white\">14ms</div></div><div><div class=\"mb-1 text-[10px] text-neutral-500 tracking-tighter uppercase\">Threats Blocked</div><div class=\"font-bold text-white\">1,248</div></div><div><div class=\"mb-1 text-[10px] text-neutral-500 tracking-tighter uppercase\">Node Status</div><div class=\"font-bold text-green-400\">Optimal</div></div></div></div><div class=\"col-span-12 flex flex-col glass-panel lg:col-span-4 p-8 rounded-xl\"><div class=\"flex items-center justify-between mb-8\"><h3 class=\"font-bold text-white text-xl tracking-tight\">Active Rules</h3><button class=\"hover:text-white material-symbols-outlined text-white/40 transition-colors\">add_circle</button></div><div class=\"max-h-[400px] overflow-y-auto pr-2 space-y-4\"><div class=\"bg-white/5 border border-white/5 flex hover:border-white/10 items-center justify-between p-4 rounded-lg transition-all\"><div class=\"flex gap-4 items-center\"><div class=\"bg-white/5 p-2 rounded\"><span class=\"material-symbols-outlined text-sm text-white/60\">lan</span></div><div><div class=\"font-bold text-sm text-white\">Intranet Isolation</div><div class=\"text-[10px] text-neutral-500\">TCP/UDP All Ports</div></div></div><label class=\"cursor-pointer inline-flex items-center relative\"><input checked=\"\" type=\"checkbox\" class=\"peer sr-only\"><div class=\"after:absolute after:bg-white after:content-[''] after:h-4 after:left-[2px] after:rounded-full after:top-[2px] after:transition-all after:w-4 bg-white/10 h-5 peer peer-checked:after:translate-x-full peer-checked:bg-white/40 rounded-full w-10\"></div></label></div><div class=\"bg-white/5 border border-white/5 flex hover:border-white/10 items-center justify-between p-4 rounded-lg transition-all\"><div class=\"flex gap-4 items-center\"><div class=\"bg-white/5 p-2 rounded\"><span class=\"material-symbols-outlined text-sm text-white/60\">public</span></div><div><div class=\"font-bold text-sm text-white\">Geo-Block CN/RU</div><div class=\"text-[10px] text-neutral-500\">Ingress Traffic Only</div></div></div><label class=\"cursor-pointer inline-flex items-center relative\"><input checked=\"\" type=\"checkbox\" class=\"peer sr-only\"><div class=\"after:absolute after:bg-white after:content-[''] after:h-4 after:left-[2px] after:rounded-full after:top-[2px] after:transition-all after:w-4 bg-white/10 h-5 peer peer-checked:after:translate-x-full peer-checked:bg-white/40 rounded-full w-10\"></div></label></div><div class=\"bg-white/5 border border-white/5 flex hover:border-white/10 items-center justify-between p-4 rounded-lg transition-all\"><div class=\"flex gap-4 items-center\"><div class=\"bg-white/5 p-2 rounded\"><span class=\"material-symbols-outlined text-sm text-white/60\">cloud_sync</span></div><div><div class=\"font-bold text-sm text-white\">Webhook Whitelist</div><div class=\"text-[10px] text-neutral-500\">Port 443 Enforcement</div></div></div><label class=\"cursor-pointer inline-flex items-center relative\"><input type=\"checkbox\" class=\"peer sr-only\"><div class=\"after:absolute after:bg-white after:content-[''] after:h-4 after:left-[2px] after:rounded-full after:top-[2px] after:transition-all after:w-4 bg-white/10 h-5 peer peer-checked:after:translate-x-full peer-checked:bg-white/40 rounded-full w-10\"></div></label></div><div class=\"bg-white/5 border border-white/5 flex hover:border-white/10 items-center justify-between opacity-60 p-4 rounded-lg transition-all\"><div class=\"flex gap-4 items-center\"><div class=\"bg-white/5 p-2 rounded\"><span class=\"material-symbols-outlined text-sm text-white/60\">vpn_key</span></div><div><div class=\"font-bold text-sm text-white\">Legacy SSH access</div><div class=\"text-[10px] text-neutral-500\">Deprecating 2024-12</div></div></div><label class=\"cursor-pointer inline-flex items-center relative\"><input type=\"checkbox\" class=\"peer sr-only\"><div class=\"after:absolute after:bg-white after:content-[''] after:h-4 after:left-[2px] after:rounded-full after:top-[2px] after:transition-all after:w-4 bg-white/10 h-5 peer peer-checked:after:translate-x-full peer-checked:bg-white/40 rounded-full w-10\"></div></label></div></div><button class=\"border-t border-white/10 font-bold hover:text-white mt-auto py-4 text-neutral-400 text-xs tracking-widest transition-all uppercase w-full\">          Manage All 24 Rules        </button></div><div class=\"col-span-12 glass-panel p-8 prism-glow rounded-xl\"><div class=\"flex items-center justify-between mb-8\"><div class=\"flex gap-3 items-center\"><span class=\"material-symbols-outlined text-white/40\">terminal</span><h3 class=\"font-bold text-white text-xl tracking-tight\">Access Audit Stream</h3></div><div class=\"flex gap-2\"><span class=\"bg-white/5 border border-white/10 px-2 py-1 rounded text-[10px] text-neutral-400\">DEBUG: OFF</span><span class=\"bg-white/10 border border-white/20 px-2 py-1 rounded text-[10px] text-white\">REALTIME: ON</span></div></div><div class=\"bg-black/40 font-mono leading-relaxed overflow-x-auto p-6 rounded-lg text-sm\"><div class=\"flex gap-4 mb-2\"><span class=\"text-neutral-600\">[2023-11-20 14:23:01]</span><span class=\"text-blue-400\">INFO</span><span class=\"text-white/80\">Handshake initialized with peer 192.168.1.104 via TLS 1.3</span></div><div class=\"flex gap-4 mb-2\"><span class=\"text-neutral-600\">[2023-11-20 14:23:05]</span><span class=\"text-green-400\">AUTH</span><span class=\"text-white/80\">User 'admin_prism' successfully authenticated from session ID: x82j3...</span></div><div class=\"flex gap-4 mb-2\"><span class=\"text-neutral-600\">[2023-11-20 14:23:12]</span><span class=\"text-yellow-400\">WARN</span><span class=\"text-white/80\">Anomaly detected in packet header from 84.122.31.2; dropped.</span></div><div class=\"flex gap-4 mb-2\"><span class=\"text-neutral-600\">[2023-11-20 14:24:00]</span><span class=\"text-red-400\">CRIT</span><span class=\"text-white/80\">Rate-limiting engaged for IP range 45.10.x.x (Brute force attempt)</span></div><div class=\"flex gap-4 mb-2\"><span class=\"text-neutral-600\">[2023-11-20 14:25:10]</span><span class=\"text-blue-400\">INFO</span><span class=\"text-white/80\">Firewall rule 'Intranet Isolation' updated by 'system_daemon'</span></div><div class=\"flex gap-4\"><span class=\"text-neutral-600\">[2023-11-20 14:25:45]</span><span class=\"text-green-400\">PASS</span><span class=\"text-white/80\">Scheduled integrity check completed in 452ms. No issues.</span></div><div class=\"animate-pulse flex gap-4\"><span class=\"text-neutral-600\">_</span></div></div></div><div class=\"col-span-12 glass-panel group h-64 lg:col-span-4 md:col-span-6 overflow-hidden p-8 relative rounded-xl\"><div class=\"-bottom-4 -right-4 absolute group-hover:opacity-20 opacity-10 transition-opacity\"><span class=\"material-symbols-outlined text-[160px]\">wifi_tethering</span></div><h4 class=\"font-bold mb-2 text-[10px] text-white/40 tracking-widest uppercase\">Network Health</h4><div class=\"font-black italic mb-4 text-4xl text-white\">99.98%</div><div class=\"space-y-2\"><div class=\"bg-white/5 h-1 overflow-hidden rounded-full w-full\"><div class=\"bg-white h-full w-[99%]\"></div></div><p class=\"text-neutral-500 text-xs\">Uptime within SLA parameters.</p></div></div><div class=\"col-span-12 glass-panel group h-64 lg:col-span-4 md:col-span-6 overflow-hidden p-8 relative rounded-xl\"><div class=\"-bottom-4 -right-4 absolute group-hover:opacity-20 opacity-10 transition-opacity\"><span class=\"material-symbols-outlined text-[160px]\">database</span></div><h4 class=\"font-bold mb-2 text-[10px] text-white/40 tracking-widest uppercase\">Vault Utilization</h4><div class=\"font-black italic mb-4 text-4xl text-white\">2.4 TB</div><div class=\"space-y-2\"><div class=\"bg-white/5 h-1 overflow-hidden rounded-full w-full\"><div class=\"bg-white/60 h-full w-[45%]\"></div></div><p class=\"text-neutral-500 text-xs\">AES-256-GCM hardware encryption active.</p></div></div><div class=\"bg-gradient-to-br col-span-12 from-white/5 glass-panel group h-64 lg:col-span-4 overflow-hidden p-8 relative rounded-xl to-transparent\"><div class=\"absolute right-8 top-4\"><span class=\"animate-pulse material-symbols-outlined text-3xl text-white\">radar</span></div><h4 class=\"font-bold mb-2 text-[10px] text-white/40 tracking-widest uppercase\">Threat Level</h4><div class=\"font-black italic mb-4 text-4xl text-white\">LOW</div><div class=\"flex gap-1 mt-8\"><div class=\"bg-green-500 h-2 rounded-sm w-8\"></div><div class=\"bg-neutral-800 h-2 rounded-sm w-8\"></div><div class=\"bg-neutral-800 h-2 rounded-sm w-8\"></div><div class=\"bg-neutral-800 h-2 rounded-sm w-8\"></div><div class=\"bg-neutral-800 h-2 rounded-sm w-8\"></div></div><p class=\"mt-4 text-neutral-500 text-xs\">{{subtitle}}</p></div></div>"
  }

}
