page "/infrastructure" type:custom {
  section topbar {
    brand "Obsidian Prism"
    item "Search resources..." icon:search
    image "User profile" src:"https://lh3.googleusercontent.com/aida-public/AB6AXuCWggDWB_lFEfv_Cc5Z8P-5HTHj_OXDnkqWcRd_YqwD7jw4tv9t7ESvTgoMTvn28UB08jW1ZZgAHjWtDJJdNpqw3c3NLBCJna-ZvLafM106ALij9V1MGxE5x8yj8OGGaMuK-q-JC3VBeoaW3y31EB3vsaNRIq2bavnNErYay7KfpFJiLlsTiBRzDu1HwkR_bmqwOlHI4ebu444X43VyzBZ2CmA45Pi907i7ZNetHnl1EfucWKQMkZ0MZH0M1J0F_xnGgNr6S7Xb_Pmo"
    template "<nav class=\"backdrop-blur-xl bg-black/60 border-b border-white/10 fixed flex h-16 items-center justify-between px-6 top-0 w-full z-50\"><div class=\"flex gap-8 items-center\"><span class=\"font-bold font-headline text-white text-xl tracking-tighter\">Obsidian Prism</span><div class=\"gap-6 hidden items-center md:flex\"><a href=\"/\" class=\"duration-300 font-headline hover:bg-white/10 px-2 py-1 rounded text-neutral-400 text-sm transition-all\">Dashboard</a></div></div><div class=\"flex gap-4 items-center\"><div class=\"hidden relative sm:block\"><span class=\"-translate-y-1/2 absolute left-3 material-symbols-outlined text-neutral-500 text-sm top-1/2\">search</span><input type=\"text\" placeholder=\"Search resources...\" class=\"bg-surface-container-lowest border border-white/5 focus:border-white/20 focus:outline-none pl-10 pr-4 py-1.5 rounded-lg text-sm transition-all w-64\"></div><span class=\"cursor-pointer hover:bg-white/10 material-symbols-outlined p-2 rounded-full text-white transition-all\">notifications</span><span class=\"cursor-pointer hover:bg-white/10 material-symbols-outlined p-2 rounded-full text-white transition-all\">settings</span><img alt=\"User profile\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCWggDWB_lFEfv_Cc5Z8P-5HTHj_OXDnkqWcRd_YqwD7jw4tv9t7ESvTgoMTvn28UB08jW1ZZgAHjWtDJJdNpqw3c3NLBCJna-ZvLafM106ALij9V1MGxE5x8yj8OGGaMuK-q-JC3VBeoaW3y31EB3vsaNRIq2bavnNErYay7KfpFJiLlsTiBRzDu1HwkR_bmqwOlHI4ebu444X43VyzBZ2CmA45Pi907i7ZNetHnl1EfucWKQMkZ0MZH0M1J0F_xnGgNr6S7Xb_Pmo\" data-alt=\"close-up portrait of a professional individual with soft studio lighting and a clean dark background\" class=\"border border-white/10 h-8 ml-2 rounded-full w-8\"></div></nav>"
    style_block "     body {       background-color: #000000;       background-image:         radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.03) 1px, transparent 1px);       background-size: 40px 40px;     }     .material-symbols-outlined {       font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;     }     .prism-gradient {       background: linear-gradient(135deg, #ffffff 0%, #d4d4d4 100%);     }     .ethereal-glow {       box-shadow: 0 0 40px rgba(226, 226, 226, 0.05);     }   "
  }

  section sidebar {
    brand "Obsidian"
    subtitle "Premium Suite"
    item "Dashboard" -> "/" icon:dashboard
    item "Analytics" -> "/analytics" icon:monitoring
    item "Portfolio" -> "/infrastructure" icon:account_balance_wallet active:true
    item "Vault" -> "/security" icon:lock
    item "Reports" -> "/settings" icon:description
    item "Support" -> "/docs" icon:help position:bottom
    item "Logout" -> "/docs" icon:logout position:bottom
    action "Upgrade to Prism Upgrade to Prism" -> "#"
    template "<aside class=\"bg-[#131313] border-r border-white/5 fixed flex flex-col h-full left-0 p-4 pt-20 space-y-2 top-0 w-64 z-40\"><div class=\"mb-8 px-2\"><h2 class=\"font-black text-2xl text-white tracking-tighter\">Obsidian</h2><p class=\"text-neutral-500 text-xs tracking-widest uppercase\">Premium Suite</p></div><nav class=\"flex flex-1 flex-col space-y-1\"><a href=\"/\" class=\"flex gap-3 group hover:bg-white/5 hover:text-white items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span data-icon=\"dashboard\" class=\"material-symbols-outlined\">dashboard</span><span class=\"font-['Inter'] text-sm tracking-tight\">Dashboard</span></a><a href=\"/analytics\" class=\"flex gap-3 group hover:bg-white/5 hover:text-white items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span data-icon=\"monitoring\" class=\"material-symbols-outlined\">monitoring</span><span class=\"font-['Inter'] text-sm tracking-tight\">Analytics</span></a><a href=\"/infrastructure\" class=\"bg-white flex gap-3 group items-center px-4 py-3 rounded-lg shadow-[0_0_15px_rgba(255,255,255,0.1)] text-black\"><span data-icon=\"account_balance_wallet\" class=\"material-symbols-outlined\">account_balance_wallet</span><span class=\"font-['Inter'] font-bold text-sm tracking-tight\">Portfolio</span></a><a href=\"/security\" class=\"flex gap-3 group hover:bg-white/5 hover:text-white items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span data-icon=\"lock\" class=\"material-symbols-outlined\">lock</span><span class=\"font-['Inter'] text-sm tracking-tight\">Vault</span></a><a href=\"/settings\" class=\"flex gap-3 group hover:bg-white/5 hover:text-white items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span data-icon=\"description\" class=\"material-symbols-outlined\">description</span><span class=\"font-['Inter'] text-sm tracking-tight\">Reports</span></a></nav><div class=\"border-t border-white/5 flex flex-col pt-4 space-y-1\"><button class=\"bg-white font-bold hover:scale-[0.98] mb-4 py-3 rounded-lg text-black text-sm transition-transform w-full\">Upgrade to Prism</button><a href=\"/docs\" class=\"flex gap-3 hover:text-white items-center px-4 py-2 text-neutral-500 transition-colors\"><span data-icon=\"help\" class=\"material-symbols-outlined scale-75\">help</span><span class=\"text-sm\">Support</span></a><a href=\"/docs\" class=\"flex gap-3 hover:text-white items-center px-4 py-2 text-neutral-500 transition-colors\"><span data-icon=\"logout\" class=\"material-symbols-outlined scale-75\">logout</span><span class=\"text-sm\">Logout</span></a></div></aside>"
  }

  section page-header {
    title "Infrastructure Config"
    subtitle "Precision monitoring and scaling controls for your distributed obsidian clusters. Real-time telemetry synchronized across all nodes."
    template "<header class=\"flex flex-col gap-6 justify-between mb-12 md:flex-row md:items-end\"><div class=\"max-w-2xl\"><h1 class=\"font-black mb-4 md:text-5xl text-4xl text-white tracking-tighter uppercase\">{{title}}</h1><p class=\"leading-relaxed max-w-lg text-lg text-on-surface-variant\">{{subtitle}}</p></div><div class=\"flex gap-3 items-center\"><div class=\"-space-x-2 flex\"><img src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDPftPTAk2VRrTHFKl0h9xI__wGe38-tldNu6P0mrFPBRtBVr_rZEo9bLp8EVtjSRjMgxVlpszqpG_0ao0LLVi5ViWFfmJpzdwC9PK9__3PJHbFgzC5-tKAhJFq8isQ1mq7_jb_FHxY3pKJIG3hYmMy7aTxioM9MhSoInM15glWMF0Hi-rpCsjVH5ZmT-QLmYOHw8Pd6IXCrnrDnaMqX3W4HMao6YbAfLBy5g6Wt9tx0-bj7cvnexdW_DL7BNxaN-CTI6N9sl_hKPR4\" data-alt=\"abstract person avatar in a minimalist style with neutral colors\" class=\"border-2 border-black h-8 rounded-full w-8\"><img data-alt=\"abstract person avatar in a minimalist style with warm colors\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuD7DwlOQGZ_tcOvEhkcFYU8TsNEdiU6eGuDuB4uUyXTX3xO7qiKMBXpKdmIM5T2SFxngbo1fP3Oc9VjH7QAUPwPST05O5N6pKFiny7EHQRuLMcIlPnxgeJTc3KLDWtn5lF2qPa4KH-eNxXQhVA6KbSlPz39_6x7oftT5WfHU9bSPmADEq6z9gjigAthPJCKP6kUJbgk0eP27_mXaPIvvmfcQzT6wu8p8-D9iUxsSivaEjjKwiSjPknjDmHEP0pYuIV9eoLvPif5AbIC\" class=\"border-2 border-black h-8 rounded-full w-8\"><div class=\"bg-surface-container border-2 border-black flex font-bold h-8 items-center justify-center rounded-full text-[10px] w-8\">+12</div></div><div class=\"bg-white/10 h-8 mx-2 w-px\"></div><span class=\"font-mono text-neutral-500 text-xs tracking-widest uppercase\">System Status: Nominal</span></div></header>"
  }

  section features cols:1 {
    item "Compute Cluster Alpha" icon:memory {
      "High-performance processing unit"
      label "Active" role:child style:mono
    }
    item "Obsidian Core DB" icon:database {
      "Persistent storage & indexing"
      label "Synced" role:child style:mono
    }
    item "Global Mesh Network" icon:lan {
      "Traffic routing & CDN"
      label "Balancing" role:child style:mono
    }
    template "<section class=\"gap-6 grid grid-cols-1 mb-12 md:grid-cols-3\"><div class=\"bg-surface-container-low border border-white/5 ethereal-glow group hover:border-white/20 p-6 rounded-xl transition-all\"><div class=\"flex items-start justify-between mb-8\"><div class=\"bg-white/5 p-2 rounded-lg\"><span class=\"material-symbols-outlined text-white\">memory</span></div><span class=\"bg-green-400/10 font-mono px-2 py-0.5 rounded text-[10px] text-green-400 uppercase\">Active</span></div><h3 class=\"font-bold mb-1 text-sm text-white\">Compute Cluster Alpha</h3><p class=\"mb-6 text-on-surface-variant text-xs\">High-performance processing unit</p><div class=\"space-y-4\"><div><div class=\"flex justify-between mb-1 text-[10px] tracking-tighter uppercase\"><span>CPU Usage</span><span class=\"text-white\">64%</span></div><div class=\"bg-white/10 h-1 overflow-hidden rounded-full w-full\"><div class=\"bg-white duration-1000 h-full transition-all w-[64%]\"></div></div></div><div><div class=\"flex justify-between mb-1 text-[10px] tracking-tighter uppercase\"><span>RAM Capacity</span><span class=\"text-white\">42%</span></div><div class=\"bg-white/10 h-1 overflow-hidden rounded-full w-full\"><div class=\"bg-white duration-1000 h-full transition-all w-[42%]\"></div></div></div></div></div><div class=\"bg-surface-container-low border border-white/5 ethereal-glow group hover:border-white/20 p-6 rounded-xl transition-all\"><div class=\"flex items-start justify-between mb-8\"><div class=\"bg-white/5 p-2 rounded-lg\"><span class=\"material-symbols-outlined text-white\">database</span></div><span class=\"bg-green-400/10 font-mono px-2 py-0.5 rounded text-[10px] text-green-400 uppercase\">Synced</span></div><h3 class=\"font-bold mb-1 text-sm text-white\">Obsidian Core DB</h3><p class=\"mb-6 text-on-surface-variant text-xs\">Persistent storage & indexing</p><div class=\"space-y-4\"><div><div class=\"flex justify-between mb-1 text-[10px] tracking-tighter uppercase\"><span>Storage IOPS</span><span class=\"text-white\">12.4k</span></div><div class=\"bg-white/10 h-1 overflow-hidden rounded-full w-full\"><div class=\"bg-white duration-1000 h-full transition-all w-[82%]\"></div></div></div><div><div class=\"flex justify-between mb-1 text-[10px] tracking-tighter uppercase\"><span>Query Latency</span><span class=\"text-white\">14ms</span></div><div class=\"bg-white/10 h-1 overflow-hidden rounded-full w-full\"><div class=\"bg-white duration-1000 h-full transition-all w-[14%]\"></div></div></div></div></div><div class=\"bg-surface-container-low border border-white/5 ethereal-glow group hover:border-white/20 p-6 rounded-xl transition-all\"><div class=\"flex items-start justify-between mb-8\"><div class=\"bg-white/5 p-2 rounded-lg\"><span class=\"material-symbols-outlined text-white\">lan</span></div><span class=\"bg-white/5 font-mono px-2 py-0.5 rounded text-[10px] text-white/50 uppercase\">Balancing</span></div><h3 class=\"font-bold mb-1 text-sm text-white\">Global Mesh Network</h3><p class=\"mb-6 text-on-surface-variant text-xs\">Traffic routing & CDN</p><div class=\"space-y-4\"><div><div class=\"flex justify-between mb-1 text-[10px] tracking-tighter uppercase\"><span>Throughput</span><span class=\"text-white\">1.2 GB/s</span></div><div class=\"bg-white/10 h-1 overflow-hidden rounded-full w-full\"><div class=\"bg-white duration-1000 h-full transition-all w-[55%]\"></div></div></div><div><div class=\"flex justify-between mb-1 text-[10px] tracking-tighter uppercase\"><span>Error Rate</span><span class=\"text-white\">0.02%</span></div><div class=\"bg-white/10 h-1 overflow-hidden rounded-full w-full\"><div class=\"bg-white duration-1000 h-full transition-all w-[2%]\"></div></div></div></div></div></section>"
  }

  section features cols:1 {
    item "Node Topology" icon:hub span:8 {
      "LIVE PACKET STREAM"
      label "LIVE PACKET STREAM" role:child style:mono
      label "ACK_092 READY" role:child style:mono
      label "SYN_114 PENDING" role:child style:mono
      label "PSH_551 ROUTING" role:child style:mono
      chip "PRISM PRISM Main Hub Main Hub" role:child
    }
    item "Global Config" icon:tune span:4 {
      "Enhanced Encryption"
      label "Primary Deployment Region" role:child style:mono
      label "Auto-Scaling Nodes" role:child style:mono
      label "Event Stream" role:child style:mono
    }
    template "<div class=\"gap-8 grid grid-cols-1 items-start xl:grid-cols-12\"><div class=\"bg-surface-container-low border border-white/5 ethereal-glow flex flex-col min-h-[500px] overflow-hidden rounded-xl xl:col-span-8\"><div class=\"bg-black/20 border-b border-white/5 flex items-center justify-between p-6\"><h2 class=\"flex font-bold gap-2 items-center text-sm text-white\"><span class=\"material-symbols-outlined text-sm\">hub</span> Node Topology          </h2><div class=\"flex gap-2\"><button class=\"bg-white/5 border border-white/10 hover:bg-white/10 px-3 py-1 rounded text-xs transition-colors\">2D View</button><button class=\"bg-white font-bold px-3 py-1 rounded text-black text-xs\">Spatial</button></div></div><div class=\"bg-[#000000] flex flex-grow items-center justify-center overflow-hidden p-12 relative\"><div style=\"background-image: radial-gradient(rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 20px 20px;\" class=\"absolute inset-0 opacity-20\"></div><div class=\"aspect-square flex items-center justify-center max-w-lg relative w-full\"><div class=\"backdrop-blur-md bg-white/5 border-2 border-white/20 flex h-32 items-center justify-center rounded-full w-32 z-10\"><div class=\"text-center\"><div class=\"font-bold text-white text-xl\">PRISM</div><div class=\"text-[8px] text-neutral-500 tracking-widest uppercase\">Main Hub</div></div></div><div class=\"absolute bg-black border border-white/20 flex h-12 items-center justify-center left-1/4 rounded-lg top-0 w-12\"><span class=\"material-symbols-outlined text-lg text-white\">router</span></div><div class=\"absolute bg-black border border-white/20 bottom-10 flex h-12 items-center justify-center right-0 rounded-lg w-12\"><span class=\"material-symbols-outlined text-lg text-white\">dns</span></div><div class=\"absolute bg-black border border-white/20 bottom-20 flex h-12 items-center justify-center left-10 rounded-lg w-12\"><span class=\"material-symbols-outlined text-lg text-white\">terminal</span></div><svg viewBox=\"0 0 100 100\" class=\"absolute h-full inset-0 opacity-30 pointer-events-none w-full\"><line x1=\"50\" stroke=\"white\" x2=\"25\" stroke-width=\"0.5\" y1=\"50\" y2=\"10\" stroke-dasharray=\"2,2\"></line><line y1=\"50\" stroke-dasharray=\"2,2\" x2=\"90\" y2=\"85\" stroke=\"white\" stroke-width=\"0.5\" x1=\"50\"></line><line y2=\"75\" x2=\"15\" stroke=\"white\" stroke-width=\"0.5\" x1=\"50\" stroke-dasharray=\"2,2\" y1=\"50\"></line></svg></div><div class=\"absolute backdrop-blur-md bg-white/5 border border-white/10 max-w-[200px] p-3 right-10 rounded-lg top-10\"><p class=\"font-mono mb-2 text-[10px] text-white/40\">LIVE PACKET STREAM</p><div class=\"space-y-1\"><div class=\"flex font-mono justify-between text-[9px] text-green-400\"><span>ACK_092</span><span>READY</span></div><div class=\"flex font-mono justify-between text-[9px] text-white/60\"><span>SYN_114</span><span>PENDING</span></div><div class=\"flex font-mono justify-between text-[9px] text-white/60\"><span>PSH_551</span><span>ROUTING</span></div></div></div></div></div><div class=\"space-y-6 xl:col-span-4\"><div class=\"bg-surface-container-low border border-white/5 ethereal-glow p-6 rounded-xl\"><h2 class=\"flex font-bold gap-2 items-center mb-6 text-sm text-white\"><span class=\"material-symbols-outlined text-sm\">tune</span> Global Config          </h2><div class=\"space-y-6\"><div><label class=\"block font-mono mb-3 text-[10px] text-neutral-500 tracking-widest uppercase\">Primary Deployment Region</label><div class=\"gap-2 grid grid-cols-2\"><button class=\"active:scale-95 bg-white font-bold py-2 rounded-lg text-black text-xs transition-transform\">US-EAST-1</button><button class=\"bg-white/5 border border-white/10 hover:bg-white/10 py-2 rounded-lg text-white text-xs transition-colors\">EU-WEST-2</button><button class=\"bg-white/5 border border-white/10 hover:bg-white/10 py-2 rounded-lg text-white text-xs transition-colors\">AP-SOUTH-1</button><button class=\"bg-white/5 border border-white/10 hover:bg-white/10 py-2 rounded-lg text-white text-xs transition-colors\">SA-EAST-1</button></div></div><div><div class=\"flex items-center justify-between mb-3\"><label class=\"font-mono text-[10px] text-neutral-500 tracking-widest uppercase\">Auto-Scaling Nodes</label><span class=\"font-bold text-white text-xs\">12 Units</span></div><div class=\"bg-white/10 h-1 relative rounded-full w-full\"><div class=\"-top-1 absolute bg-white border-2 border-black cursor-pointer h-3 left-[60%] rounded-full shadow-lg w-3\"></div><div class=\"bg-white h-full rounded-full w-[60%]\"></div></div><div class=\"flex justify-between mt-2\"><span class=\"text-[9px] text-neutral-600\">Min: 2</span><span class=\"text-[9px] text-neutral-600\">Max: 32</span></div></div><div class=\"border-t border-white/5 pt-4 space-y-4\"><div class=\"flex items-center justify-between\"><div><p class=\"font-bold text-white text-xs\">Enhanced Encryption</p><p class=\"text-[10px] text-neutral-500\">AES-256-GCM Layer</p></div><div class=\"bg-white flex h-5 items-center px-1 rounded-full w-10\"><div class=\"bg-black h-3 ml-auto rounded-full w-3\"></div></div></div><div class=\"flex items-center justify-between\"><div><p class=\"font-bold text-white text-xs\">Intrusion Detection</p><p class=\"text-[10px] text-neutral-500\">Real-time heuristics</p></div><div class=\"bg-white/10 border border-white/5 flex h-5 items-center px-1 rounded-full w-10\"><div class=\"bg-neutral-600 h-3 rounded-full w-3\"></div></div></div></div><button class=\"font-black hover:opacity-90 mt-4 prism-gradient py-3 rounded-lg shadow-xl text-black text-xs tracking-tighter transition-opacity uppercase w-full\">Apply Changes</button></div></div><div class=\"bg-surface-container-low border border-white/5 ethereal-glow overflow-hidden p-4 rounded-xl\"><h2 class=\"font-mono mb-4 text-[10px] text-neutral-500 tracking-widest uppercase\">Event Stream</h2><div class=\"space-y-3\"><div class=\"flex gap-3 text-[10px]\"><span class=\"text-neutral-600\">14:21:03</span><span class=\"font-mono text-white\">NODE_REBALANCED</span><span class=\"ml-auto text-green-500\">OK</span></div><div class=\"flex gap-3 text-[10px]\"><span class=\"text-neutral-600\">14:19:55</span><span class=\"font-mono text-white\">SNAPSHOT_SYNC</span><span class=\"ml-auto text-green-500\">OK</span></div><div class=\"flex gap-3 text-[10px]\"><span class=\"text-neutral-600\">14:15:22</span><span class=\"font-mono text-white\">THROTTLE_WARN</span><span class=\"ml-auto text-error\">WRN</span></div></div></div></div></div>"
  }

}
