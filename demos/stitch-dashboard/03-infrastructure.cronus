page "/infrastructure" type:dashboard requires:auth {
  title "Infrastructure Config"

  section page-header {
    title "Infrastructure Config"
    subtitle "Precision monitoring and scaling controls for distributed clusters."
  }

  section kpi cols:4 {
    bind Node { query count }
    item "Registered Nodes" value:bind icon:dns
  }

  section kpi cols:4 {
    bind Node { query count where status eq "active" }
    item "Online" value:bind icon:check_circle
  }

  section progress {
    title "Node Topology"
    bind Node { query all order name asc }
  }

  section table {
    title "Cluster Nodes"
    bind Node { query all order name asc }
    columns "name, location, load, uptime, status"
    search true
  }

  section chart {
    title "Cluster Load"
    bind Node { query all }
    chart_type bar
  }
}
