page "/settings" type:custom {
  section topbar {
    brand "Obsidian Prism"
    image "Avatar" src:"https://lh3.googleusercontent.com/aida-public/AB6AXuBlW2PAP5RmGDtnCNXjl5h8-mNCcs4twiLiXzemrKcKHsWX9I8rOhK489EoE2VP_iAwhwK6RCaNADULiTReTo7tD1b8KLTmpMyunztHHLbJc1BI2wGfs_aZvwvq8rK93TRQ_OzreLrFIGN8Dlu2Qz2GSztArbiPyKSnW2IidNsi1seFyOl28xR-TgGYg50yew5WAjI9lTYw5ebWmC9zsmB6NPKUG8zzBYiSgLJxpje_VMc-5t0_03nl8ZYcxmhH_Bx5gai11Rl1atJx"
    template "<nav class=\"backdrop-blur-xl bg-black/60 border-b border-white/10 fixed flex font-['Inter'] h-16 items-center justify-between px-6 text-white top-0 tracking-tighter w-full z-50\"><div class=\"flex gap-8 items-center\"><span class=\"font-bold text-white text-xl tracking-tighter\">Obsidian Prism</span><div class=\"hidden items-center md:flex space-x-6 text-sm\"><a href=\"/\" class=\"duration-300 hover:bg-white/10 px-3 py-1 rounded-lg text-neutral-400 transition-all\">Dashboard</a><a href=\"/security\" class=\"duration-300 hover:bg-white/10 px-3 py-1 rounded-lg text-neutral-400 transition-all\">Vault</a><a href=\"/settings\" class=\"border-b border-white font-bold px-3 py-1 text-white\">Settings</a></div></div><div class=\"flex gap-4 items-center\"><div class=\"group relative\"><span data-icon=\"notifications\" class=\"cursor-pointer hover:text-white material-symbols-outlined text-neutral-400 transition-colors\">notifications</span><span class=\"absolute bg-white h-2 right-0 rounded-full top-0 w-2\"></span></div><span data-icon=\"settings\" class=\"cursor-pointer hover:text-white material-symbols-outlined text-neutral-400 transition-colors\">settings</span><div class=\"bg-surface-container-high border border-white/10 h-8 overflow-hidden rounded-full w-8\"><img data-alt=\"professional close-up portrait of a man with clean aesthetic and soft studio lighting on dark background\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBlW2PAP5RmGDtnCNXjl5h8-mNCcs4twiLiXzemrKcKHsWX9I8rOhK489EoE2VP_iAwhwK6RCaNADULiTReTo7tD1b8KLTmpMyunztHHLbJc1BI2wGfs_aZvwvq8rK93TRQ_OzreLrFIGN8Dlu2Qz2GSztArbiPyKSnW2IidNsi1seFyOl28xR-TgGYg50yew5WAjI9lTYw5ebWmC9zsmB6NPKUG8zzBYiSgLJxpje_VMc-5t0_03nl8ZYcxmhH_Bx5gai11Rl1atJx\" class=\"h-full object-cover w-full\"></div></div></nav>"
    style_block "     body {       background-color: #000000;       background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.05) 1px, transparent 0);       background-size: 40px 40px;       color: #ffffff;       font-family: 'Inter', sans-serif;     }     .material-symbols-outlined {       font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;     }     .prism-blur {       backdrop-filter: blur(20px);       -webkit-backdrop-filter: blur(20px);     }     .glass-panel {       background: rgba(255, 255, 255, 0.03);       border: 1px solid rgba(255, 255, 255, 0.08);       backdrop-filter: blur(12px);     }   "
  }

  section sidebar {
    brand "Obsidian"
    subtitle "Premium Suite"
    item "Dashboard" -> "/" icon:dashboard
    item "Analytics" -> "/analytics" icon:monitoring
    item "Portfolio" -> "/infrastructure" icon:account_balance_wallet
    item "Vault" -> "/security" icon:lock
    item "Reports" -> "/settings" icon:description active:true
    item "Support" -> "/docs" icon:help position:bottom
    item "Logout" -> "/docs" icon:logout position:bottom
    action "Upgrade to Prism Upgrade to Prism" -> "#"
    template "<aside class=\"bg-[#131313] border-r border-white/5 fixed flex flex-col h-full left-0 p-4 pt-20 space-y-2 top-0 w-64 z-40\"><div class=\"mb-8 px-2\"><h2 class=\"font-black text-2xl text-white tracking-tighter\">Obsidian</h2><p class=\"text-neutral-500 text-xs tracking-widest uppercase\">Premium Suite</p></div><nav class=\"flex flex-1 flex-col space-y-1\"><a href=\"/\" class=\"flex gap-3 group hover:bg-white/5 hover:text-white items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span data-icon=\"dashboard\" class=\"material-symbols-outlined\">dashboard</span><span class=\"font-['Inter'] text-sm tracking-tight\">Dashboard</span></a><a href=\"/analytics\" class=\"flex gap-3 group hover:bg-white/5 hover:text-white items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span data-icon=\"monitoring\" class=\"material-symbols-outlined\">monitoring</span><span class=\"font-['Inter'] text-sm tracking-tight\">Analytics</span></a><a href=\"/infrastructure\" class=\"flex gap-3 group hover:bg-white/5 hover:text-white items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span data-icon=\"account_balance_wallet\" class=\"material-symbols-outlined\">account_balance_wallet</span><span class=\"font-['Inter'] text-sm tracking-tight\">Portfolio</span></a><a href=\"/security\" class=\"flex gap-3 group hover:bg-white/5 hover:text-white items-center px-4 py-3 rounded-lg text-neutral-500 transition-colors\"><span data-icon=\"lock\" class=\"material-symbols-outlined\">lock</span><span class=\"font-['Inter'] text-sm tracking-tight\">Vault</span></a><a href=\"/settings\" class=\"bg-white flex gap-3 group items-center px-4 py-3 rounded-lg shadow-[0_0_15px_rgba(255,255,255,0.1)] text-black\"><span data-icon=\"description\" class=\"material-symbols-outlined\">description</span><span class=\"font-['Inter'] font-bold text-sm tracking-tight\">Reports</span></a></nav><div class=\"border-t border-white/5 flex flex-col pt-4 space-y-1\"><button class=\"bg-white font-bold hover:scale-[0.98] mb-4 py-3 rounded-lg text-black text-sm transition-transform w-full\">Upgrade to Prism</button><a href=\"/docs\" class=\"flex gap-3 hover:text-white items-center px-4 py-2 text-neutral-500 transition-colors\"><span data-icon=\"help\" class=\"material-symbols-outlined scale-75\">help</span><span class=\"text-sm\">Support</span></a><a href=\"/docs\" class=\"flex gap-3 hover:text-white items-center px-4 py-2 text-neutral-500 transition-colors\"><span data-icon=\"logout\" class=\"material-symbols-outlined scale-75\">logout</span><span class=\"text-sm\">Logout</span></a></div></aside>"
  }

  section page-header {
    title "System Settings"
    subtitle "Configure your Obsidian Prism experience. Changes are synchronized across all high-fidelity instances."
    template "<header class=\"mb-12\"><h1 class=\"font-black mb-2 text-5xl tracking-tighter\">{{title}}</h1><p class=\"font-light max-w-2xl text-on-surface-variant\">{{subtitle}}</p></header>"
  }

  section features cols:1 {
    item "Alexander Vance" icon:photo_camera span:8 {
      "Lead Architect • alex.vance@obsidian.io"
    }
    image "high resolution detail portrait of a focused professional in a modern dark studio setting" role:child src:"https://lh3.googleusercontent.com/aida-public/AB6AXuAqK_Z2t6lVKyvJWPJHVa6ta2UvrKAntXDf5EJpHG0vy4HNO5V4_1L9Xwx7OeXZolqDp14aFPFtRMAg9yQRsDRVBkKohC9I-zcJ8rRuDrfKoVDEM1Gwj8AJRBMgogC1ITKsffk5CUbDgdpNJAQY7-g7ScxZ7NghufJqQ4n8b0cjC7VFlGGecAcOtbHlErW4L7OF4Ifnm_aqTmekCBOp65ygDFwZZcGFfjSibtyqEA-wWFBytmkikhQC_mwukjTMYDJpfrvP8UiyYXji"
    item "Visual Environment" span:4 {
      "Obsidian Mode"
    }
    template "<div class=\"gap-8 grid grid-cols-1 lg:grid-cols-12\"><section class=\"lg:col-span-8 space-y-8\"><div class=\"glass-panel p-8 rounded-xl\"><div class=\"flex flex-col gap-8 items-center mb-8 md:flex-row\"><div class=\"group relative\"><div class=\"border-2 border-white/20 duration-500 group-hover:border-white h-32 overflow-hidden rounded-full transition-all w-32\"><img data-alt=\"high resolution detail portrait of a focused professional in a modern dark studio setting\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAqK_Z2t6lVKyvJWPJHVa6ta2UvrKAntXDf5EJpHG0vy4HNO5V4_1L9Xwx7OeXZolqDp14aFPFtRMAg9yQRsDRVBkKohC9I-zcJ8rRuDrfKoVDEM1Gwj8AJRBMgogC1ITKsffk5CUbDgdpNJAQY7-g7ScxZ7NghufJqQ4n8b0cjC7VFlGGecAcOtbHlErW4L7OF4Ifnm_aqTmekCBOp65ygDFwZZcGFfjSibtyqEA-wWFBytmkikhQC_mwukjTMYDJpfrvP8UiyYXji\" class=\"h-full object-cover w-full\"></div><button class=\"absolute bg-white bottom-0 hover:scale-110 p-2 right-0 rounded-full shadow-xl text-black transition-transform\"><span data-icon=\"photo_camera\" class=\"material-symbols-outlined text-sm\">photo_camera</span></button></div><div class=\"flex-1 md:text-left text-center\"><h3 class=\"font-bold mb-1 text-2xl tracking-tight\">Alexander Vance</h3><p class=\"mb-4 text-on-surface-variant text-sm\">Lead Architect • alex.vance@obsidian.io</p><div class=\"flex flex-wrap gap-3 justify-center md:justify-start\"><button class=\"bg-primary font-bold hover:opacity-90 px-6 py-2 rounded-lg text-black text-sm transition-opacity\">Update Avatar</button><button class=\"bg-white/5 border border-white/10 font-medium hover:bg-white/10 px-6 py-2 rounded-lg text-sm text-white transition-all\">Remove</button></div></div></div><div class=\"gap-6 grid grid-cols-1 md:grid-cols-2\"><div class=\"space-y-2\"><label class=\"font-bold px-1 text-on-surface-variant text-xs tracking-widest uppercase\">Display Name</label><input type=\"text\" value=\"Alexander Vance\" class=\"bg-surface-container-lowest border border-outline-variant/10 focus:border-primary/50 focus:outline-none focus:ring-1 focus:ring-primary/20 px-4 py-3 rounded-lg text-white transition-all w-full\"></div><div class=\"space-y-2\"><label class=\"font-bold px-1 text-on-surface-variant text-xs tracking-widest uppercase\">Email Address</label><input type=\"email\" value=\"alex.vance@obsidian.io\" class=\"bg-surface-container-lowest border border-outline-variant/10 focus:border-primary/50 focus:outline-none focus:ring-1 focus:ring-primary/20 px-4 py-3 rounded-lg text-white transition-all w-full\"></div></div></div><div class=\"glass-panel p-8 rounded-xl\"><div class=\"flex items-end justify-between mb-6\"><div><h3 class=\"font-bold text-xl tracking-tight\">API Infrastructure</h3><p class=\"text-on-surface-variant text-sm\">Manage your secure access tokens for Prism integration.</p></div><button class=\"flex font-bold gap-2 hover:underline items-center text-sm text-white\"><span data-icon=\"add\" class=\"material-symbols-outlined text-sm\">add</span>              Generate New Key            </button></div><div class=\"space-y-4\"><div class=\"bg-surface-container-low flex group items-center justify-between p-4 rounded-lg\"><div class=\"flex gap-4 items-center\"><div class=\"bg-white/5 flex h-10 items-center justify-center rounded w-10\"><span data-icon=\"terminal\" class=\"material-symbols-outlined text-neutral-400\">terminal</span></div><div><p class=\"font-bold text-sm\">Production_Main_Vault</p><p class=\"text-neutral-500 text-xs\">Last used 2 hours ago • obs_live_••••••••3982</p></div></div><div class=\"flex gap-2 group-hover:opacity-100 items-center opacity-0 transition-opacity\"><button class=\"hover:bg-white/10 p-2 rounded-lg transition-colors\"><span data-icon=\"content_copy\" class=\"material-symbols-outlined text-sm\">content_copy</span></button><button class=\"hover:bg-error/20 hover:text-error p-2 rounded-lg transition-colors\"><span data-icon=\"delete\" class=\"material-symbols-outlined text-sm\">delete</span></button></div></div><div class=\"bg-surface-container-low flex group items-center justify-between p-4 rounded-lg\"><div class=\"flex gap-4 items-center\"><div class=\"bg-white/5 flex h-10 items-center justify-center rounded w-10\"><span data-icon=\"science\" class=\"material-symbols-outlined text-neutral-400\">science</span></div><div><p class=\"font-bold text-sm\">Development_Sandbox</p><p class=\"text-neutral-500 text-xs\">Created 14 days ago • obs_test_••••••••9120</p></div></div><div class=\"flex gap-2 group-hover:opacity-100 items-center opacity-0 transition-opacity\"><button class=\"hover:bg-white/10 p-2 rounded-lg transition-colors\"><span data-icon=\"content_copy\" class=\"material-symbols-outlined text-sm\">content_copy</span></button><button class=\"hover:bg-error/20 hover:text-error p-2 rounded-lg transition-colors\"><span data-icon=\"delete\" class=\"material-symbols-outlined text-sm\">delete</span></button></div></div></div></div></section><aside class=\"lg:col-span-4 space-y-8\"><div class=\"glass-panel p-6 rounded-xl\"><h3 class=\"font-bold mb-6 text-lg\">Visual Environment</h3><div class=\"space-y-6\"><div class=\"flex items-center justify-between\"><div><p class=\"font-medium text-sm\">Obsidian Mode</p><p class=\"text-[10px] text-neutral-500\">Fixed dark environment</p></div><div class=\"bg-primary h-6 relative rounded-full transition-all w-12\"><div class=\"absolute bg-black h-4 right-1 rounded-full top-1 w-4\"></div></div></div><div class=\"flex items-center justify-between\"><div><p class=\"font-medium text-sm\">Motion Sensitivity</p><p class=\"text-[10px] text-neutral-500\">Reduce structural transitions</p></div><div class=\"bg-surface-container-highest h-6 relative rounded-full transition-all w-12\"><div class=\"absolute bg-neutral-400 h-4 left-1 rounded-full top-1 w-4\"></div></div></div><div class=\"border-t border-white/10 pt-4\"><p class=\"font-bold mb-4 text-on-surface-variant text-xs tracking-widest uppercase\">Display Density</p><div class=\"gap-2 grid grid-cols-3\"><button class=\"bg-white font-bold py-2 rounded text-[10px] text-black\">Compact</button><button class=\"bg-white/5 border border-white/10 font-bold hover:bg-white/10 py-2 rounded text-[10px]\">Balanced</button><button class=\"bg-white/5 border border-white/10 font-bold hover:bg-white/10 py-2 rounded text-[10px]\">Spacious</button></div></div></div></div><div class=\"glass-panel p-6 rounded-xl\"><h3 class=\"font-bold mb-6 text-lg\">Alert Dispatch</h3><div class=\"space-y-4\"><label class=\"cursor-pointer flex gap-4 group items-start\"><div class=\"mt-1\"><div class=\"border-2 border-white/30 flex group-hover:border-white h-5 items-center justify-center rounded transition-all w-5\"><div class=\"bg-white h-2 rounded-sm w-2\"></div></div></div><div><p class=\"font-medium text-sm\">Security Anomalies</p><p class=\"text-neutral-500 text-xs\">Immediate push for vault access attempts</p></div></label><label class=\"cursor-pointer flex gap-4 group items-start\"><div class=\"mt-1\"><div class=\"border-2 border-white/30 flex group-hover:border-white h-5 items-center justify-center rounded transition-all w-5\"><div class=\"bg-white h-2 rounded-sm w-2\"></div></div></div><div><p class=\"font-medium text-sm\">Analytics Reports</p><p class=\"text-neutral-500 text-xs\">Weekly performance and delta summaries</p></div></label><label class=\"cursor-pointer flex gap-4 group items-start\"><div class=\"mt-1\"><div class=\"border-2 border-white/30 flex group-hover:border-white h-5 items-center justify-center rounded transition-all w-5\"></div></div><div><p class=\"font-medium text-neutral-500 text-sm\">Product Updates</p><p class=\"text-neutral-600 text-xs\">Feature releases and system patches</p></div></label></div></div><div class=\"bg-error/5 border border-error/20 p-6 rounded-xl\"><h3 class=\"font-black mb-4 text-error text-sm tracking-widest uppercase\">Critical Actions</h3><div class=\"space-y-4\"><button class=\"border-b border-error/10 font-bold hover:text-error py-2 text-left text-xs transition-colors w-full\">Wipe System Cache</button><button class=\"border-b border-error/10 font-bold hover:text-error py-2 text-left text-xs transition-colors w-full\">Revoke All API Access</button><button class=\"-mx-2 font-bold hover:bg-error hover:text-white px-2 py-2 rounded text-error text-left text-xs transition-all w-full\">Terminate Obsidian ID</button></div></div></aside></div>"
  }

  section cta {
    cta "Discard Changes Discard Changes" -> "#" primary
    cta "Commit Configuration Commit Configuration" -> "#" secondary
    template "<footer class=\"flex gap-4 justify-end mt-16\"><button class=\"font-bold hover:text-white px-8 py-3 rounded-lg text-neutral-400 text-sm transition-colors\">Discard Changes</button><button class=\"active:scale-95 bg-primary font-black hover:scale-[1.02] px-8 py-3 rounded-lg shadow-[0_0_30px_rgba(255,255,255,0.15)] text-black text-sm tracking-tight transition-all\">Commit Configuration</button></footer>"
  }

}
