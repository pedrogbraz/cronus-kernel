page "/settings" type:custom requires:auth {
  title "System Settings"

  section page-header {
    title "System Settings"
    subtitle "Update your operator profile. Changes apply to this authenticated session."
  }

  section alert style:info {
    title "Account"
    subtitle "Name and email are stored on User. Password is never rendered."
  }

  section form {
    title "Profile"
    entity User
    bind User { query one }
    field "name" type:text required
    field "email" type:email required
    field "role" type:select options:["admin", "operator", "viewer"]
    on submit {
      update User
      toast "Profile saved" success
      refresh self
    }
  }
}
