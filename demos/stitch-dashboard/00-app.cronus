app "Obsidian Prism" {
  stack voodoo
  port 5210
  database sqlite "./data.db"
}

auth {
  entity User
  login email + password
  session jwt expires:24h
  roles [admin, operator, viewer]
}

style {
  theme dark
  preset midnight
  runtime voodoo
  font "Inter"
  radius 14px
}

layout Main {
  sidebar {
    brand "Obsidian"
    "Dashboard" -> "/" icon:dashboard
    "Analytics" -> "/analytics" icon:monitoring
    "Infrastructure" -> "/infrastructure" icon:dns
    "Vault" -> "/security" icon:lock
    "Settings" -> "/settings" icon:settings
  }
  topbar {
    search_placeholder:"Search nodes..."
  }
}

entity User {
  name string! searchable
  email email! unique
  password string! sensitive
  role enum [admin, operator, viewer] default:viewer
}

entity Node {
  name string! unique searchable
  location string!
  load number default:"0"
  uptime string default:"0%"
  status enum ["active", "inactive", "maintenance"]! default:"active"

  transition status {
    active -> maintenance
    active -> inactive
    maintenance -> active
    inactive -> active
  }
}

entity Session {
  source_id string!
  status enum ["active", "idle", "live"]! default:"active"
  session_length string!
  bounce_risk enum ["low", "medium", "high", "critical"]! default:"low"
  exit_page string
}

entity Metric {
  name string!
  value string!
  unit string
  trend enum ["up", "down", "stable"]! default:"stable"
  percentage string
}

entity SecurityEvent {
  event_type string!
  node string
  protocol string
  status string
  details text
}

api /nodes {
  list GET /nodes auth:jwt
  create POST /nodes auth:jwt
  detail GET /nodes/:id auth:jwt
  update PATCH /nodes/:id auth:jwt
  remove DELETE /nodes/:id auth:jwt
}

api /sessions {
  list GET /sessions auth:jwt
  create POST /sessions auth:jwt
}

api /metrics {
  list GET /metrics auth:jwt
  create POST /metrics auth:jwt
}

api /security-events {
  list GET /security-events auth:jwt
  create POST /security-events auth:jwt
}

api /users {
  list GET / auth:jwt
  detail GET /:id auth:jwt
  update PATCH /:id auth:jwt
}
