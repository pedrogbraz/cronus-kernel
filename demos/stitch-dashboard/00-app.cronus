app "Stitch Performance Dashboard" {
  stack react + tailwind
  port 5210
  database sqlite "./data.db"
  theme dark
}

auth {
  entity User
  login email + password
  session jwt expires:24h
}

style {
  theme dark
  accent #e2e2e2
  font "Inter"
}

tailwind_config "tailwind.config = { darkMode: \"class\", theme: { extend: { \"colors\": { \"on-primary-fixed\": \"#ffffff\", \"outline\": \"#919191\", \"outline-variant\": \"#474747\", \"on-tertiary-container\": \"#000000\", \"primary-container\": \"#d4d4d4\", \"on-primary-container\": \"#000000\", \"surface-variant\": \"#353535\", \"secondary-fixed-dim\": \"#adabaa\", \"primary-fixed\": \"#5d5f5f\", \"inverse-surface\": \"#e2e2e2\", \"surface-container\": \"#1f1f1f\", \"surface-dim\": \"#131313\", \"tertiary-container\": \"#909191\", \"secondary-container\": \"#474746\", \"surface-container-highest\": \"#353535\", \"on-tertiary-fixed-variant\": \"#e2e2e2\", \"on-error-container\": \"#ffdad6\", \"on-tertiary\": \"#1a1c1c\", \"surface-container-low\": \"#1b1b1b\", \"on-primary-fixed-variant\": \"#e2e2e2\", \"on-primary\": \"#1a1c1c\", \"error\": \"#ffb4ab\", \"on-secondary\": \"#1c1b1b\", \"surface-tint\": \"#c6c6c7\", \"primary\": \"#ffffff\", \"on-secondary-fixed-variant\": \"#3c3b3b\", \"surface-bright\": \"#393939\", \"tertiary-fixed-dim\": \"#454747\", \"surface-container-lowest\": \"#0e0e0e\", \"on-surface\": \"#e2e2e2\", \"primary-fixed-dim\": \"#454747\", \"secondary\": \"#c8c6c5\", \"tertiary-fixed\": \"#5d5f5f\", \"background\": \"#000000\", \"on-background\": \"#e2e2e2\", \"on-secondary-container\": \"#e5e2e1\", \"tertiary\": \"#e2e2e2\", \"surface-container-high\": \"#2a2a2a\", \"surface\": \"#131313\", \"on-error\": \"#690005\", \"on-surface-variant\": \"#c6c6c6\", \"inverse-on-surface\": \"#303030\", \"secondary-fixed\": \"#c8c6c5\", \"on-secondary-fixed\": \"#1c1b1b\", \"inverse-primary\": \"#5d5f5f\", \"on-tertiary-fixed\": \"#ffffff\", \"error-container\": \"#93000a\" }, \"borderRadius\": { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, \"fontFamily\": { \"headline\": [\"Inter\"], \"body\": [\"Inter\"], \"label\": [\"Inter\"] } }, }, }"

entity Node {
  name string! unique
  location string!
  load number default:"0"
  uptime string default:"0%"
  status enum ["active", "inactive", "maintenance"]! default:"active"

  transition status {
    active -> maintenance
    active -> inactive
    maintenance -> active
    inactive -> active
  }
}

entity Session {
  source_id string!
  status enum ["active", "idle", "live"]! default:"active"
  session_length string!
  bounce_risk enum ["low", "medium", "high", "critical"]! default:"low"
  exit_page string
}

entity Metric {
  name string!
  value string!
  unit string
  trend enum ["up", "down", "stable"]! default:"stable"
  percentage string
}

entity SecurityEvent {
  event_type string!
  node string
  protocol string
  status string
  details text
}

api /nodes {
  list GET /nodes auth:jwt
  create POST /nodes auth:jwt
  detail GET /nodes/:id auth:jwt
  update PATCH /nodes/:id auth:jwt
  remove DELETE /nodes/:id auth:jwt
}

api /sessions {
  list GET /sessions auth:jwt
  create POST /sessions auth:jwt
}

api /metrics {
  list GET /metrics auth:jwt
  create POST /metrics auth:jwt
}

api /security-events {
  list GET /security-events auth:jwt
  create POST /security-events auth:jwt
}
