page "/analytics" type:dashboard requires:auth {
  title "Analytics Deep-Dive"

  section page-header {
    title "Analytics Deep-Dive"
    subtitle "Session vectors, bounce risk, and metric trends from live traffic."
  }

  section kpi cols:4 {
    bind Session { query count }
    item "Sessions" value:bind icon:monitoring
  }

  section kpi cols:4 {
    bind Metric { query count }
    item "Metrics" value:bind icon:insights
  }

  section chart {
    title "Time-Series Performance"
    bind Metric { query all }
    chart_type bar
  }

  section table {
    title "Active Sessions"
    bind Session { query all order source_id asc }
    columns "source_id, status, session_length, bounce_risk, exit_page"
    search true
  }

  section table {
    title "Metrics"
    bind Metric { query all order name asc }
    columns "name, value, unit, trend, percentage"
    search true
  }
}
