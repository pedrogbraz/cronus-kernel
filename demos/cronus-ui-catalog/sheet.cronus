page "/sheet" type:components family:sheet {
  title "Sheet"
  description:"Panel that slides in from any edge of the screen."
}

component Top layout:inline style:sheet+top trigger:"Top" description:"This panel slides in from the top edge. Press Escape or click outside to dismiss it." group:"Sides" note:"A panel that slides in from any edge of the screen." {
  label "Top sheet"
  field "Quick note" placeholder:"Type something…"
  action "Done"
}
