## Cronus UI catalog: every family declared in .cronus, one file per family.
## The kernel emits the HTML, tokens and motion. No JSX, no imports.

app "Cronus UI" {
  port 5311
}

style {
  theme dark
  preset neutral
}

page "/" type:custom {
  title "Cronus UI"
  section hero {
    title "Cronus UI, declared"
    subtitle "Every component of the React catalog written as .cronus. Same tokens, same motion, rendered by the kernel."
    cta_text "Open kit"
    cta_link "/kit"
  }
}

page "/kit" type:components {
  title "Kit"
}
