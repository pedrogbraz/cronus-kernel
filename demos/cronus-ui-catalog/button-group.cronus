page "/button-group" type:components family:button-group {
  title "ButtonGroup"
  description:"Attaches a row or column of buttons into one segmented unit."
}

component Pager layout:inline style:button-group+outline aria-label:"Pages" group:"Horizontal" note:"Wrap a row of buttons in a group and they fuse into one segmented control: shared edges collapse and inner radii flatten." {
  item "Prev" icon:chevron-left
  item "Page 1"
  item "Next" icon-end:chevron-right
}

component Alignment layout:inline style:button-group+outline+vertical aria-label:"Alignment" group:"Vertical" {
  item "Left" icon:align-left
  item "Center" icon:align-center
  item "Right" icon:align-right
}
