page "/number-flow" type:components family:number-flow {
  title "NumberFlow"
  description:"Formatted number whose digits roll to each new value."
}

component DigitFlow layout:inline style:number-flow value:12345 size:5xl group:"Digit flow" note:"Each digit rolls the short way to the next value: grouping, prefix and suffix stay put. Shuffle through number, currency, percent and decimal." {
  label "Digits"
  action "Shuffle format" variant:outline size:sm icon:rotate-cw
}

component Currency layout:inline style:number-flow value:19348.43 prefix:"$" format:currency size:5xl group:"Currency" note:"Two fraction digits, prefix for the symbol. Click to increment and watch the ones place roll." {
  label "Revenue"
  action "Update value" variant:outline size:sm
}
