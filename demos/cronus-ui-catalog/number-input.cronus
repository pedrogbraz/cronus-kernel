page "/number-input" type:components family:number-input {
  title "NumberInput"
  description:"Spinbutton with increment/decrement steppers."
}

component Quantity layout:stack style:number-input value:1 min:0 max:10 aria-label:"Quantity" group:"Default" note:"A spinbutton with increment/decrement steppers. Values are clamped to the bounds." { label "Quantity" }
component PriceNumber layout:stack style:number-input value:19.9 min:0 step:0.1 precision:2 prefix:"$" aria-label:"Price" group:"Precision & formatting" note:"Use precision for decimal rounding and format to display a unit such as currency." { label "Price" }
