  label "Revenue"
  value "$48,290"
  trend "+12.5%" tone:up
}
component MetricChurn layout:stack style:metric group:"Stat tiles" {
  label "Churn"
  value "2.1%"
  trend "-0.4%" tone:down
}
component MetricSessions layout:stack style:metric group:"Stat tiles" {
  label "Sessions"
