page "/gradient-border" type:components family:gradient-border {
  title "GradientBorder"
  description:"Aurora gradient border."
}

component ProPlan layout:stack style:gradient-border glow:true group:"With glow" note:"Pass `glow` to add a quiet shadow that draws the eye to a featured surface." {
  title "Pro plan"
  text "The hairline ring draws the eye to your highest-value surface."
