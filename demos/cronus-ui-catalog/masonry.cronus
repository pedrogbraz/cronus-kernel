page "/masonry" type:components family:masonry {
  title "Masonry"
  description:"A responsive CSS multi-column masonry layout for cards and images."
}

component MasonryCards layout:stack style:masonry columns:"1,2,3" group:"Responsive cards" note:"A pure CSS multi-column layout that flows items top-to-bottom, balancing columns regardless of card height. `columns` takes a responsive map and `gap` controls both axes — no JS measurement, no layout shift." {
  item "Onboarding" description:"Passwordless email code."
  item "Checkout" description:"Card and boleto with upsells that convert."
  item "Payouts" description:"Settled on a fixed schedule."
  item "Analytics" description:"Live revenue and conversion metrics."
  item "Members" description:"Grant and revoke access automatically."
  item "Notifications" description:"Push and email on every sale."
}
