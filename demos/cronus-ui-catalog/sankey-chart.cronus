page "/sankey-chart" type:components family:sankey-chart {
  title "SankeyChart"
  description:"Flow between nodes. Default and Motion variants."
}

component SankeyChartDefault layout:stack style:sankey-chart group:"Default" note:"Cronus flow between nodes." {
  label "Sankey chart of acquisition flow."
  item "Direct"
  item "Ads"
  item "Site"
  item "App"
  item "Paid"
  item "Churn"
  item "Direct -> Site" value:48
  item "Ads -> Site" value:32
  item "Site -> App" value:40
  item "Site -> Paid" value:24
  item "App -> Paid" value:28
  item "App -> Churn" value:12
  item "Paid -> Churn" value:8
}

component SankeyChartMotion layout:stack style:sankey-chart+motion aspect:"16 / 9" node-padding:24 node-width:16 labels:vertical line-cap:4 group:"Motion" note:"Flow chart with hoverable links and nodes." {
