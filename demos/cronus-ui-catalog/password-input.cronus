page "/password-input" type:components family:password-input {
  title "PasswordInput"
  description:"Password field with a show/hide toggle and an optional strength meter."
}

component Current layout:stack style:password-input group:"Default" note:"A password field with a built-in show/hide toggle." { text "Enter your password" }
component Strength layout:stack style:password-input strength:true group:"Strength meter" note:"showStrength renders a 4-segment meter and label that update from the value's length and character variety." { text "Create a password" }
