page "/form" type:components family:form {
  title "Form"
  description:"Validated form wired to a schema."
}

component Profile layout:stack style:form group:"Validated form" note:"A form with an email and a bio, each with its own message, and a submit button." {
  item "Email" type:email placeholder:"you@cronus.dev"
  item "Bio" textarea:true placeholder:"Tell us a bit about yourself…"
  action "Save profile"
}
