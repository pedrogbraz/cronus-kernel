page "/dynamic-island" type:components family:dynamic-island {
  title "DynamicIsland"
  description:"A compact live-activity pill that morphs between views."
}

component LiveActivity layout:inline style:dynamic-island group:"Live activity" note:"A compact pill that morphs between views. The dots are a tablist; the shell resizes with a spring." {
  item "Cronus" aria-label:"Idle"
  item "Shipping the surface" aria-label:"Now playing"
}
