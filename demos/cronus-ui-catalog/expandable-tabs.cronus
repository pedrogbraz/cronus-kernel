page "/expandable-tabs" type:components family:expandable-tabs {
  title "ExpandableTabs"
  description:"Icon tabs where the active item expands to reveal its label."
}

component ExpandingTabs layout:inline style:expandable-tabs group:"Expanding tabs" note:"Icon tabs where the active item expands to reveal its label. Inactive labels stay available to assistive tech." {
  item "Home" icon:home
  item "Search" icon:search
  item "Settings" icon:settings
}
