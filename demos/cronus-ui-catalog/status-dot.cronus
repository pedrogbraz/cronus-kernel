page "/status-dot" type:components family:status-dot {
  title "StatusDot"
  description:"Presence dot with pulse, optional label, and avatar-overlay anchoring."
}

component DotOnline layout:inline style:status-dot+online with-label:true group:"Statuses" note:"Presence dots across the semantic palette. `withLabel` renders the status text next to the dot; without it the label becomes the accessible name." { label "Online" }
component DotAway layout:inline style:status-dot+away with-label:true group:"Statuses" { label "Away" }
component DotBusy layout:inline style:status-dot+busy with-label:true group:"Statuses" { label "Busy" }
component DotOffline layout:inline style:status-dot+offline with-label:true group:"Statuses" { label "Offline" }
component DotDeploying layout:inline style:status-dot+info with-label:true group:"Statuses" { label "Deploying" }

component DotShadcnOnline layout:inline style:status-dot+online position:bottom-right ring:true aria-label:"@shadcn is online" avatar:"CN" src:"https://github.com/shadcn.png" alt:"@shadcn" group:"On an avatar" note:"Anchor the dot to a corner with `position` and add `ring` so it cuts out of the image. Wrap the avatar and the dot in a `relative` container." { label "Online" }
component DotAdaBusy layout:inline style:status-dot+busy position:bottom-right ring:true aria-label:"Ada is busy" avatar:"AL" group:"On an avatar" { label "Busy" }
component DotJeanOffline layout:inline style:status-dot+offline position:bottom-right ring:true aria-label:"Jean is offline" avatar:"JL" group:"On an avatar" { label "Offline" }

component DotLive layout:inline style:status-dot+error pulse:true with-label:true group:"Pulse & sizes" note:"`pulse` adds an expanding ping halo for live activity: it stays static under `prefers-reduced-motion`. Sizes run `xs` through `lg`." { label "Live" }
component DotStreaming layout:inline style:status-dot+success pulse:true with-label:true group:"Pulse & sizes" { label "Streaming" }
component DotExtraSmall layout:inline style:status-dot+xs aria-label:"Online (xs)" group:"Pulse & sizes" { label "Online" }
component DotSmall layout:inline style:status-dot+sm aria-label:"Online (sm)" group:"Pulse & sizes" { label "Online" }
component DotMedium layout:inline style:status-dot+md aria-label:"Online (md)" group:"Pulse & sizes" { label "Online" }
component DotLarge layout:inline style:status-dot+lg aria-label:"Online (lg)" group:"Pulse & sizes" { label "Online" }
