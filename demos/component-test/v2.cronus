app "Cronus Studio" {
  stack voodoo
  port 5231
  database sqlite "./demo.db"
}
style { theme dark  preset aurora  runtime voodoo  font "Inter"  radius 14px }
layout Main {
  sidebar {
    brand "Studio"
    "Widgets" -> "/" icon:widgets
    "Messages" -> "/messages" icon:chat
  }
}
entity Message {
  author string!
  note text!
}
api /messages { list GET / auth:public  create POST / auth:public }

component Save layout:inline style:button+primary+md { label "Save" }
component Ghost layout:inline style:button+ghost+md { label "Cancel" }
component Email layout:stack style:input { label "Email"  text "you@studio.app" }
component Agree layout:inline style:checkbox { label "I agree" }
component Live layout:inline style:switch { label "Live updates" }
component Volume layout:stack style:slider { label "Intensity"  value "70" }
component Tabs layout:stack style:tabs { tab "Overview"  tab "Activity"  tab "Settings" }
component Faq layout:stack style:accordion { item "What is Cronus"  item "How do tokens work" }

page "/" type:components {
  title "Studio"
}
page "/messages" type:custom {
  section kpi { bind Message { query count }  item "Messages" value:bind icon:chat }
  section table { title "Inbox"  bind Message { query all order created_at desc }  columns "author, note, created_at" }
  section form {
    title "New message"
    entity Message
    bind Message { query all }
    on submit { create Message  toast "Sent" success  refresh self }
  }
}
